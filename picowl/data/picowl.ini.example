# picowl configuration. Copy to ~/.config/picowl/picowl.ini or /etc/picowl.ini.
# Lines starting with '#' or ';' are comments.

[render]
# Preferred render/scanout format: RGB565 (default), XRGB8888, ARGB8888.
# If the backend cannot do it, picowl falls back to the backend default.
format = RGB565

[output]
# Per-output rotation, "<output name> = <transform>".
# Transforms: normal, 90, 180, 270, flipped, flipped-90, flipped-180, flipped-270.
# "*" matches any output without its own entry.
# DSI-1 = 90
# * = normal

[idle]
# Legacy: milliseconds of inactivity before the screen is blanked; 0 disables.
# Used as blank_after_s (rounded up to seconds) for all power profiles unless
# a [power.*] blank_after_s is set. Prefer the [power.*] sections below.
timeout_ms = 60000

[background]
# Background colour as RGB hex.
color = #101010

[autostart]
# One shell command per line, run once at startup.
# cmd = picowl-panel
# cmd = picowl-osk

[keybindings]
# "<modifiers>+<key> = <action> [command]"
# key is an xkb keysym name (Tab) or a numeric evdev keycode (code:116).
# modifiers: alt, ctrl, shift, logo.  Actions: spawn, cycle, close, blank, rotate, panel, quit.
# Built-in defaults: code:116 = blank, alt+Tab = cycle, logo+Escape = quit.
# alt+Tab = cycle
# alt+F4 = close
# code:116 = blank
# logo+Return = spawn foot

[touch]
# Tap-and-hold gesture detection (default: enabled with right-click behaviour).
# hold_action: right-click (default) or none (disable hold detection).
# hold_delay_ms: start animation after this delay (default 300 ms).
# hold_ms: send right-click after this duration from touch-down (default 900 ms).
#   Must be greater than hold_delay_ms. Range: integers.
# slop_px: movement tolerance before hold is triggered; if exceeded, triggers drag instead
#   (default 8 px). Range: 0..64.
# hold_action = right-click
# hold_delay_ms = 300
# hold_ms = 900
# slop_px = 8

[cursor]
# Cursor appearance during hold animation (only visible during the hold animation).
# hold_animation: builtin (default, Pocket PC 2003 rotating circle of circles) or
#   path to a PAM/PPM strip of square frames (frame width = height, hotspot = centre).
#   Platform cursor rules: ARGB8888, at most 64x64, every pixel fully opaque or
#   exactly 0x00000000 (transparent pixels must be all-zero), at most 2 distinct
#   opaque colours per frame. Non-compliant strips are converted at load time
#   with a logged warning; use picowl-cursor-convert to fix them offline.
# fill, outline: builtin animation dot and outline colours in #RRGGBB format.
#   Colours are compared at 6 bits per component; for example #2050c0 and
#   #2353c3 count as the same colour. Default: fill=#2050c0, outline=#ffffff.
# frame_interval_ms: animation frame duration in milliseconds. Range: 20..1000.
#   Default: 83 ms (~12 fps).
# hold_animation = builtin
# fill = #2050c0
# outline = #ffffff
# frame_interval_ms = 83

[rotation]
# Per-output rotation mode override.
# "<output name> = <mode>" or "* = <mode>".
# Modes: auto (default, uses hardware rotation when available), hardware, software.
# auto uses the DRM plane rotation property when the plane supports it (e.g., MediaQ),
# else software rotation. hardware asks for the plane rotation and falls back to software
# rotation (with an error in the log) if it is not available. software always uses software rotation in the renderer.
# DSI-1 = hardware
# * = auto

[copytype]
# Per-output copy-type override (damage-clip framebuffer copies to VRAM).
# "<output name> = <type>" or "* = <type>".
# Types: auto (default, enabled for drivers that benefit), yes, no.
# Requires a kernel with DRM_IOCTL_MODE_CLOSEFB (Linux 6.9 or a backport);
# without it auto disables copy-type, and yes is honoured but logs an error.
# Copy-type drivers should also support FB_DAMAGE_CLIPS. Drivers: mq11xx, w100, sa1100-lcdc (copy-type);
# pxa-lcdc (scans DMA buffers, no copy).
# DSI-1 = auto
# * = auto

[zerocopy]
# Zero-copy and single-buffer client support.
# enable: advertise picowl-buffer-v1 and DMA-BUF feedback (default true).
# single_buffer: allow single-buffer (non-double-buffered) clients on
#   copy-type outputs where they are safe (default true).
# panel_autohide: hide the panel while an app is fullscreen (default true).
# enable = true
# single_buffer = true
# panel_autohide = true

[memory]
# Memory allocator tuning (M_* malloc() environment variables).
# arena_max: M_ARENA_MAX, number of malloc arenas. Range: 1..8 (default 1).
# trim_threshold_kb: M_TRIM_THRESHOLD in kB, the amount of free memory at the
#   top of the heap that glibc free() returns to the OS (default 256).
# mmap_threshold_kb: size threshold for mmap-allocated blocks in kB (default 128).
# top_pad_kb: extra bytes reserved at the top of the heap in kB (default 16).
# trim_after_start: call malloc_trim(0) once from an idle callback after
#   startup (default true).
# Ranges: trim_threshold_kb 0..65536, mmap_threshold_kb 16..4096, top_pad_kb 0..65536;
# out-of-range values are rejected and the default is kept.
# arena_max = 1
# trim_threshold_kb = 256
# mmap_threshold_kb = 128
# top_pad_kb = 16
# trim_after_start = true

[power]
# Power supply aware backlight dimming configuration.
# backlight: auto (prefer type firmware > platform > raw, first by name),
#   or an explicit backlight device name in /sys/class/backlight/. Default: auto.
# low_capacity: battery capacity threshold (%): LOW is used when the lowest
#   battery capacity is <= this value. Range: 0..100 (default 15). 0 means LOW
#   only at 0%; LOW cannot be disabled, set [power.low] timings equal to
#   [power.battery] instead.
# dim_level: dimmed brightness as % of user brightness. Range: 1..100 (default 30).
#   To disable dimming set dim_after_s = 0 in the [power.*] profiles.
# poll_s: sysfs re-read period for drivers that don't emit change events.
#   0 disables polling, values < 30 are rejected. Range: 0 or 30..86400 (default 300).
# backlight = auto
# low_capacity = 15
# dim_level = 30
# poll_s = 300

[power.ac]
# AC power profile idle timings. All values in seconds; 0 disables the step.
# dim_after_s: inactivity before backlight dims (default 120).
# blank_after_s: inactivity before screen blanks (default 600).
# Range: 0..86400. Blank happens after dim (blank_after_s >= dim_after_s recommended).
# inhibit: yes|no (default yes). While a visible surface holds an idle inhibitor
#   (video playback), do not dim or blank. The power key still blanks.
# dim_after_s = 120
# blank_after_s = 600
# inhibit = yes

[power.battery]
# Battery power profile idle timings. All values in seconds; 0 disables the step.
# dim_after_s: inactivity before backlight dims (default 20).
# blank_after_s: inactivity before screen blanks (default 60).
# Range: 0..86400.
# inhibit: yes|no (default yes), see [power.ac].
# dim_after_s = 20
# blank_after_s = 60
# inhibit = yes

[power.low]
# Low battery profile idle timings. All values in seconds; 0 disables the step.
# Applies when battery capacity <= [power] low_capacity (%).
# dim_after_s: inactivity before backlight dims (default 10).
# blank_after_s: inactivity before screen blanks (default 30).
# max_brightness_pct: cap backlight to this % of max_brightness while LOW.
#   Range: 1..100 (default 40).
# Range for dim/blank: 0..86400.
# inhibit: yes|no (default yes), see [power.ac]. Set no to let the screen dim and
#   blank during playback when the battery is low (the brightness cap above
#   applies either way).
# dim_after_s = 10
# blank_after_s = 30
# max_brightness_pct = 40
# inhibit = yes

[core]
# Legacy [core] section (deprecated; alias of [idle] timeout_ms).
# idle_timeout_ms: if set and no [power.*] blank_after_s is configured,
#   it becomes the blank timeout for all profiles (converted to seconds).
#   This section exists for backwards compatibility with older configs.
# idle_timeout_ms = 60000
