# picowl configuration. Copy to ~/.config/picowl/picowl.ini or /etc/picowl.ini.
# Lines starting with '#' or ';' are comments.

[render]
# Preferred render/scanout format: RGB565 (default), XRGB8888, ARGB8888.
# If the backend cannot do it, picowl falls back to the backend default.
format = RGB565

[output]
# Per-output rotation, "<output name> = <transform>".
# Transforms: normal, 90, 180, 270, flipped, flipped-90, flipped-180, flipped-270.
# "*" matches any output without its own entry.
# DSI-1 = 90
# * = normal
# Subpixel layout of the panel (wl_output.subpixel), in its native orientation:
# unknown (default: the backend's value), none, horizontal_rgb, horizontal_bgr,
# vertical_rgb, vertical_bgr. Clients such as picowl-panel use it to draw
# subpixel text; rotation is taken care of (see README, [output] section).
# Per board, as told by the owner and not checked against datasheets:
#   iPAQs (h2200 and the other portrait panels)  horizontal_rgb
#   h3900 (a landscape panel in hardware)        vertical_rgb
# subpixel = horizontal_rgb

[idle]
# Legacy: milliseconds of inactivity before the screen is blanked; 0 disables.
# Used as blank_after_s (rounded up to seconds) for all power profiles unless
# a [power.*] blank_after_s is set. Prefer the [power.*] sections below.
timeout_ms = 60000

[background]
# Background colour as RGB hex.
color = #101010

[autostart]
# One shell command per line, run once at startup.
# The panel: a slim bar with clock, battery and backlight and volume buttons; a
# tap on a button pops a row out under the bar (a slider for the backlight and
# the volume, the weekday and date for the clock, the time left for the battery;
# it covers windows, it does not move them) and closes it again 3 s after the last touch. It is hidden
# while an app has the focus, and with it the row, unless [zerocopy]
# panel_autohide is false. Options: --height N (18..80, default 18), --bottom,
# --font PATH and --font-size PX (the text is rasterized from a TrueType font,
# by default the first Liberation Sans or DejaVu Sans file that exists, else a
# built-in bitmap font), --popup-alpha N (0..255, default 224: the row is
# translucent), --style smooth|crisp (default smooth; crisp draws no anti-aliasing at
# all, with built-in pixel fonts and icons on whole pixels, and ignores --font,
# --font-size and --subpixel), --bar-alpha N (default 255) and --subpixel auto|rgb|bgr|none
# (default auto: LCD text in the order [output] subpixel advertises, in
# grayscale where the ground is translucent or the stripes do not run across)
# and --battery-mah N (the battery's capacity, the last resort for the time left
# when the driver exports neither charge_full nor charge_full_design).
# cmd = picowl-panel
# cmd = picowl-panel --bottom --height 24 --popup-alpha 255
# with the capacity printed on the battery pack, for a gauge that does not report it:
# cmd = picowl-panel --battery-mah 1000

[osk]
# The on-screen keyboard: picowl starts it, restarts it when it dies and shows or
# hides it for the "osk" key action. Not needed in [autostart].
# cmd: the command line, run as "exec <cmd>" so picowl knows the pid. Start it
#   hidden. Empty (default) = picowl does not handle a keyboard.
# restart: yes (default) or no. A restart waits 1, 2, 4, 8 s after an exit within
#   10 s of the start; after 5 such exits in a row picowl gives up until an
#   "osk show" or "osk toggle" key starts it again.
# cmd = /usr/bin/wvkbd-ipaq --hidden --auto
# restart = yes

[keybindings]
# "<modifiers>+<key> = <action> [command]"
# key is an xkb keysym name (Tab) or a numeric evdev keycode (code:116).
# modifiers: alt, ctrl, shift, logo.  Actions: spawn, cycle, close, blank, rotate, panel, osk, quit.
# "osk show|hide|toggle" (default toggle) controls the keyboard from [osk].
# Built-in defaults (always present, your entries are added to them): code:116 = blank,
# alt+Tab = cycle, logo+Escape = quit.
# alt+Tab = cycle
# alt+F4 = close
# code:116 = blank
# logo+Return = spawn foot
# The iPAQ email button (KEY_MAIL, 155) cycles the output rotation, as in the media player;
# it does nothing on models without that button.
code:155 = rotate
# The iPAQ calendar button (KEY_CALENDAR, 397) toggles the on-screen keyboard.
# code:397 = osk toggle

[touch]
# Tap-and-hold gesture detection (default: enabled with right-click behaviour).
# hold_action: right-click (default) or none (disable hold detection).
# hold_button: right (default) or middle. The button the hold sends; middle pastes the
#   primary selection in a terminal. Not used when hold_action = none.
# hold_delay_ms: start animation after this delay (default 300 ms).
# hold_ms: send right-click after this duration from touch-down (default 900 ms).
#   Must be greater than hold_delay_ms. Range: integers.
# slop_px: movement tolerance before hold is triggered; if exceeded, triggers drag instead
#   (default 8 px). Range: 0..64.
# hold_action = right-click
# hold_button = right
# hold_delay_ms = 300
# hold_ms = 900
# slop_px = 8

# Touch calibration. picowl never uses raw touch axes: every touch device needs
# one, taken from the first source that gives it:
#   1. calibration (below), 2. the tslib pointercal file, 3. a non-identity
#   udev LIBINPUT_CALIBRATION_MATRIX, else the device is disabled and an error
#   is logged once.
# calibration: six numbers 'a b c d e f', a libinput normalized matrix (x' =
#   a*x + b*y + c, y' = d*x + e*y + f, all in 0..1). Overrides everything. An
#   explicit identity '1 0 0 0 1 0' marks a panel that really is calibrated.
# pointercal: tslib file written by ts_calibrate (default /etc/pointercal,
#   empty = do not use one). Format: a b c d e f scale xres yres rotation, e.g.
#   22841 -68 -3658260 -491 -28324 25242144 65536 240 320 0
#   xres and yres are required and rotation must be 0.
# calibration = 1.487044 -0.004427 -0.232586 -0.023975 -1.383008 1.203639
# pointercal = /etc/pointercal

# Per-app tap-and-hold overrides: [app.<app_id>] (xdg toplevels, exact match)
# and per-layer overrides: [layer.<namespace>] (layer-shell surfaces).
# Keys are the same as [touch]; unset keys are inherited from [touch], wherever
# [touch] appears in the file. Bad timings revert to the [touch] values.
# Example: a media player that times its own long press. hold_action = none
# sends the left press at touch-down, with no right-click and no animation.
# [app.mediaplayer]
# hold_action = none
#
# Example: holding in havoc pastes the primary selection (middle click).
# [app.havoc]
# hold_button = middle
#
# picowl has a built-in [layer.wvkbd] with hold_action = none for the keyboard,
# and a built-in [layer.panel] with hold_action = none for the panel's sliders;
# a section of your own with the same name merges over it.

[cursor]
# Cursor appearance during hold animation (only visible during the hold animation).
# hold_animation: builtin (default, Pocket PC 2003 rotating circle of circles) or
#   path to a PAM/PPM strip of square frames (frame width = height, hotspot = centre).
#   Platform cursor rules: ARGB8888, at most 64x64, every pixel fully opaque or
#   exactly 0x00000000 (transparent pixels must be all-zero), at most 2 distinct
#   opaque colours per frame. Non-compliant strips are converted at load time
#   with a logged warning; use picowl-cursor-convert to fix them offline.
# fill, outline: builtin animation dot and outline colours in #RRGGBB format.
#   Colours are compared at 6 bits per component; for example #2050c0 and
#   #2353c3 count as the same colour. Default: fill=#2050c0, outline=#ffffff.
# frame_interval_ms: animation frame duration in milliseconds. Range: 20..1000.
#   Default: 83 ms (~12 fps).
# hold_animation = builtin
# fill = #2050c0
# outline = #ffffff
# frame_interval_ms = 83

[rotation]
# Per-output rotation mode override.
# "<output name> = <mode>" or "* = <mode>".
# Modes: auto (default, uses hardware rotation when available), hardware, software.
# auto uses the DRM plane rotation property when the plane supports it (e.g., MediaQ),
# else software rotation. hardware asks for the plane rotation and falls back to software
# rotation (with an error in the log) if it is not available. software always uses software rotation in the renderer.
# DSI-1 = hardware
# * = auto

[copytype]
# Per-output copy-type override (damage-clip framebuffer copies to VRAM).
# "<output name> = <type>" or "* = <type>".
# Types: auto (default, enabled for drivers that benefit), yes, no.
# Requires a kernel with DRM_IOCTL_MODE_CLOSEFB (Linux 6.9 or a backport);
# without it auto disables copy-type, and yes is honoured but logs an error.
# Copy-type drivers should also support FB_DAMAGE_CLIPS. Drivers: mq11xx, w100, sa1100-lcdc (copy-type);
# pxa-lcdc (scans DMA buffers, no copy).
# DSI-1 = auto
# * = auto

[zerocopy]
# Zero-copy and single-buffer client support.
# enable: advertise picowl-buffer-v1 and DMA-BUF feedback (default true).
# single_buffer: allow single-buffer (non-double-buffered) clients on
#   copy-type outputs where they are safe (default true).
# panel_autohide: hide the panel while an app is focused (default true). The panel's
#   slider row is hidden with it; set false to keep picowl-panel visible next to apps.
# max_buffers_per_client: buffers one client may hold. Range 1..32 (default 3).
# budget_kb: memory shared by all clients without an [app.*] buffer rule.
#   Range 0..65536 (default 2048); 0 = none of them may allocate.
# total_kb: ceiling over all pools. 0 = no extra limit (default), else 1..65536.
# caching: what the caching event (picowl-buffer-v1 version 2) tells clients about
#   the CPU mapping of the buffers: auto (default, from the DRM driver: cacheable for
#   mq11xx and w100, write_combined for everything else, sa1100-lcdc included),
#   cacheable or write_combined. Case-insensitive; an invalid value keeps auto.
#   Clients never read back from, or decode into, write_combined buffers.
# Sizes are counted in whole pages as allocated. A request over a limit gets
# failed(no_memory). Out-of-range values are rejected and the default is kept.
# enable = true
# single_buffer = true
# panel_autohide = true
# max_buffers_per_client = 3
# budget_kb = 2048
# total_kb = 0
# caching = auto

# Per-app buffer limits: an [app.<app_id>] section (the one used for the hold
# overrides above) with zerocopy_* keys gets its own pool, shared by all
# clients matching it. The client must call xdg_toplevel.set_app_id before
# create_buffer. Not for [layer.*].
# zerocopy_buffers: buffers per client, 1..32 (default max_buffers_per_client).
# zerocopy_budget_kb: pool size, 0..65536 (default zerocopy_buffers full frames
#   of the largest output, so one value fits every board).
# exe: the client's /proc/<pid>/exe must be this file (symlinks resolved at
#   load), otherwise it gets the default limits. Optional.
# On shmem drivers (mq11xx, w100) the pool is resident RAM: 7 buffers are
# 1 MiB on QVGA and 4.1 MiB on the hx4700.
# [app.mediaplayer]
# zerocopy_buffers = 7
# exe = /usr/bin/mediaplayer-wayland

[layout]
# Two apps which tile instead of stacking while both are mapped: the first on
# top in portrait (left in landscape), the second below (right). A single one
# is maximized like any other window, and so are all other apps. app_ids,
# comma separated, in order; a list of more than two ignores the extras, a
# repeated name is skipped, and tiling stays off unless two distinct names remain.
# The first window's share of the screen follows its natural aspect ratio:
# the client's fixed size (min_size == max_size) if it has one, else
# '[app.<id>] aspect = W:H' (1..4096), else half. The first window never gets
# more than 100 - second_min percent, and keeps at least 25 percent. alt+Tab
# moves the keyboard between the two while one has it.
# stack = mediaplayer, havoc
#
# second_min: the share of the split axis (the height in portrait, the width in
# landscape) the second window keeps at least, 25..75 percent, default 50. A
# wide player clip then cannot take the room the terminal needs. 25 gives the
# older rule, where only a quarter was guaranteed. A bad value keeps the default.
# second_min = 50
#
# focus: one of the two stack apps keeps the keyboard when the other one maps,
# so a player which starts or restarts later does not take the keys of the
# on-screen keyboard from the terminal. Touching a window and alt+Tab still
# move it. A name outside the stack is logged and ignored. Default: the newly
# mapped window takes the keyboard.
# focus = havoc
#
# While both are mapped and split top and bottom (portrait), a keyboard in one
# of these layer-shell namespaces (anchored to the bottom, not to the top, with
# or without an exclusive zone; the shipped wvkbd-ipaq has none) does not shrink
# them: they keep their size and get no configure, and the stack moves up by
# the height of the keyboard, so the lower window ends where
# the keyboard starts and the upper one slides off the top. Everything else
# (one app alone, other apps, a side by side split, panels) is resized as usual.
# Comma separated, default wvkbd; an empty value turns the panning off.
# pan = wvkbd
#
# [app.mediaplayer]
# aspect = 4:3

[lease]
# DRM lease: hand the output to a KMS client (the media player's --vo drm:lease)
# through wp_drm_lease_device_v1, without a VT switch. picowl keeps input and
# power policy, and takes the output back when the lease ends. Only with the
# DRM backend, and the user must be in the video group. See doc/lease.md.
# enable: offer the lease global (default true). false: no client gets a DRM fd.
# allow: comma-separated app_ids which may lease. The requester must own the
#   focused toplevel and its app_id must be in the list. * = any focused client,
#   empty = nobody. Default: mediaplayer.
# enable = true
# allow = mediaplayer

[capture]
# Screen capture through zwlr_screencopy_manager_v1 (grim, wf-recorder).
# Off by default: any client of the session can read the whole screen, including
# other applications. Enabled here so development images can take screenshots;
# leave it off on production images. See doc/capture.md.
enabled = true

[memory]
# Memory allocator tuning (M_* malloc() environment variables).
# arena_max: M_ARENA_MAX, number of malloc arenas. Range: 1..8 (default 1).
# trim_threshold_kb: M_TRIM_THRESHOLD in kB, the amount of free memory at the
#   top of the heap that glibc free() returns to the OS (default 256).
# mmap_threshold_kb: size threshold for mmap-allocated blocks in kB (default 128).
# top_pad_kb: extra bytes reserved at the top of the heap in kB (default 16).
# trim_after_start: call malloc_trim(0) once from an idle callback after
#   startup (default true).
# Ranges: trim_threshold_kb 0..65536, mmap_threshold_kb 16..4096, top_pad_kb 0..65536;
# out-of-range values are rejected and the default is kept.
# arena_max = 1
# trim_threshold_kb = 256
# mmap_threshold_kb = 128
# top_pad_kb = 16
# trim_after_start = true

[power]
# Power supply aware backlight dimming configuration.
# backlight: auto (prefer type firmware > platform > raw, first by name),
#   or an explicit backlight device name in /sys/class/backlight/. Default: auto.
# low_capacity: battery capacity threshold (%): LOW is used when the lowest
#   battery capacity is <= this value. Range: 0..100 (default 15). 0 means LOW
#   only at 0%; LOW cannot be disabled, set [power.low] timings equal to
#   [power.battery] instead.
# dim_level: dimmed brightness as % of user brightness. Range: 1..100 (default 30).
#   To disable dimming set dim_after_s = 0 in the [power.*] profiles.
# poll_s: sysfs re-read period for drivers that don't emit change events.
#   0 disables polling, values < 30 are rejected. Range: 0 or 30..86400 (default 300).
# backlight = auto
# low_capacity = 15
# dim_level = 30
# poll_s = 300

[power.ac]
# AC power profile idle timings. All values in seconds; 0 disables the step.
# dim_after_s: inactivity before backlight dims (default 120).
# blank_after_s: inactivity before screen blanks (default 600).
# Range: 0..86400. Blank happens after dim (blank_after_s >= dim_after_s recommended).
# inhibit: yes|no (default yes). While a visible surface holds an idle inhibitor
#   (video playback), do not dim or blank. The power key still blanks.
# dim_after_s = 120
# blank_after_s = 600
# inhibit = yes

[power.battery]
# Battery power profile idle timings. All values in seconds; 0 disables the step.
# dim_after_s: inactivity before backlight dims (default 20).
# blank_after_s: inactivity before screen blanks (default 60).
# Range: 0..86400.
# inhibit: yes|no (default yes), see [power.ac].
# dim_after_s = 20
# blank_after_s = 60
# inhibit = yes

[power.low]
# Low battery profile idle timings. All values in seconds; 0 disables the step.
# Applies when battery capacity <= [power] low_capacity (%).
# dim_after_s: inactivity before backlight dims (default 10).
# blank_after_s: inactivity before screen blanks (default 30).
# max_brightness_pct: cap backlight to this % of max_brightness while LOW.
#   Range: 1..100 (default 40).
# Range for dim/blank: 0..86400.
# inhibit: yes|no (default yes), see [power.ac]. Set no to let the screen dim and
#   blank during playback when the battery is low (the brightness cap above
#   applies either way).
# dim_after_s = 10
# blank_after_s = 30
# max_brightness_pct = 40
# inhibit = yes

[core]
# Legacy [core] section (deprecated; alias of [idle] timeout_ms).
# idle_timeout_ms: if set and no [power.*] blank_after_s is configured,
#   it becomes the blank timeout for all profiles (converted to seconds).
#   This section exists for backwards compatibility with older configs.
# idle_timeout_ms = 60000
