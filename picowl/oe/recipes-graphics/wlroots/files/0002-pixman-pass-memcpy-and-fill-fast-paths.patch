+// Same conversion as pixman's solid fill fast path (truncating)
+static bool color_to_pixel(pixman_format_code_t fmt,
+		const struct pixman_color *color, uint32_t *pixel) {
+	uint32_t c32 = ((uint32_t)color->alpha >> 8 << 24) |
+		((uint32_t)color->red >> 8 << 16) |
+		((uint32_t)color->green & 0xff00) |
+		((uint32_t)color->blue >> 8);
+	switch (fmt) {
+	case PIXMAN_r5g6b5:
+		*pixel = ((c32 >> 3) & 0x001f) | ((c32 >> 5) & 0x07e0) |
+			((c32 >> 8) & 0xf800);
+		return true;
+	case PIXMAN_x8r8g8b8:
+	case PIXMAN_a8r8g8b8:
+		*pixel = c32;
+		return true;
+	default:
+		return false;
 	}
 }
 
@@ -215,14 +337,41 @@ static void render_pass_add_rect(struct wlr_render_pass *wlr_pass,
 		.alpha = options->color.a * 0xFFFF,
 	};
 
-	pixman_image_t *fill = pixman_image_create_solid_fill(&color);
+	uint32_t pixel;
+	pixman_format_code_t fmt = pixman_image_get_format(buffer->image);
+	uint32_t *bits = pixman_image_get_data(buffer->image);
+	if (op == PIXMAN_OP_SRC && bits != NULL && color_to_pixel(fmt, &color, &pixel)) {
+		int bpp = PIXMAN_FORMAT_BPP(fmt);
+		int stride = pixman_image_get_stride(buffer->image) / (int)sizeof(uint32_t);
+		struct wlr_box rect;
+		int n = clip_n_rects(options->clip);
+		for (int i = 0; i < n; i++) {
+			if (!clip_rect(options->clip, i, &box, buffer->image, &rect)) {
+				continue;
+			}
+			pixman_fill(bits, stride, bpp, rect.x, rect.y,
+				rect.width, rect.height, pixel);
+		}
+		return;
+	}
+
+	if (buffer->fill == NULL ||
+			memcmp(&buffer->fill_color, &color, sizeof(color)) != 0) {
+		pixman_image_t *fill = pixman_image_create_solid_fill(&color);
+		if (fill == NULL) {
+			return;
+		}
+		if (buffer->fill != NULL) {
+			pixman_image_unref(buffer->fill);
+		}
+		buffer->fill = fill;
+		buffer->fill_color = color;
+	}
 
 	pixman_image_set_clip_region32(buffer->image, options->clip);
-	pixman_image_composite32(op, fill, NULL, buffer->image,
+	pixman_image_composite32(op, buffer->fill, NULL, buffer->image,
 		0, 0, 0, 0, box.x, box.y, box.width, box.height);
 	pixman_image_set_clip_region32(buffer->image, NULL);
-
-	pixman_image_unref(fill);
 }
 
