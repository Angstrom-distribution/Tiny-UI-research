+
+static int clip_n_rects(const pixman_region32_t *clip) {
+	return clip != NULL ? pixman_region32_n_rects(clip) : 1;
+}
+
+/*
+ * Rectangle i of clip (NULL means unclipped) intersected with box and the
+ * bounds of image. Returns false if the intersection is empty.
+ */
+static bool clip_rect(const pixman_region32_t *clip, int i,
+		const struct wlr_box *box, pixman_image_t *image, struct wlr_box *out) {
+	int x1 = 0, y1 = 0;
+	int x2 = pixman_image_get_width(image), y2 = pixman_image_get_height(image);
+	if (clip != NULL) {
+		const pixman_box32_t *r = &pixman_region32_rectangles(clip, NULL)[i];
+		x1 = r->x1 > x1 ? r->x1 : x1;
+		y1 = r->y1 > y1 ? r->y1 : y1;
+		x2 = r->x2 < x2 ? r->x2 : x2;
+		y2 = r->y2 < y2 ? r->y2 : y2;
+	}
+	x1 = box->x > x1 ? box->x : x1;
+	y1 = box->y > y1 ? box->y : y1;
+	x2 = box->x + box->width < x2 ? box->x + box->width : x2;
+	y2 = box->y + box->height < y2 ? box->y + box->height : y2;
+	*out = (struct wlr_box){ .x = x1, .y = y1, .width = x2 - x1, .height = y2 - y1 };
+	return out->width > 0 && out->height > 0;
+}
+
+/*
+ * Untransformed, unscaled, opaque copy between images of the same format:
+ * a plain row memcpy per clip rectangle. Returns false if not applicable.
+ */
+static bool try_copy_texture(struct wlr_pixman_buffer *buffer,
+		struct wlr_pixman_texture *texture, pixman_op_t op,
+		const pixman_region32_t *clip, const struct wlr_box *src_box,
+		const struct wlr_box *dst_box) {
+	pixman_image_t *src = texture->image, *dst = buffer->image;
+	pixman_format_code_t fmt = pixman_image_get_format(dst);
+	if (pixman_image_get_format(src) != fmt) {
+		return false;
+	}
+	// OVER with an alpha-less source is the same as SRC
+	if (op != PIXMAN_OP_SRC &&
+			!(op == PIXMAN_OP_OVER && PIXMAN_FORMAT_A(fmt) == 0)) {
+		return false;
+	}
+	int bpp = PIXMAN_FORMAT_BPP(fmt);
+	if (bpp < 8 || bpp % 8 != 0) {
+		return false;
+	}
+	// Out-of-bounds source pixels would be transparent, not copied
+	if (src_box->x < 0 || src_box->y < 0 ||
+			src_box->x + src_box->width > pixman_image_get_width(src) ||
+			src_box->y + src_box->height > pixman_image_get_height(src)) {
+		return false;
+	}
+	uint8_t *src_data = (uint8_t *)pixman_image_get_data(src);
+	uint8_t *dst_data = (uint8_t *)pixman_image_get_data(dst);
+	if (src_data == NULL || dst_data == NULL || src_data == dst_data) {
+		return false;
+	}
+	int src_stride = pixman_image_get_stride(src);
+	int dst_stride = pixman_image_get_stride(dst);
+	int bytes_pp = bpp / 8;
+
+	struct wlr_box rect;
+	int n = clip_n_rects(clip);
+	for (int i = 0; i < n; i++) {
+		if (!clip_rect(clip, i, dst_box, dst, &rect)) {
+			continue;
+		}
+		int sx = rect.x - dst_box->x + src_box->x;
+		int sy = rect.y - dst_box->y + src_box->y;
+		const uint8_t *s = src_data + (ptrdiff_t)sy * src_stride + sx * bytes_pp;
+		uint8_t *d = dst_data + (ptrdiff_t)rect.y * dst_stride + rect.x * bytes_pp;
+		size_t len = (size_t)rect.width * bytes_pp;
+		for (int y = 0; y < rect.height; y++) {
+			memcpy(d, s, len);
+			s += src_stride;
+			d += dst_stride;
+		}
+	}
+	return true;
+}
