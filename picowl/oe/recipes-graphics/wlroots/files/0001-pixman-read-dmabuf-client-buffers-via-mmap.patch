-bool begin_pixman_data_ptr_access(struct wlr_buffer *wlr_buffer, pixman_image_t **image_ptr,
-		uint32_t flags) {
+static void dmabuf_map_destroy(struct wlr_pixman_dmabuf_map *map) {
+	wl_list_remove(&map->link);
+	wl_list_remove(&map->buffer_destroy.link);
+	munmap(map->map, map->len);
+	free(map);
+}
+
+static void dmabuf_map_handle_buffer_destroy(struct wl_listener *listener,
+		void *data) {
+	struct wlr_pixman_dmabuf_map *map =
+		wl_container_of(listener, map, buffer_destroy);
+	dmabuf_map_destroy(map);
+}
+
+static struct wlr_pixman_dmabuf_map *dmabuf_map_find(
+		struct wlr_pixman_renderer *renderer, struct wlr_buffer *buffer) {
+	struct wlr_pixman_dmabuf_map *map;
+	wl_list_for_each(map, &renderer->dmabuf_maps, link) {
+		if (map->buffer == buffer) {
+			return map;
+		}
+	}
+	return NULL;
+}
+
+// DMA_BUF_IOCTL_SYNC; fds which are not real DMA-BUFs (e.g. memfds used in
+// tests) or old kernels reject it, which is fine for CPU-coherent memory
+static bool dmabuf_sync(int fd, uint64_t flags) {
+	struct dma_buf_sync sync = { .flags = flags };
+	while (ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) != 0) {
+		if (errno == EINTR) {
+			continue;
+		}
+		if (errno == ENOTTY || errno == EINVAL || errno == ENOSYS) {
+			return true;
+		}
+		wlr_log_errno(WLR_ERROR, "DMA_BUF_IOCTL_SYNC failed");
+		return false;
+	}
+	return true;
+}
+
+// The linux-dmabuf client controls the fd. Mapping anything else than a real
+// DMA-BUF would let it truncate the file (a memfd) behind our back, the next
+// read then raises SIGBUS. DMA_BUF_IOCTL_SYNC without a read or write flag
+// fails with EINVAL on a DMA-BUF, other fds don't implement it (ENOTTY).
+static bool fd_is_dmabuf(int fd) {
+	struct dma_buf_sync sync = { .flags = 0 };
+	return ioctl(fd, DMA_BUF_IOCTL_SYNC, &sync) != 0 && errno != ENOTTY;
+}
+
+static struct wlr_pixman_dmabuf_map *dmabuf_map_get(
+		struct wlr_pixman_renderer *renderer, struct wlr_buffer *buffer,
+		bool write) {
+	struct wlr_pixman_dmabuf_map *map = dmabuf_map_find(renderer, buffer);
+	if (map != NULL && (map->writable || !write)) {
+		return map;
+	}
+
+	struct wlr_dmabuf_attributes attribs;
+	if (!wlr_buffer_get_dmabuf(buffer, &attribs)) {
+		return NULL;
+	}
+	if (attribs.n_planes != 1 || (attribs.modifier != DRM_FORMAT_MOD_LINEAR &&
+			attribs.modifier != DRM_FORMAT_MOD_INVALID)) {
+		wlr_log(WLR_DEBUG, "Cannot map DMA-BUF: %d planes, modifier 0x%"PRIX64,
+			attribs.n_planes, attribs.modifier);
+		return NULL;
+	}
+	if (get_pixman_format_from_drm(attribs.format) == 0) {
+		wlr_log(WLR_DEBUG, "Cannot map DMA-BUF: unsupported format 0x%"PRIX32,
+			attribs.format);
+		return NULL;
+	}
+
+	// Every row is read as width * bytes_per_block bytes at offset + y * stride
+	// (pixman wants 32-bit aligned rows), all of it must lie inside the fd
+	const struct wlr_pixel_format_info *info =
+		drm_get_pixel_format_info(attribs.format);
+	if (info == NULL || info->block_width > 1 || info->block_height > 1) {
+		return NULL;
+	}
+	uint64_t row = (uint64_t)buffer->width * info->bytes_per_block;
+	uint64_t end64 = (uint64_t)attribs.offset[0] +
+		(uint64_t)attribs.stride[0] * (uint64_t)buffer->height;
+	if (buffer->width <= 0 || buffer->height <= 0 ||
+			attribs.stride[0] < row || attribs.stride[0] % 4 != 0 ||
+			attribs.offset[0] % 4 != 0 || end64 > SIZE_MAX) {
+		wlr_log(WLR_DEBUG, "Cannot map DMA-BUF: bad layout %"PRIu32" + %"PRIu32
+			" * %d for %dx%d", attribs.offset[0], attribs.stride[0],
+			buffer->height, buffer->width, buffer->height);
+		return NULL;
+	}
+	size_t len = end64;
+
+	if (!renderer->dmabuf_allow_any_fd && !fd_is_dmabuf(attribs.fd[0])) {
+		wlr_log(WLR_DEBUG, "Cannot map DMA-BUF: fd is not a DMA-BUF");
+		return NULL;
+	}
+	off_t fd_size = lseek(attribs.fd[0], 0, SEEK_END);
+	if (fd_size < 0 || (uint64_t)fd_size < end64) {
+		wlr_log(WLR_DEBUG, "Cannot map DMA-BUF: fd size %lld < %zu",
+			(long long)fd_size, len);
+		return NULL;
+	}
+	int prot = PROT_READ | (write ? PROT_WRITE : 0);
+	void *ptr = mmap(NULL, len, prot, MAP_SHARED, attribs.fd[0], 0);
+	if (ptr == MAP_FAILED) {
+		wlr_log_errno(WLR_ERROR, "Failed to mmap DMA-BUF");
+		return NULL;
+	}
+
+	if (map != NULL) {
+		// Upgrade a read-only mapping to read-write
+		munmap(map->map, map->len);
+	} else {
+		map = calloc(1, sizeof(*map));
+		if (map == NULL) {
+			wlr_log_errno(WLR_ERROR, "Allocation failed");
+			munmap(ptr, len);
+			return NULL;
+		}
+		map->buffer = buffer;
+		map->buffer_destroy.notify = dmabuf_map_handle_buffer_destroy;
+		wl_signal_add(&buffer->events.destroy, &map->buffer_destroy);
+		wl_list_insert(&renderer->dmabuf_maps, &map->link);
+	}
+	map->map = ptr;
+	map->len = len;
+	map->writable = write;
+	map->fd = attribs.fd[0];
+	map->offset = attribs.offset[0];
+	map->stride = attribs.stride[0];
+	map->format = attribs.format;
+	return map;
+}
+
+bool pixman_buffer_access_begin(struct wlr_pixman_renderer *renderer,
+		struct wlr_buffer *buffer, uint32_t flags, void **data,
+		uint32_t *format, size_t *stride) {
+	if (wlr_buffer_begin_data_ptr_access(buffer, flags, data, format, stride)) {
+		return true;
+	}
+
+	bool write = flags & WLR_BUFFER_DATA_PTR_ACCESS_WRITE;
+	struct wlr_pixman_dmabuf_map *map = dmabuf_map_get(renderer, buffer, write);
+	if (map == NULL) {
+		return false;
+	}
+	assert(map->sync_flags == 0);
+	uint64_t sync_flags = write ? DMA_BUF_SYNC_RW : DMA_BUF_SYNC_READ;
+	if (!dmabuf_sync(map->fd, DMA_BUF_SYNC_START | sync_flags)) {
+		return false;
+	}
+	map->sync_flags = sync_flags;
+
+	*data = (char *)map->map + map->offset;
+	*format = map->format;
+	*stride = map->stride;
+	return true;
+}
+
+void pixman_buffer_access_end(struct wlr_pixman_renderer *renderer,
+		struct wlr_buffer *buffer) {
+	if (buffer->accessing_data_ptr) {
+		wlr_buffer_end_data_ptr_access(buffer);
+		return;
+	}
+
+	struct wlr_pixman_dmabuf_map *map = dmabuf_map_find(renderer, buffer);
+	assert(map != NULL && map->sync_flags != 0);
+	dmabuf_sync(map->fd, DMA_BUF_SYNC_END | map->sync_flags);
+	map->sync_flags = 0;
+}
