diff --git a/tests/check-signals.py b/tests/check-signals.py
new file mode 100644
index 0000000..e6c1d70
--- /dev/null
+++ b/tests/check-signals.py
@@ -0,0 +1,55 @@
+#!/usr/bin/env python3
+# usage: check-signals.py BINARY
+#
+# Start the binary against a fake Wayland socket that accepts the connection
+# and then says nothing, so the process sits in its start-up round trip. Send
+# every handled signal there, then hang up. With the signals blocked at the top
+# of main() they stay pending and the process dies of its own "wl_compositor
+# not available" error (status 1); with the default actions it is killed.
+#
+# This proves the mask is in place before the first Wayland round trip. It
+# does not prove the mask is in place at every earlier instruction of main(),
+# and it does not exercise the signalfd handlers (that needs a compositor).
+import os, signal, socket, subprocess, sys, tempfile
+
+SKIP = 77  # meson's "skipped" status
+if not hasattr(signal, "SIGRTMIN"):
+    sys.exit(SKIP)
+
+binary = sys.argv[1]
+with tempfile.TemporaryDirectory() as rundir:
+    srv = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    srv.bind(os.path.join(rundir, "wl-test"))
+    srv.listen(1)
+    srv.settimeout(10)
+    env = dict(os.environ, XDG_RUNTIME_DIR=rundir, WAYLAND_DISPLAY="wl-test")
+    proc = subprocess.Popen([binary], env=env, stderr=subprocess.PIPE)
+    try:
+        conn, _ = srv.accept()
+    except socket.timeout:
+        proc.kill()
+        print("binary never connected:", proc.communicate()[1].decode())
+        sys.exit(1)
+    for sig in (signal.SIGUSR1, signal.SIGUSR2, signal.SIGRTMIN, signal.SIGPIPE):
+        proc.send_signal(sig)
+    conn.close()
+    try:
+        err = proc.communicate(timeout=10)[1].decode()
+    except subprocess.TimeoutExpired:
+        proc.kill()
+        print("binary did not exit after the hang-up")
+        sys.exit(1)
+
+if proc.returncode < 0:
+    num = -proc.returncode
+    try:
+        name = signal.Signals(num).name
+    except ValueError:
+        name = "signal %d" % num
+    print("killed by %s (%d): a handled signal was not blocked before the "
+          "first Wayland round trip; stderr: %s" % (name, num, err))
+    sys.exit(1)
+if proc.returncode != 1:
+    print("exited with status %d, want 1 (the compositor error); "
+          "stderr: %s" % (proc.returncode, err))
+    sys.exit(1)
