--- a/keyboard.c
+++ b/keyboard.c
@@ -3,6 +3,7 @@
 #include <stddef.h>
 #include <stdio.h>
 #include <sys/mman.h>
+#include <unistd.h>
 #include <ctype.h>
 #include <time.h>
 #include "keyboard.h"
@@ -801,6 +802,11 @@ create_and_upload_keymap(struct kbd *kb, const char *name, uint32_t comp_unichr)
     zwp_virtual_keyboard_v1_keymap(kb->vkbd, WL_KEYBOARD_KEYMAP_FORMAT_XKB_V1,
                                    keymap_fd, keymap_size);
     free((void *)keymap_str);
+    /* libwayland dups the fd when it marshals the request, so our copy and
+     * the mapping would otherwise leak on every keymap switch and every
+     * compose-key press. */
+    munmap(ptr, keymap_size);
+    close(keymap_fd);
 }
 
 // Get a monotonic millisecond timer.
diff --git a/main.c b/main.c
index e680f4c..aad4489 100644
--- a/main.c
+++ b/main.c
@@ -893,6 +893,19 @@ refresh_available_dimension()
 int
 main(int argc, char **argv)
 {
+    /* Blocked before any other setup: a signal delivered during the Wayland
+     * round trips would otherwise hit the default action and kill us. It
+     * stays pending until the signalfd below reads it. */
+    sigset_t signal_mask;
+    sigemptyset(&signal_mask);
+    sigaddset(&signal_mask, SIGUSR1);
+    sigaddset(&signal_mask, SIGUSR2);
+    sigaddset(&signal_mask, SIGRTMIN);
+    sigaddset(&signal_mask, SIGPIPE);
+    if (sigprocmask(SIG_BLOCK, &signal_mask, NULL) == -1) {
+        die("Failed to disable handled signals: %d\n", errno);
+    }
+
     /* parse command line arguments */
     char *layer_names_list = NULL, *landscape_layer_names_list = NULL;
     char *fc_font_pattern = NULL;
@@ -1278,16 +1291,6 @@ main(int argc, char **argv)
         die("Failed to get wayland_fd: %d\n", errno);
     }
 
