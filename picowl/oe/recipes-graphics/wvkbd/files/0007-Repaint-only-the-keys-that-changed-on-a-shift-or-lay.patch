+/* The one rule for which label a key shows, so that drawing a key and
+ * deciding whether it changed cannot disagree. */
+static const char *
+key_label(uint8_t mods, const struct key *k)
+{
+    const char *label = ((mods & Shift) || ((mods & CapsLock) &&
+        strlen(k->label) == 1 && isalpha(k->label[0]))) ? k->shift_label : k->label;
+    return label ? label : "";
+}
+
+static bool
+key_is_active(uint8_t mods, bool compose, const struct key *k)
+{
+    return (k->type == Mod && (mods & k->code)) ||
+           (k->type == Compose && compose);
+}
+
 void
 kbd_draw_key(struct kbd *kb, struct key *k, enum key_draw_type type)
 {
-    const char *label = ((kb->mods & Shift)||((kb->mods & CapsLock) && 
-        strlen(k->label) == 1 && isalpha(k->label[0]))) ? k->shift_label : k->label;
+    const char *label = key_label(kb->mods, k);
     if (kb->debug)
         fprintf(stderr, "Draw key +%d+%d %dx%d -> %s\n", k->x, k->y, k->w, k->h,
                 label);
@@ -733,6 +739,62 @@ kbd_draw_layout(struct kbd *kb)
         }
         next_key++;
     }
+    /* A surface that could not be drawn on shows nothing, so it must not be
+     * trusted as a base for a partial redraw. */
+    kb->drawn_layout = drwsurf_usable(d) ? kb->layout : NULL;
+    kb->drawn_mods = kb->mods;
+    kb->drawn_compose = (bool)kb->compose;
+}
+
+/* Keys may only be compared one to one when both layers put the same kind of
+ * key at the same place; otherwise a changed key could leave parts of its
+ * neighbours' old pixels behind. */
+static bool
+same_geometry(const struct layout *a, const struct layout *b)
+{
+    const struct key *ka = a->keys, *kb = b->keys;
+    for (; ka->type != Last && kb->type != Last; ka++, kb++) {
+        if (ka->type != kb->type)
+            return false;
+        if (ka->type == EndRow)
+            continue;
+        if (ka->x != kb->x || ka->y != kb->y || ka->w != kb->w ||
+            ka->h != kb->h)
+            return false;
+    }
+    return ka->type == Last && kb->type == Last;
+}
+
+void
+kbd_redraw_layout(struct kbd *kb)
+{
+    struct layout *old = kb->drawn_layout;
+
+    if (!old || !drwsurf_usable(kb->surf) || !same_geometry(old, kb->layout)) {
+        kbd_draw_layout(kb);
+        return;
+    }
+    if (kb->debug)
+        fprintf(stderr, "Redraw changed keys\n");
+
+    bool compose = (bool)kb->compose;
+    struct key *ok = old->keys, *nk = kb->layout->keys;
+    for (; ok->type != Last; ok++, nk++) {
+        if (ok->type == Pad || ok->type == EndRow)
+            continue;
+        bool was = key_is_active(kb->drawn_mods, kb->drawn_compose, ok);
+        bool now = key_is_active(kb->mods, compose, nk);
+        /* A key still highlighted from a press is repainted even when its
+         * label stays the same, as a full draw would. */
+        if (was == now && ok->scheme == nk->scheme && ok != kb->last_press &&
+            nk != kb->last_press &&
+            !strcmp(key_label(kb->drawn_mods, ok), key_label(kb->mods, nk)))
+            continue;
+        kbd_draw_key(kb, nk, now ? Press : None);
+    }
+    kb->drawn_layout = kb->layout;
+    kb->drawn_mods = kb->mods;
+    kb->drawn_compose = compose;
 }
 
 bool
