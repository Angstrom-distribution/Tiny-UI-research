diff --git a/tests/test-damage.c b/tests/test-damage.c
new file mode 100644
index 0000000..635e8a9
--- /dev/null
+++ b/tests/test-damage.c
@@ -0,0 +1,487 @@
+/* Checks that a layer, shift or key-state change repaints and reports damage
+ * for exactly the keys that differ, without a compositor. The expected key
+ * set is computed here from the layout tables, never by calling the code
+ * under test, and the pixels are compared with a from-scratch render. */
+#include <cairo.h>
+#include <linux/input-event-codes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "check.h"
+#include "keyboard.h"
+#include "text.h"
+
+enum { W = 240, H = 120 };
+
+struct env {
+    struct drw ctx;
+    struct drwbuf back, display, pback, pdisplay;
+    struct drwsurf ds, popup;
+    struct clr_scheme schemes[2];
+    struct kbd kb;
+};
+
+static void
+env_init(struct env *e, enum drw_format format)
+{
+    memset(e, 0, sizeof(*e));
+    for (int i = 0; i < 2; i++) {
+        e->schemes[i].bg = (Color){.bgra = {0x30, 0x20, 0x10, 255}};
+        /* the schemes differ so a scheme change shows in the pixels */
+        e->schemes[i].fg = i ? (Color){.bgra = {0x60, 0xa0, 0x20, 255}}
+                             : (Color){.bgra = {0x20, 0x90, 0xe0, 255}};
+        e->schemes[i].high = (Color){.bgra = {0xf0, 0x40, 0x60, 255}};
+        e->schemes[i].text = (Color){.color = UINT32_MAX};
+        e->schemes[i].text_press = (Color){.color = UINT32_MAX};
+        e->schemes[i].rounding = 3;
+        e->schemes[i].text_font = text_font_new("Sans 14");
+    }
+    e->ds = (struct drwsurf){.ctx = &e->ctx, .format = format,
+                             .back_buffer = &e->back,
+                             .display_buffer = &e->display};
+    e->popup = (struct drwsurf){.ctx = &e->ctx, .format = DRW_FORMAT_ARGB8888,
+                                .back_buffer = &e->pback,
+                                .display_buffer = &e->pdisplay};
+    drwsurf_resize(&e->ds, W, H, 1.0);
+    drwsurf_resize(&e->popup, W, H * 2, 1.0);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_init_layout(&layouts[i], W, H);
+    e->kb = (struct kbd){.surf = &e->ds, .popup_surf = &e->popup,
+                         .schemes = e->schemes, .layout = &layouts[0],
+                         .w = W, .h = H, .scale = 1.0,
+                         .show_highlight = true};
+}
+
+static void
+env_free(struct env *e)
+{
+    for (int i = 0; i < 2; i++)
+        text_font_free(e->schemes[i].text_font);
+    drwsurf_drop_buffers(&e->ds);
+    drwsurf_drop_buffers(&e->popup);
+    cairo_region_destroy(e->ds.damage);
+    cairo_region_destroy(e->ds.backport_damage);
+    cairo_region_destroy(e->popup.damage);
+    cairo_region_destroy(e->popup.backport_damage);
+}
+
+static void
+clear_damage(struct drwsurf *ds)
+{
+    cairo_region_subtract(ds->damage, ds->damage);
+    cairo_region_subtract(ds->backport_damage, ds->backport_damage);
+}
+
+static uint32_t
+pixel(struct drwsurf *ds, uint32_t x, uint32_t y)
+{
+    uint32_t stride, size;
+    drw_buffer_geometry(ds->format, ds->width, ds->height, &stride, &size);
+    cairo_surface_flush(ds->back_buffer->cairo_surf);
+    const unsigned char *p = ds->back_buffer->pool_data + (size_t)y * stride;
+    if (ds->format == DRW_FORMAT_RGB565) {
+        uint16_t v;
+        memcpy(&v, p + x * 2, 2);
+        return v;
+    }
+    uint32_t v;
+    memcpy(&v, p + x * 4, 4);
+    return v;
+}
+
+static uint32_t *
+snapshot(struct drwsurf *ds)
+{
+    uint32_t *s = malloc(sizeof(uint32_t) * W * H);
+    for (uint32_t y = 0; y < H; y++)
+        for (uint32_t x = 0; x < W; x++)
+            s[y * W + x] = pixel(ds, x, y);
+    return s;
+}
+
+static bool
+drawable(const struct key *k)
+{
+    return k->type != Pad && k->type != EndRow && k->type != Last;
+}
+
+static void
+add_key(cairo_region_t *r, const struct key *k)
+{
+    cairo_rectangle_int_t rect = {k->x, k->y, k->w, k->h};
+    cairo_region_union_rectangle(r, &rect);
+}
+
+static cairo_region_t *
+whole_surface(void)
+{
+    cairo_rectangle_int_t rect = {0, 0, W, H};
+    return cairo_region_create_rectangle(&rect);
+}
+
+/* Some key rows end a pixel past the right edge when the width does not
+ * divide evenly, and damage there is harmless, so only the part on the
+ * surface is compared. */
+static bool
+damage_equal(cairo_region_t *damage, cairo_region_t *want, int w, int h)
+{
+    cairo_rectangle_int_t surf = {0, 0, w, h};
+    cairo_region_t *d = cairo_region_copy(damage), *x = cairo_region_copy(want);
+    cairo_region_intersect_rectangle(d, &surf);
+    cairo_region_intersect_rectangle(x, &surf);
+    bool same = cairo_region_equal(d, x);
+    cairo_region_destroy(d);
+    cairo_region_destroy(x);
+    return same;
+}
+
+/* The two layers put the same kind of key in the same place, key for key. */
+static bool
+same_geometry(const struct layout *a, const struct layout *b)
+{
+    const struct key *x = a->keys, *y = b->keys;
+    for (; x->type != Last && y->type != Last; x++, y++) {
+        if (x->type != y->type)
+            return false;
+        if (drawable(x) && (x->x != y->x || x->y != y->y || x->w != y->w ||
+                            x->h != y->h))
+            return false;
+    }
+    return x->type == Last && y->type == Last;
+}
+
+/* Compares what the surface shows with a from-scratch render of the same
+ * keyboard state, and the pixels outside the damage with an earlier render. */
+static void
+check_pixels(const char *what, struct env *e, const uint32_t *before,
+             struct layout *layout, uint8_t mods, bool all_may_change,
+             cairo_region_t *damage)
+{
+    struct env fresh;
+    env_init(&fresh, e->ds.format);
+    fresh.kb.layout = layout;
+    fresh.kb.mods = mods;
+    fresh.kb.compose = e->kb.compose;
+    kbd_draw_layout(&fresh.kb);
+    uint32_t *want = snapshot(&fresh.ds), *got = snapshot(&e->ds);
+
+    int wrong = 0, moved_outside = 0, moved_inside = 0;
+    for (uint32_t y = 0; y < H; y++)
+        for (uint32_t x = 0; x < W; x++) {
+            uint32_t i = y * W + x;
+            wrong += got[i] != want[i];
+            if (got[i] != before[i]) {
+                if (cairo_region_contains_point(damage, x, y))
+                    moved_inside++;
+                else
+                    moved_outside++;
+            }
+        }
+    CHECK(wrong == 0, "%s: %d pixels differ from a full redraw", what, wrong);
+    CHECK(moved_outside == 0, "%s: %d pixels changed outside the damage",
+          what, moved_outside);
+    if (!all_may_change)
+        CHECK(moved_inside > 0, "%s: nothing changed inside the damage", what);
+    free(want);
+    free(got);
+    env_free(&fresh);
+}
+
+static void
+test_shift(enum drw_format format)
+{
+    struct env e;
+    env_init(&e, format);
+    struct layout *l = &layouts[0];
+    kbd_draw_layout(&e.kb);
+    uint32_t *plain = snapshot(&e.ds);
+
+    /* With shift every key shows its shift label, and the shift key itself
+     * is drawn pressed. */
+    cairo_region_t *want = cairo_region_create();
+    int changed = 0, total = 0;
+    for (const struct key *k = l->keys; k->type != Last; k++) {
+        if (!drawable(k))
+            continue;
+        total++;
+        if (strcmp(k->label, k->shift_label) || (k->type == Mod && k->code == Shift)) {
+            add_key(want, k);
+            changed++;
+        }
+    }
+    CHECK(changed > 0 && changed < total,
+          "layout 0 has %d of %d keys that change with shift", changed, total);
+
+    clear_damage(&e.ds);
+    e.kb.mods = Shift;
+    kbd_redraw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+          "shift: damage is not the %d changed keys", changed);
+    CHECK(damage_equal(e.ds.backport_damage, want, e.ds.width, e.ds.height),
+          "shift: backport region is not the %d changed keys", changed);
+    check_pixels("shift", &e, plain, l, Shift, false, e.ds.damage);
+
+    clear_damage(&e.ds);
+    e.kb.mods = 0;
+    kbd_redraw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+          "unshift: damage is not the %d changed keys", changed);
+    uint32_t *back = snapshot(&e.ds);
+    CHECK(!memcmp(back, plain, sizeof(uint32_t) * W * H),
+          "unshift: pixels differ from the first render");
+    free(back);
+
+    cairo_region_destroy(want);
+    free(plain);
+    env_free(&e);
+}
+
+/* Returns 1 for a pair compared key by key, 0 for one that must repaint
+ * everything. */
+static int
+test_switch(enum drw_format format, struct layout *p, struct layout *q,
+            uint8_t mods)
+{
+    char what[64];
+    snprintf(what, sizeof(what), "%s -> %s mods %d", p->name ? p->name : "?",
+             q->name ? q->name : "?", mods);
+    struct env e;
+    env_init(&e, format);
+    e.kb.layout = p;
+    e.kb.mods = mods;
+    kbd_draw_layout(&e.kb);
+    uint32_t *before = snapshot(&e.ds);
+
+    bool same = same_geometry(p, q);
+    cairo_region_t *want = cairo_region_create();
+    if (same) {
+        const struct key *a = p->keys, *b = q->keys;
+        for (; a->type != Last; a++, b++) {
+            if (!drawable(a))
+                continue;
+            const char *la = mods & Shift ? a->shift_label : a->label;
+            const char *lb = mods & Shift ? b->shift_label : b->label;
+            if (strcmp(la, lb) || a->scheme != b->scheme)
+                add_key(want, b);
+        }
+    } else {
+        cairo_region_destroy(want);
+        want = whole_surface();
+    }
+
+    clear_damage(&e.ds);
+    kbd_switch_layout(&e.kb, q, 0);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height), "%s: wrong damage (%s)", what,
+          same ? "changed keys" : "whole surface");
+    CHECK(damage_equal(e.ds.backport_damage, want, e.ds.width, e.ds.height),
+          "%s: wrong backport region", what);
+    check_pixels(what, &e, before, q, mods, !same || cairo_region_is_empty(want),
+                 e.ds.damage);
+
+    cairo_region_destroy(want);
+    free(before);
+    env_free(&e);
+    return same;
+}
+
+static void
+test_layers(enum drw_format format)
+{
+    int compared = 0, fallback = 0;
+    for (int i = 0; i < NumLayouts; i++)
+        for (int j = i + 1; j < NumLayouts; j++) {
+            struct layout *p = &layouts[i], *q = &layouts[j];
+            if (strcmp(p->keymap_name, q->keymap_name))
+                continue; /* a different keymap would be uploaded */
+            if (test_switch(format, p, q, 0))
+                compared++;
+            else
+                fallback++;
+            if (format == DRW_FORMAT_RGB565 && i < 2)
+                test_switch(format, p, q, Shift);
+        }
+    CHECK(compared > 0, "no pair of layers has the same geometry");
+    CHECK(fallback > 0, "no pair of layers has different geometry");
+    fprintf(stderr, "format %d: %d pairs compared by key, %d full redraws\n",
+            format, compared, fallback);
+}
+
+/* No pair of the shipped layers differs only in a key's colour scheme, so
+ * make one: same keys, one of them in the other scheme. */
+static void
+test_scheme(enum drw_format format)
+{
+    struct layout *p = &layouts[0];
+    size_t n = 0;
+    while (p->keys[n].type != Last)
+        n++;
+    struct key *copy = malloc((n + 1) * sizeof(struct key));
+    memcpy(copy, p->keys, (n + 1) * sizeof(struct key));
+    struct layout q = *p;
+    q.keys = copy;
+    int flipped = 0;
+    for (size_t i = 0; i < n && flipped < 3; i++)
+        if (drawable(&copy[i]) && copy[i].type == Code && i % 4 == 1) {
+            copy[i].scheme ^= 1;
+            flipped++;
+        }
+    CHECK(flipped == 3, "could not change the scheme of three keys");
+    CHECK(test_switch(format, p, &q, 0) == 1, "copy has the same geometry");
+    free(copy);
+}
+
+static void
+test_full_redraws(enum drw_format format)
+{
+    struct env e;
+    env_init(&e, format);
+    cairo_region_t *all = whole_surface();
+
+    /* nothing drawn yet */
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, all, e.ds.width, e.ds.height),
+          "first draw is not a full redraw");
+
+    /* nothing changed: nothing to report */
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    CHECK(cairo_region_is_empty(e.ds.damage),
+          "an unchanged keyboard reported damage");
+
+    /* an explicit full draw, as show() after hide() does */
+    clear_damage(&e.ds);
+    kbd_draw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, all, e.ds.width, e.ds.height), "kbd_draw_layout is partial");
+
+    /* resize */
+    e.kb.w = 200;
+    e.kb.h = 100;
+    clear_damage(&e.ds);
+    CHECK(kbd_resize(&e.kb, layouts, NumLayouts), "resize failed");
+    cairo_rectangle_int_t r = {0, 0, 200, 100};
+    cairo_region_t *small = cairo_region_create_rectangle(&r);
+    CHECK(damage_equal(e.ds.damage, small, e.ds.width, e.ds.height),
+          "resize did not repaint the whole new surface");
+    cairo_region_destroy(small);
+
+    /* a surface that could not be drawn on leaves nothing to build on */
+    struct drwbuf saved = e.back;
+    e.back.cairo_surf = NULL;
+    kbd_draw_layout(&e.kb);
+    CHECK(e.kb.drawn_layout == NULL, "an undrawn surface counts as drawn");
+    e.back = saved;
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    cairo_rectangle_int_t r2 = {0, 0, 200, 100};
+    small = cairo_region_create_rectangle(&r2);
+    CHECK(damage_equal(e.ds.damage, small, e.ds.width, e.ds.height),
+          "no full redraw after an undrawn surface");
+    cairo_region_destroy(small);
+
+    cairo_region_destroy(all);
+    env_free(&e);
+}
+
+static void
+test_pressed(enum drw_format format)
+{
+    struct env e;
+    env_init(&e, format);
+    struct layout *l = &layouts[0];
+    kbd_draw_layout(&e.kb);
+    uint32_t *plain = snapshot(&e.ds);
+
+    struct key *code = NULL, *ctrl = NULL;
+    for (struct key *k = l->keys; k->type != Last; k++) {
+        if (!code && k->type == Code && k->w > 8)
+            code = k;
+        if (!ctrl && k->type == Mod && k->code == Ctrl)
+            ctrl = k;
+    }
+    CHECK(code && ctrl, "layout 0 lacks a code key or a Ctrl key");
+    if (!code || !ctrl)
+        return;
+
+    /* a key still drawn highlighted from a press is repainted by the next
+     * redraw, as a full draw would paint it */
+    kbd_draw_key(&e.kb, code, Press);
+    e.kb.last_press = code;
+    uint32_t *held = snapshot(&e.ds);
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    cairo_region_t *want = cairo_region_create();
+    add_key(want, code);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+          "pressed key: damage is not that key");
+    check_pixels("pressed key", &e, held, l, 0, false, e.ds.damage);
+    free(held);
+    e.kb.last_press = NULL;
+
+    /* toggling a modifier repaints every key that carries it, since a layer
+     * may have two */
+    cairo_region_destroy(want);
+    want = cairo_region_create();
+    for (const struct key *k = l->keys; k->type != Last; k++)
+        if (k->type == Mod && k->code == Ctrl)
+            add_key(want, k);
+    e.kb.mods |= Ctrl;
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+          "ctrl pressed: damage is not the Ctrl keys");
+    check_pixels("ctrl pressed", &e, plain, l, Ctrl, false, e.ds.damage);
+    e.kb.mods = 0;
+    clear_damage(&e.ds);
+    kbd_redraw_layout(&e.kb);
+    CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+          "ctrl released: damage is not the Ctrl keys");
+    uint32_t *after = snapshot(&e.ds);
+    CHECK(!memcmp(after, plain, sizeof(uint32_t) * W * H),
+          "ctrl released: pixels differ from the plain render");
+    free(after);
+
+    /* the compose key is pressed while a compose is pending */
+    struct layout *cl = NULL;
+    for (int i = 0; i < NumLayouts && !cl; i++)
+        for (const struct key *k = layouts[i].keys; k->type != Last; k++)
+            if (k->type == Compose)
+                cl = &layouts[i];
+    CHECK(cl != NULL, "no layout has a compose key");
+    if (cl) {
+        cairo_region_destroy(want);
+        want = cairo_region_create();
+        for (const struct key *k = cl->keys; k->type != Last; k++)
+            if (k->type == Compose)
+                add_key(want, k);
+        e.kb.layout = cl;
+        kbd_draw_layout(&e.kb);
+        uint32_t *idle = snapshot(&e.ds);
+        e.kb.compose = 1;
+        clear_damage(&e.ds);
+        kbd_redraw_layout(&e.kb);
+        CHECK(damage_equal(e.ds.damage, want, e.ds.width, e.ds.height),
+              "compose pending: damage is not the compose keys");
+        check_pixels("compose pending", &e, idle, cl, 0, false, e.ds.damage);
+        free(idle);
+    }
+    cairo_region_destroy(want);
+    free(plain);
+    env_free(&e);
+}
+
+int
+main(void)
+{
+    for (int f = DRW_FORMAT_RGB565; f <= DRW_FORMAT_ARGB8888; f++) {
+        test_shift(f);
+        test_layers(f);
+        test_scheme(f);
+        test_full_redraws(f);
+        test_pressed(f);
+    }
+    if (failures)
+        fprintf(stderr, "%d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
