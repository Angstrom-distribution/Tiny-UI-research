diff --git a/tests/test-popup.c b/tests/test-popup.c
new file mode 100644
index 0000000..f1aff9e
--- /dev/null
+++ b/tests/test-popup.c
@@ -0,0 +1,146 @@
+/* What the key popup costs while it is off: no buffers. allocate_shm_file is
+ * replaced by a counter, so every buffer the drawing layer asks for shows. */
+#include <cairo.h>
+#include <linux/input-event-codes.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "check.h"
+#include "keyboard.h"
+#include "text.h"
+
+enum { W = 240, H = 100 };
+
+static unsigned allocations;
+
+int
+allocate_shm_file(size_t size)
+{
+    allocations++;
+    char path[] = "/tmp/wvkbd-test-XXXXXX";
+    int fd = mkstemp(path);
+    if (fd < 0)
+        return -1;
+    unlink(path);
+    if (ftruncate(fd, size) < 0) {
+        close(fd);
+        return -1;
+    }
+    return fd;
+}
+
+struct env {
+    struct drw ctx;
+    struct drwbuf back, display, pback, pdisplay;
+    struct drwsurf ds, popup;
+    struct clr_scheme schemes[2];
+    struct kbd kb;
+};
+
+static void
+env_init(struct env *e, bool show_popup)
+{
+    memset(e, 0, sizeof(*e));
+    for (int i = 0; i < 2; i++) {
+        e->schemes[i].bg = (Color){.bgra = {0x30, 0x20, 0x10, 255}};
+        e->schemes[i].fg = (Color){.bgra = {0x20, 0x90, 0xe0, 255}};
+        e->schemes[i].high = (Color){.bgra = {0xf0, 0x40, 0x60, 255}};
+        e->schemes[i].text = (Color){.color = UINT32_MAX};
+        e->schemes[i].text_press = (Color){.color = UINT32_MAX};
+        e->schemes[i].text_font = text_font_new("Sans 8");
+    }
+    e->ds = (struct drwsurf){.ctx = &e->ctx, .format = DRW_FORMAT_RGB565,
+                             .back_buffer = &e->back,
+                             .display_buffer = &e->display};
+    e->popup = (struct drwsurf){.ctx = &e->ctx, .format = DRW_FORMAT_ARGB8888,
+                                .back_buffer = &e->pback,
+                                .display_buffer = &e->pdisplay};
+    e->kb = (struct kbd){.surf = &e->ds, .popup_surf = &e->popup,
+                         .schemes = e->schemes, .layout = &layouts[0],
+                         .w = W, .h = H, .scale = 1.0,
+                         .show_highlight = true, .show_popup = show_popup};
+}
+
+static void
+env_free(struct env *e)
+{
+    for (int i = 0; i < 2; i++)
+        text_font_free(e->schemes[i].text_font);
+    drwsurf_free(&e->ds);
+    drwsurf_free(&e->popup);
+}
+
+static bool
+popup_has_memory(struct env *e)
+{
+    return e->pback.pool_data || e->pdisplay.pool_data ||
+           e->pback.cairo_surf || e->pdisplay.cairo_surf ||
+           drwsurf_usable(&e->popup);
+}
+
+static void
+test_off(void)
+{
+    struct env e;
+    env_init(&e, false);
+    allocations = 0;
+    CHECK(kbd_resize(&e.kb, layouts, NumLayouts), "resize");
+    CHECK(allocations == 2, "a keyboard without popup makes 2 buffers, made %u",
+          allocations);
+    CHECK(drwsurf_usable(&e.ds), "the keyboard itself is drawable");
+    CHECK(!popup_has_memory(&e), "the popup holds no memory");
+
+    /* later resizes, the sync a map does, and a key press ask for nothing */
+    e.kb.w = 200;
+    CHECK(kbd_resize(&e.kb, layouts, NumLayouts), "second resize");
+    CHECK(!kbd_popup_buffers(&e.kb, false), "the sync reports no popup");
+    CHECK(!kbd_popup_buffers(&e.kb, true), "even when forced");
+    struct key *k = &e.kb.layout->keys[0];
+    kbd_draw_key(&e.kb, k, Press);
+    kbd_draw_key(&e.kb, k, Unpress);
+    CHECK(allocations == 4, "two resizes made 4 buffers in all, made %u",
+          allocations);
+    CHECK(!popup_has_memory(&e) && !e.popup.damage,
+          "a key press does not touch the popup");
+    env_free(&e);
+}
+
+static void
+test_on_and_lazy(void)
+{
+    struct env e;
+    env_init(&e, true);
+    allocations = 0;
+    CHECK(kbd_resize(&e.kb, layouts, NumLayouts), "resize");
+    CHECK(allocations == 4, "a keyboard with popup makes 4 buffers, made %u",
+          allocations);
+    CHECK(drwsurf_usable(&e.popup), "the popup is drawable");
+    CHECK(e.popup.height == H * 2, "at twice the keyboard height");
+    CHECK(kbd_popup_buffers(&e.kb, false) && allocations == 4,
+          "the sync keeps usable buffers");
+
+    /* turned off at run time: the memory goes back */
+    e.kb.show_popup = false;
+    CHECK(!kbd_popup_buffers(&e.kb, false), "off again");
+    CHECK(!popup_has_memory(&e), "and the popup's buffers are freed");
+
+    /* turned on later: made when first wanted, not before */
+    allocations = 0;
+    e.kb.show_popup = true;
+    CHECK(kbd_popup_buffers(&e.kb, false) && allocations == 2,
+          "made on demand, %u allocations", allocations);
+    CHECK(kbd_popup_buffers(&e.kb, false) && allocations == 2,
+          "and once only");
+    env_free(&e);
+}
+
+int
+main(void)
+{
+    test_off();
+    test_on_and_lazy();
+    if (failures)
+        fprintf(stderr, "%d checks failed\n", failures);
+    return failures != 0;
+}
diff --git a/tests/test-visibility.c b/tests/test-visibility.c
new file mode 100644
index 0000000..ecd79e7
--- /dev/null
+++ b/tests/test-visibility.c
@@ -0,0 +1,318 @@
+/* The show/hide state machine without a compositor: which protocol actions
+ * each event asks for. What it cannot show is that a compositor accepts those
+ * actions, in particular that it sends the configure a remap waits for. */
+#include "check.h"
+#include "visibility.h"
+
+/* what main.c does with a layer configure: look at it only if it is accepted */
+static unsigned
+configure(struct vis *v, bool ready)
+{
+    return vis_accepts_configure(v) ? vis_configure(v, ready) : 0;
+}
+
+/* a keyboard that has been created, configured and mapped, as after start-up */
+static struct vis
+shown(void)
+{
+    struct vis v = {0};
+    CHECK(vis_show(&v, false) == VIS_CREATE, "first show creates");
+    CHECK(configure(&v, true) == VIS_MAP, "first configure maps");
+    return v;
+}
+
+/* the same with the popup made and configured */
+static struct vis
+shown_with_popup(void)
+{
+    struct vis v = shown();
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_BUILD, "the popup is made");
+    CHECK(vis_popup_configure(&v) == VIS_POPUP_MAP, "its configure maps it");
+    return v;
+}
+
+static void
+test_start(void)
+{
+    struct vis v = {0};
+    /* --hidden: nothing is created until the first show */
+    CHECK(vis_hide(&v) == 0, "hide before anything exists does nothing");
+    CHECK(!v.created && !v.visible, "and creates nothing");
+
+    CHECK(vis_show(&v, true) == VIS_CREATE, "show creates the surfaces");
+    CHECK(v.visible && !v.mapped, "visible but not mapped before a configure");
+    CHECK(vis_show(&v, true) == 0, "a second show while waiting does nothing");
+    CHECK(configure(&v, true) == VIS_MAP, "the configure maps it");
+    CHECK(v.mapped && v.configured, "mapped and configured");
+    CHECK(configure(&v, true) == 0, "a repeated configure maps nothing new");
+}
+
+static void
+test_hide_then_configure(void)
+{
+    struct vis v = shown();
+    CHECK(vis_hide(&v) == VIS_UNMAP, "hide unmaps");
+    CHECK(!v.mapped && !v.configured && !v.awaiting,
+          "unmapped, back to unconfigured and asking for nothing");
+    CHECK(vis_hide(&v) == 0, "hiding twice unmaps once");
+
+    /* A configure that was in flight when hide() ran, or that the compositor
+     * sends for an output change, answers no commit of ours. */
+    CHECK(!vis_accepts_configure(&v), "a configure while hidden is refused");
+    CHECK(configure(&v, true) == 0, "it does not map");
+    CHECK(!v.mapped && !v.configured,
+          "and does not make the surface count as configured");
+    CHECK(configure(&v, false) == 0 && !v.awaiting,
+          "a not-ready one changes nothing either");
+}
+
+/* The in-flight configure must not let a later show() attach a buffer to a
+ * surface the compositor sees as unconfigured. */
+static void
+test_configure_in_flight_at_hide(void)
+{
+    struct vis v = shown();
+    vis_hide(&v);
+    CHECK(configure(&v, true) == 0, "the stale configure is dropped");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE,
+          "show cannot map from it, it asks for a configure");
+    CHECK(!v.mapped, "nothing is attached yet");
+    CHECK(vis_accepts_configure(&v), "the answer is accepted");
+    CHECK(configure(&v, true) == VIS_MAP, "and maps");
+
+    /* the same when the stale one is delivered after show() asked */
+    vis_hide(&v);
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "asks again");
+    CHECK(configure(&v, true) == VIS_MAP, "the answer maps");
+    CHECK(configure(&v, true) == 0 && v.mapped,
+          "a second one while mapped keeps it mapped");
+}
+
+static void
+test_show_after_hide(void)
+{
+    struct vis v = shown();
+    vis_hide(&v);
+
+    /* no configure has arrived since the unmap: ask for one, do not map */
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE,
+          "show without a configure asks for one");
+    CHECK(!v.mapped, "and does not map");
+    CHECK(configure(&v, true) == VIS_MAP, "the configure then maps");
+
+    vis_hide(&v);
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE,
+          "every show after an unmap asks, none maps on a leftover");
+    CHECK(configure(&v, true) == VIS_MAP, "the answer maps");
+    CHECK(v.mapped && v.visible, "mapped and visible");
+    CHECK(configure(&v, true) == 0, "a late duplicate configure is quiet");
+}
+
+static void
+test_geometry_change(void)
+{
+    struct vis v = shown();
+    vis_hide(&v);
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks");
+    CHECK(configure(&v, true) == VIS_MAP, "and maps");
+    vis_hide(&v);
+    /* rotated while hidden: the geometry no longer fits */
+    CHECK(vis_show(&v, false) == VIS_REQUEST_CONFIGURE,
+          "show with stale geometry renegotiates");
+    CHECK(!v.mapped && !v.configured, "nothing mapped yet");
+    CHECK(configure(&v, false) == 0 && v.awaiting,
+          "an intermediate size does not map and keeps waiting");
+    CHECK(configure(&v, true) == VIS_MAP, "the matching size maps");
+
+    /* resized while mapped keeps the old buffer until the new size is ready */
+    CHECK(configure(&v, false) == 0 && v.mapped,
+          "a not-ready configure leaves a mapped surface mapped");
+    CHECK(configure(&v, true) == 0 && v.mapped, "and a ready one keeps it");
+}
+
+static void
+test_hide_while_waiting(void)
+{
+    struct vis v = {0};
+    vis_show(&v, true);
+    /* hidden before the first configure arrived */
+    CHECK(vis_hide(&v) == 0, "nothing is mapped, so nothing to unmap");
+    CHECK(!v.visible, "no longer wanted");
+    /* nothing was ever unmapped, so the commit that asked is still pending */
+    CHECK(configure(&v, true) == 0 && !v.mapped,
+          "the configure that was in flight does not map");
+    CHECK(vis_show(&v, true) == VIS_MAP, "show maps from the stored configure");
+}
+
+static void
+test_toggles(void)
+{
+    struct vis v = shown();
+    for (int i = 0; i < 5; i++) {
+        CHECK(vis_hide(&v) == VIS_UNMAP, "toggle %d: hide unmaps", i);
+        CHECK(configure(&v, true) == 0, "toggle %d: a leftover stays quiet", i);
+        CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE,
+              "toggle %d: show asks", i);
+        CHECK(configure(&v, true) == VIS_MAP, "toggle %d: the answer maps", i);
+        CHECK(v.visible && v.mapped, "toggle %d: state", i);
+    }
+    /* signals can repeat: SIGUSR2 twice, SIGUSR1 twice */
+    CHECK(vis_show(&v, true) == 0, "show while shown does nothing");
+    vis_hide(&v);
+    CHECK(vis_hide(&v) == 0, "hide while hidden does nothing");
+    /* a toggle burst before the compositor answers */
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks");
+    CHECK(vis_hide(&v) == 0, "hide before the answer has nothing to unmap");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks again");
+    CHECK(configure(&v, true) == VIS_MAP, "the one configure maps");
+}
+
+static void
+test_auto(void)
+{
+    /* --auto: activate calls show(), deactivate calls hide(), repeatedly and
+     * with duplicates, which the input method protocol allows */
+    struct vis v = {0};
+    CHECK(vis_show(&v, true) == VIS_CREATE, "activate creates");
+    CHECK(configure(&v, true) == VIS_MAP, "and maps");
+    CHECK(vis_hide(&v) == VIS_UNMAP, "deactivate unmaps");
+    CHECK(vis_hide(&v) == 0, "a second deactivate is ignored");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "activate asks again");
+    CHECK(vis_show(&v, true) == 0, "a second activate is ignored");
+    CHECK(configure(&v, true) == VIS_MAP, "the configure maps");
+    CHECK(vis_hide(&v) == VIS_UNMAP, "deactivate unmaps again");
+    CHECK(configure(&v, true) == 0, "the leftover is dropped");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "activate asks");
+    /* an unusable buffer never maps */
+    struct vis w = {0};
+    vis_show(&w, true);
+    CHECK(configure(&w, false) == 0 && !w.mapped,
+          "a configure without usable buffers does not map");
+}
+
+static void
+test_popup_off(void)
+{
+    struct vis v = shown();
+    CHECK(vis_popup_sync(&v, false) == 0 && !v.popup_exists,
+          "a popup that is off is never made");
+    vis_hide(&v);
+    CHECK(vis_hide(&v) == 0, "hide");
+    vis_show(&v, true);
+    configure(&v, true);
+    CHECK(vis_popup_sync(&v, false) == 0 && !v.popup_exists,
+          "nor after a hide and a show");
+    struct vis w = {0};
+    vis_show(&w, true);
+    CHECK(vis_popup_sync(&w, true) == 0, "an unmapped keyboard has no popup");
+}
+
+static void
+test_popup_hide_show(void)
+{
+    struct vis v = shown_with_popup();
+    CHECK(v.popup_mapped, "the popup is mapped");
+    CHECK(vis_hide(&v) == (VIS_UNMAP | VIS_POPUP_UNMAP), "hide unmaps both");
+    CHECK(!v.popup_mapped && !v.popup_configured, "the popup is unconfigured");
+
+    /* its configure was in flight at hide */
+    CHECK(!vis_popup_accepts_configure(&v), "a popup configure while hidden is refused");
+    CHECK(vis_popup_configure(&v) == 0 && !v.popup_configured,
+          "it does not count as configured");
+
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks");
+    CHECK(configure(&v, true) == VIS_MAP, "the layer maps");
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_COMMIT,
+          "the popup asks again instead of attaching to an unconfigured surface");
+    CHECK(!v.popup_mapped, "nothing attached to the popup");
+    CHECK(vis_popup_sync(&v, true) == 0, "a second sync waits");
+    CHECK(vis_popup_configure(&v) == VIS_POPUP_MAP, "the answer maps it");
+    CHECK(vis_popup_configure(&v) == 0, "a repeat is quiet");
+}
+
+static void
+test_popup_waiting_at_hide(void)
+{
+    struct vis v = shown();
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_BUILD, "made");
+    /* hidden before its first configure */
+    CHECK(vis_hide(&v) == (VIS_UNMAP | VIS_POPUP_UNMAP), "hide");
+    CHECK(v.popup_awaiting, "its first configure is still expected");
+    /* it arrives while show() waits in refresh_available_dimension() */
+    CHECK(vis_popup_accepts_configure(&v), "and is accepted");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks");
+    CHECK(vis_popup_configure(&v) == 0 && v.popup_configured && !v.popup_mapped,
+          "recorded, but nothing is attached under an unmapped layer");
+    CHECK(configure(&v, true) == VIS_MAP, "the layer maps");
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_MAP,
+          "the popup maps without a second buffer-less commit");
+}
+
+/* A second buffer-less commit gets no second configure, so after a hide that
+ * came before the first one the popup must only wait. */
+static void
+test_popup_waiting_across_show(void)
+{
+    struct vis v = shown();
+    vis_popup_sync(&v, true);
+    vis_hide(&v);
+    vis_show(&v, true);
+    configure(&v, true);
+    CHECK(vis_popup_sync(&v, true) == 0, "no commit while the configure is due");
+    CHECK(vis_popup_configure(&v) == VIS_POPUP_MAP, "it arrives and maps");
+}
+
+static void
+test_popup_done_while_hidden(void)
+{
+    struct vis v = shown_with_popup();
+    vis_hide(&v);
+    /* the compositor dismisses it while the keyboard is hidden */
+    vis_popup_gone(&v);
+    CHECK(!v.popup_exists, "the role object is gone");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show asks");
+    CHECK(configure(&v, true) == VIS_MAP, "the layer maps");
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_BUILD,
+          "show makes the popup again");
+    CHECK(vis_popup_configure(&v) == VIS_POPUP_MAP, "and it maps");
+    CHECK(v.mapped && v.popup_mapped, "the keyboard shows with its popup");
+}
+
+static void
+test_popup_done_while_shown(void)
+{
+    struct vis v = shown_with_popup();
+    vis_popup_gone(&v);
+    CHECK(v.mapped, "the keyboard stays mapped");
+    CHECK(!vis_popup_accepts_configure(&v), "a late popup configure is refused");
+    /* a resize of the mapped keyboard makes it again */
+    CHECK(vis_popup_sync(&v, true) == VIS_POPUP_BUILD, "made again");
+    CHECK(vis_hide(&v) == (VIS_UNMAP | VIS_POPUP_UNMAP), "hide");
+    CHECK(vis_show(&v, true) == VIS_REQUEST_CONFIGURE, "show");
+    CHECK(configure(&v, true) == VIS_MAP, "maps");
+    CHECK(vis_popup_sync(&v, true) == 0,
+          "the remade popup is still owed its first configure");
+    CHECK(vis_popup_configure(&v) == VIS_POPUP_MAP, "which maps it");
+}
+
+int
+main(void)
+{
+    test_start();
+    test_hide_then_configure();
+    test_configure_in_flight_at_hide();
+    test_show_after_hide();
+    test_geometry_change();
+    test_hide_while_waiting();
+    test_toggles();
+    test_auto();
+    test_popup_off();
+    test_popup_hide_show();
+    test_popup_waiting_at_hide();
+    test_popup_waiting_across_show();
+    test_popup_done_while_hidden();
+    test_popup_done_while_shown();
+    if (failures)
+        fprintf(stderr, "%d checks failed\n", failures);
+    return failures != 0;
+}
diff --git a/visibility.c b/visibility.c
new file mode 100644
index 0000000..e11f733
--- /dev/null
+++ b/visibility.c
@@ -0,0 +1,125 @@
+#include "visibility.h"
+
+unsigned
+vis_show(struct vis *v, bool geometry_ok)
+{
+    if (!v->created) {
+        v->created = true;
+        v->visible = true;
+        v->awaiting = true;
+        return VIS_CREATE;
+    }
+    if (v->visible)
+        return 0;
+    v->visible = true;
+    if (!geometry_ok)
+        v->configured = false;
+    if (v->configured) {
+        v->mapped = true;
+        return VIS_MAP;
+    }
+    v->awaiting = true;
+    return VIS_REQUEST_CONFIGURE;
+}
+
+unsigned
+vis_hide(struct vis *v)
+{
+    if (!v->visible)
+        return 0;
+    v->visible = false;
+    if (!v->mapped)
+        return 0;
+    v->mapped = false;
+    v->configured = false;
+    v->awaiting = false;
+    unsigned act = VIS_UNMAP;
+    if (v->popup_exists) {
+        act |= VIS_POPUP_UNMAP;
+        /* A popup that was never configured still has its first configure
+         * coming, and a compositor sends that only once: dropping it would
+         * leave a later commit waiting for an answer that never comes. */
+        if (v->popup_mapped || v->popup_configured)
+            v->popup_awaiting = false;
+        v->popup_mapped = v->popup_configured = false;
+    }
+    return act;
+}
+
+bool
+vis_accepts_configure(const struct vis *v)
+{
+    return v->mapped || v->awaiting;
+}
+
+unsigned
+vis_configure(struct vis *v, bool ready)
+{
+    if (!vis_accepts_configure(v))
+        return 0;
+    if (!ready) {
+        /* A mapped surface keeps its old buffer until a ready configure; one
+         * that is not mapped has asked for the size it wants and waits for
+         * the answer. */
+        if (!v->mapped) {
+            v->configured = false;
+            v->awaiting = true;
+        }
+        return 0;
+    }
+    v->configured = true;
+    v->awaiting = false;
+    if (v->visible && !v->mapped) {
+        v->mapped = true;
+        return VIS_MAP;
+    }
+    return 0;
+}
+
+unsigned
+vis_popup_sync(struct vis *v, bool wanted)
+{
+    if (!wanted || !v->mapped)
+        return 0;
+    if (!v->popup_exists) {
+        v->popup_exists = true;
+        v->popup_awaiting = true;
+        v->popup_configured = v->popup_mapped = false;
+        return VIS_POPUP_BUILD;
+    }
+    if (v->popup_configured) {
+        v->popup_mapped = true;
+        return VIS_POPUP_MAP;
+    }
+    if (v->popup_awaiting)
+        return 0;
+    v->popup_awaiting = true;
+    return VIS_POPUP_COMMIT;
+}
+
+bool
+vis_popup_accepts_configure(const struct vis *v)
+{
+    return v->popup_exists && (v->popup_awaiting || v->popup_mapped);
+}
+
+unsigned
+vis_popup_configure(struct vis *v)
+{
+    if (!vis_popup_accepts_configure(v))
+        return 0;
+    v->popup_configured = true;
+    v->popup_awaiting = false;
+    if (v->mapped && !v->popup_mapped) {
+        v->popup_mapped = true;
+        return VIS_POPUP_MAP;
+    }
+    return 0;
+}
+
+void
+vis_popup_gone(struct vis *v)
+{
+    v->popup_exists = v->popup_awaiting = v->popup_configured =
+        v->popup_mapped = false;
+}
diff --git a/visibility.h b/visibility.h
new file mode 100644
index 0000000..f12c297
--- /dev/null
+++ b/visibility.h
@@ -0,0 +1,72 @@
+#ifndef VISIBILITY_H
+#define VISIBILITY_H
+
+#include <stdbool.h>
+
+/* The keyboard's surfaces are created once and stay alive while it is hidden.
+ * This is the state that decides when they are mapped, kept free of Wayland
+ * calls so the sequences can be tested without a compositor: main.c turns the
+ * returned actions into protocol requests.
+ *
+ * The layer-shell and xdg-shell specs return an unmapped surface to its
+ * unconfigured state: a surface is only configured again by a configure that
+ * the compositor sends in answer to a commit without a buffer made after the
+ * unmap, and attaching a buffer before that configure is acked is a protocol
+ * error. A configure that was already in flight when the surface was unmapped
+ * answers nothing, so it is not allowed to count. That is why "configured" is
+ * cleared by an unmap, why only a surface that has asked for a configure
+ * ("awaiting") accepts one, and why show() may have to ask for one. */
+struct vis {
+    bool created;    /* surfaces exist */
+    bool visible;    /* the user wants the keyboard shown */
+    bool configured; /* configure acked at the current size, buffers usable */
+    bool mapped;     /* a buffer is attached to the layer surface */
+    bool awaiting;   /* a commit without a buffer was made, no configure yet */
+
+    /* The key popup is an xdg_popup of the layer surface. It has the same
+     * rules, and the compositor may also dismiss it (popup_done), after which
+     * the role object is gone and must be made again. */
+    bool popup_exists;     /* the xdg_popup role object exists */
+    bool popup_awaiting;   /* its initial commit was made, no configure yet */
+    bool popup_configured; /* a configure arrived after that commit */
+    bool popup_mapped;     /* a buffer is attached to the popup surface */
+};
+
+enum vis_action {
+    VIS_CREATE = 1,            /* make the surfaces and send the first commit */
+    VIS_MAP = 2,               /* attach the buffers */
+    VIS_UNMAP = 4,             /* attach no buffer and commit */
+    VIS_REQUEST_CONFIGURE = 8, /* commit without a buffer and wait */
+
+    /* what the popup needs after the layer surface is mapped */
+    VIS_POPUP_BUILD = 16,      /* make the xdg_popup and commit without a buffer */
+    VIS_POPUP_COMMIT = 32,     /* commit the existing popup without a buffer */
+    VIS_POPUP_MAP = 64,        /* attach the popup's buffer */
+    VIS_POPUP_UNMAP = 128,     /* with VIS_UNMAP: the popup was mapped or waiting */
+};
+
+/* geometry_ok: the size and scale that a show() would now use still equal
+ * the ones the configured buffers were made for. */
+unsigned vis_show(struct vis *v, bool geometry_ok);
+unsigned vis_hide(struct vis *v);
+/* Whether a layer configure may be looked at: the surface is mapped, or it
+ * asked for one. Anything else is a leftover of before an unmap, which must
+ * neither be acked nor recorded. */
+bool vis_accepts_configure(const struct vis *v);
+/* ready: the configured size equals the keyboard's and the buffers for it
+ * exist. A configure that is not ready never maps, and one that
+ * vis_accepts_configure refuses changes nothing. */
+unsigned vis_configure(struct vis *v, bool ready);
+
+/* The popup after the layer surface got its buffer, or after a resize of a
+ * mapped surface. wanted: the popup is on and its buffers exist. */
+unsigned vis_popup_sync(struct vis *v, bool wanted);
+bool vis_popup_accepts_configure(const struct vis *v);
+/* Returns VIS_POPUP_MAP when the popup's buffer can be attached now. A
+ * configure that vis_popup_accepts_configure refuses changes nothing. */
+unsigned vis_popup_configure(struct vis *v);
+/* The compositor dismissed the popup, or the keyboard changed size and the
+ * popup is to be made again: the role object is to be destroyed. */
+void vis_popup_gone(struct vis *v);
+
+#endif
