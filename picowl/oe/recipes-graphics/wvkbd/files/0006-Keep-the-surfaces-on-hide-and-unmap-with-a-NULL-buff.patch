+/* What drwsurf_resize leaves behind when memory runs out, with allocate_shm_file
+ * replaced so each failure can be forced. */
+#include <cairo.h>
+#include <fcntl.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "check.h"
+#include "drw.h"
+
+enum { OK, FAIL_ALLOC, FAIL_MMAP };
+static int mode = OK;
+static int calls_until_failure = -1; /* -1: use mode for every call */
+
+/* The tests only need plain memory, so a temporary file stands in for the
+ * shm object. An O_RDONLY descriptor makes the writable mapping fail. */
+int
+allocate_shm_file(size_t size)
+{
+    int m = mode;
+    if (calls_until_failure == 0)
+        m = FAIL_ALLOC;
+    else if (calls_until_failure > 0)
+        calls_until_failure--;
+    if (m == FAIL_ALLOC)
+        return -1;
+
+    char path[] = "/tmp/wvkbd-test-XXXXXX";
+    int fd = mkstemp(path);
+    if (fd < 0)
+        return -1;
+    unlink(path);
+    if (ftruncate(fd, size) < 0) {
+        close(fd);
+        return -1;
+    }
+    if (m == FAIL_MMAP) {
+        char proc[64];
+        snprintf(proc, sizeof(proc), "/proc/self/fd/%d", fd);
+        int ro = open(proc, O_RDONLY);
+        close(fd);
+        return ro;
+    }
+    return fd;
+}
+
+struct fixture {
+    struct drw ctx;
+    struct drwbuf back, display;
+    struct drwsurf ds;
+};
+
+static void
+init(struct fixture *f)
+{
+    memset(f, 0, sizeof(*f));
+    f->ds = (struct drwsurf){.ctx = &f->ctx, .format = DRW_FORMAT_ARGB8888,
+                             .back_buffer = &f->back,
+                             .display_buffer = &f->display};
+}
+
+/* what a resize must not change when it fails */
+struct snap {
+    uint32_t width, height;
+    double scale;
+    unsigned char *back_mem, *display_mem;
+    cairo_surface_t *back_cairo, *display_cairo;
+    uint32_t back_size;
+};
+
+static struct snap
+take(struct fixture *f)
+{
+    return (struct snap){f->ds.width, f->ds.height, f->ds.scale,
+                         f->back.pool_data, f->display.pool_data,
+                         f->back.cairo_surf, f->display.cairo_surf,
+                         f->back.size};
+}
+
+static void
+same(struct fixture *f, struct snap s, const char *what)
+{
+    CHECK(f->ds.width == s.width && f->ds.height == s.height &&
+              f->ds.scale == s.scale,
+          "%s: size and scale are unchanged", what);
+    CHECK(f->back.pool_data == s.back_mem &&
+              f->display.pool_data == s.display_mem,
+          "%s: both mappings are the old ones", what);
+    CHECK(f->back.cairo_surf == s.back_cairo &&
+              f->display.cairo_surf == s.display_cairo,
+          "%s: both cairo surfaces are the old ones", what);
+    CHECK(f->back.size == s.back_size, "%s: the size of the mapping is kept",
+          what);
+    CHECK(f->back.pool_data != MAP_FAILED, "%s: no MAP_FAILED left behind",
+          what);
+}
+
+static uint32_t
+first_pixel(struct drwbuf *b)
+{
+    uint32_t v;
+    cairo_surface_flush(b->cairo_surf);
+    memcpy(&v, b->pool_data, 4);
+    return v;
+}
+
+static void
+test_failures(void)
+{
+    static const struct { const char *name; int mode; int after; } cases[] = {
+        {"allocation fails", FAIL_ALLOC, -1},
+        {"mmap fails", FAIL_MMAP, -1},
+        {"second buffer fails", OK, 1},
+    };
+    for (unsigned i = 0; i < sizeof(cases) / sizeof(cases[0]); i++) {
+        struct fixture f;
+        init(&f);
+        mode = OK;
+        calls_until_failure = -1;
+        CHECK(drwsurf_resize(&f.ds, 40, 20, 1.0), "%s: first resize",
+              cases[i].name);
+        Color red = {.bgra = {0, 0, 255, 255}};
+        drw_fill_rectangle(&f.ds, red, 0, 0, 40, 20, 0);
+        struct snap before = take(&f);
+        uint32_t pixel = first_pixel(f.ds.back_buffer);
+
+        mode = cases[i].mode;
+        calls_until_failure = cases[i].after;
+        CHECK(!drwsurf_resize(&f.ds, 80, 40, 2.0), "%s: resize reports failure",
+              cases[i].name);
+        same(&f, before, cases[i].name);
+        CHECK(drwsurf_usable(&f.ds), "%s: the old buffers still work",
+              cases[i].name);
+        /* the old mapping must still be mapped: this would crash otherwise */
+        CHECK(first_pixel(f.ds.back_buffer) == pixel,
+              "%s: the old pixels are intact", cases[i].name);
+        Color blue = {.bgra = {255, 0, 0, 255}};
+        drw_fill_rectangle(&f.ds, blue, 0, 0, 40, 20, 0);
+        CHECK(first_pixel(f.ds.back_buffer) != pixel ||
+                  first_pixel(f.ds.display_buffer) != pixel,
+              "%s: drawing still reaches the old buffer", cases[i].name);
+
+        mode = OK;
+        calls_until_failure = -1;
+        CHECK(drwsurf_resize(&f.ds, 80, 40, 2.0), "%s: a retry succeeds",
+              cases[i].name);
+        CHECK(f.ds.width == 160 && f.ds.height == 80,
+              "%s: the retry has the new size", cases[i].name);
+        drwsurf_free(&f.ds);
+    }
+}
+
+static void
+test_first_failure(void)
+{
+    struct fixture f;
+    init(&f);
+    mode = FAIL_MMAP;
+    calls_until_failure = -1;
+    CHECK(!drwsurf_resize(&f.ds, 40, 20, 1.0), "first resize can fail");
+    CHECK(!drwsurf_usable(&f.ds), "the surface is unusable");
+    CHECK(f.ds.width == 0 && f.ds.height == 0, "and has no size");
+    CHECK(f.back.pool_data == NULL && f.display.pool_data == NULL,
+          "nothing is left mapped or MAP_FAILED");
+    /* every drawing call is skipped, none may touch a missing cairo */
+    Color c = {.color = UINT32_MAX};
+    drw_fill_rectangle(&f.ds, c, 0, 0, 10, 10, 0);
+    drw_over_rectangle(&f.ds, c, 0, 0, 10, 10, 3);
+    drw_do_clear(&f.ds, 0, 0, 10, 10);
+    drw_draw_text(&f.ds, c, 0, 0, 10, 10, 1, "a", NULL);
+    drwsurf_attach(&f.ds);
+    mode = OK;
+    CHECK(drwsurf_resize(&f.ds, 40, 20, 1.0) && drwsurf_usable(&f.ds),
+          "a later resize recovers");
+    drwsurf_drop_buffers(&f.ds);
+    CHECK(!drwsurf_usable(&f.ds), "dropping the buffers makes it unusable");
+    drwsurf_free(&f.ds);
+}
+
+static void
+test_setup_buffer(void)
+{
+    struct fixture f;
+    init(&f);
+    mode = OK;
+    calls_until_failure = -1;
+    drwsurf_resize(&f.ds, 40, 20, 1.0);
+    struct snap before = take(&f);
+    mode = FAIL_MMAP;
+    CHECK(setup_buffer(&f.ds, &f.back) == 1, "setup_buffer reports mmap failure");
+    same(&f, before, "setup_buffer");
+    mode = OK;
+    drwsurf_free(&f.ds);
+}
+
+int
+main(void)
+{
+    test_failures();
+    test_first_failure();
+    test_setup_buffer();
+    if (failures)
+        fprintf(stderr, "%d checks failed\n", failures);
+    return failures != 0;
+}
