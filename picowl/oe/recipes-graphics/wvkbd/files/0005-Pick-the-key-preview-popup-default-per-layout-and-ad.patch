diff --git a/tests/check-popup.sh b/tests/check-popup.sh
new file mode 100755
index 0000000..8f5dc99
--- /dev/null
+++ b/tests/check-popup.sh
@@ -0,0 +1,40 @@
+#!/bin/sh
+# usage: check-popup.sh BINARY CONFIG_HEADER
+# -D makes the binary report the resolved popup setting right after option
+# parsing, before it connects to Wayland, so this needs no compositor. The
+# expected default is read from the layout's config header, which is what
+# proves the macro reaches the binary.
+bin=$1
+cfg=$2
+want=$(sed -n 's/^#define DEFAULT_SHOW_POPUP \(true\|false\)$/\1/p' "$cfg")
+case $want in
+true) want=on ;;
+false) want=off ;;
+*) echo "no DEFAULT_SHOW_POPUP in $cfg"; exit 1 ;;
+esac
+
+unset WAYLAND_DISPLAY WAYLAND_SOCKET
+export XDG_RUNTIME_DIR=${TMPDIR:-/tmp}
+
+state() {
+	"$bin" -D "$@" 2>&1 | sed -n 's/^wvkbd: key popup //p'
+}
+expect() {
+	exp=$1; shift
+	got=$(state "$@")
+	[ "$got" = "$exp" ] || { echo "args '$*': got '$got', want '$exp'"; exit 1; }
+}
+
+expect "$want"
+expect on --popup
+expect off --no-popup
+expect off --no-feedback
+expect on --no-popup --popup
+expect off --popup --no-popup
+
+# The help text names the option and marks the layout's default.
+help=$("$bin" --help 2>&1)
+echo "$help" | grep -q -- '--popup ' || { echo "--help lacks --popup"; exit 1; }
+if [ "$want" = on ]; then mark=--popup; else mark=--no-popup; fi
+echo "$help" | grep -- "  $mark " | grep -q '(default)' ||
+	{ echo "--help does not mark $mark as default"; exit 1; }
