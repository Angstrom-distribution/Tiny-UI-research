diff --git a/tests/test-pointer.c b/tests/test-pointer.c
new file mode 100644
index 0000000..44f26df
--- /dev/null
+++ b/tests/test-pointer.c
@@ -0,0 +1,107 @@
+/* The pointer bookkeeping without a compositor. The sequences are the ones a
+ * stylus produces: the pointer jumps onto the keyboard, so a tap is enter,
+ * press, release with no motion. */
+#include "check.h"
+#include "pointer.h"
+
+static struct ptr
+fresh(void)
+{
+    struct ptr p;
+    ptr_init(&p);
+    return p;
+}
+
+static void
+test_tap_after_enter(void)
+{
+    /* the position seen on a real iPAQ: enter(83.9, 57.5), press, release */
+    struct ptr p = fresh();
+    int x = 0, y = 0;
+    ptr_enter(&p, 83, 57);
+    ptr_button(&p, true);
+    CHECK(ptr_target(&p, &x, &y), "a press right after enter has a target");
+    CHECK(x == 83 && y == 57, "target is the enter position, got %d,%d", x, y);
+    ptr_button(&p, false);
+    CHECK(!ptr_target(&p, &x, &y), "a release has no target");
+}
+
+static void
+test_tap_after_leave(void)
+{
+    struct ptr p = fresh();
+    int x = 0, y = 0;
+    ptr_motion(&p, 10, 10);
+    ptr_leave(&p);
+    ptr_enter(&p, 120, 200);
+    ptr_button(&p, true);
+    CHECK(ptr_target(&p, &x, &y) && x == 120 && y == 200,
+          "leave then enter then press resolves to the enter position");
+}
+
+static void
+test_no_position(void)
+{
+    struct ptr p = fresh();
+    int x = 7, y = 7;
+    CHECK(!ptr_known(&p), "nothing is known at start");
+    ptr_button(&p, true);
+    CHECK(!ptr_target(&p, &x, &y), "press with no enter and no motion");
+    CHECK(x == 7 && y == 7, "and the outputs are untouched");
+}
+
+static void
+test_motion_updates(void)
+{
+    struct ptr p = fresh();
+    int x = 0, y = 0;
+    ptr_enter(&p, 5, 5);
+    ptr_motion(&p, 90, 40);
+    ptr_button(&p, true);
+    CHECK(ptr_target(&p, &x, &y) && x == 90 && y == 40,
+          "motion after enter moves the target");
+}
+
+static void
+test_leave_clears(void)
+{
+    struct ptr p = fresh();
+    int x, y;
+    ptr_enter(&p, 5, 5);
+    ptr_leave(&p);
+    CHECK(!ptr_known(&p), "leave forgets the position");
+    ptr_button(&p, true);
+    CHECK(!ptr_target(&p, &x, &y), "so a press after leave finds nothing");
+}
+
+static void
+test_held_button(void)
+{
+    struct ptr p = fresh();
+    ptr_enter(&p, 5, 5);
+    CHECK(!ptr_enter(&p, 6, 6), "enter without a held button does not track");
+    CHECK(!ptr_motion(&p, 7, 7), "nor does motion");
+    ptr_button(&p, true);
+    /* motion hands the held key over to the one under the pointer; an enter
+     * while the button is held is the same jump */
+    CHECK(ptr_motion(&p, 8, 8), "motion with a held button tracks");
+    CHECK(ptr_enter(&p, 100, 100), "enter with a held button tracks too");
+    ptr_leave(&p);
+    CHECK(ptr_enter(&p, 20, 30), "so does enter after a leave");
+    int x = 0, y = 0;
+    CHECK(ptr_target(&p, &x, &y) && x == 20 && y == 30, "at the new position");
+}
+
+int
+main(void)
+{
+    test_tap_after_enter();
+    test_tap_after_leave();
+    test_no_position();
+    test_motion_updates();
+    test_leave_clears();
+    test_held_button();
+    if (failures)
+        fprintf(stderr, "%d checks failed\n", failures);
+    return failures != 0;
+}
