diff --git a/pointer.c b/pointer.c
new file mode 100644
index 0000000..0609a35
--- /dev/null
+++ b/pointer.c
@@ -0,0 +1,50 @@
+#include "pointer.h"
+
+void
+ptr_init(struct ptr *p)
+{
+    p->x = p->y = -1;
+    p->pressed = false;
+}
+
+bool
+ptr_enter(struct ptr *p, int x, int y)
+{
+    return ptr_motion(p, x, y);
+}
+
+bool
+ptr_motion(struct ptr *p, int x, int y)
+{
+    p->x = x;
+    p->y = y;
+    return p->pressed;
+}
+
+void
+ptr_leave(struct ptr *p)
+{
+    p->x = p->y = -1;
+}
+
+void
+ptr_button(struct ptr *p, bool pressed)
+{
+    p->pressed = pressed;
+}
+
+bool
+ptr_known(const struct ptr *p)
+{
+    return p->x >= 0 && p->y >= 0;
+}
+
+bool
+ptr_target(const struct ptr *p, int *x, int *y)
+{
+    if (!p->pressed || !ptr_known(p))
+        return false;
+    *x = p->x;
+    *y = p->y;
+    return true;
+}
diff --git a/pointer.h b/pointer.h
new file mode 100644
index 0000000..8ba172e
--- /dev/null
+++ b/pointer.h
@@ -0,0 +1,34 @@
+#ifndef POINTER_H
+#define POINTER_H
+
+#include <stdbool.h>
+
+/* Where the pointer is on the keyboard surface and whether its button is
+ * down, kept free of Wayland calls so the event sequences can be tested
+ * without a compositor.
+ *
+ * A stylus or touchscreen that drives wl_pointer makes the compositor jump the
+ * pointer onto the surface: a tap arrives as enter, button press, button
+ * release with no motion in between. The position therefore has to come from
+ * the enter event as well as from motion, or the first press after the
+ * pointer was elsewhere has no position and is dropped. */
+struct ptr {
+    int x, y;    /* surface coordinates, -1 while unknown */
+    bool pressed; /* the button is down */
+};
+
+void ptr_init(struct ptr *p);
+/* Each of these returns true when a button is held, that is when the caller
+ * has to let the key under the new position take over from the held one. */
+bool ptr_enter(struct ptr *p, int x, int y);
+bool ptr_motion(struct ptr *p, int x, int y);
+/* The pointer left the surface. A held button stays held: its release can
+ * still arrive. */
+void ptr_leave(struct ptr *p);
+void ptr_button(struct ptr *p, bool pressed);
+bool ptr_known(const struct ptr *p);
+/* The position a press lands on; false when none is known, in which case
+ * there is no key to look up. */
+bool ptr_target(const struct ptr *p, int *x, int *y);
+
+#endif
