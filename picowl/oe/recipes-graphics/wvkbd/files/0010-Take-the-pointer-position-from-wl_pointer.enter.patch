 meson.build          |   1 +
 pointer.c            |  50 ++++++++++++++++++++
 pointer.h            |  34 ++++++++++++++
 tests/meson.build    |   5 ++
 tests/test-pointer.c | 107 +++++++++++++++++++++++++++++++++++++++++++
 6 files changed, 223 insertions(+), 12 deletions(-)
 create mode 100644 pointer.c
 create mode 100644 pointer.h
