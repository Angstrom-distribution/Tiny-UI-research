diff --git a/main.c b/main.c
index 65e5d5f..3e138d9 100644
--- a/main.c
+++ b/main.c
@@ -19,6 +19,7 @@
 #include <wchar.h>
 
 #include "keyboard.h"
+#include "pointer.h"
 #include "prerender.h"
 #include "text.h"
 #include "visibility.h"
@@ -91,8 +92,7 @@ static uint32_t anchor = ZWLR_LAYER_SURFACE_V1_ANCHOR_BOTTOM |
 
 /* application state */
 static bool run_display = true;
-static int cur_x = -1, cur_y = -1;
-static bool cur_press = false;
+static struct ptr cur = {-1, -1, false};
 static struct kbd keyboard;
 static uint32_t height, normal_height, landscape_height;
 /* Set when the user gave the height, which a layout's own default never
@@ -360,13 +360,27 @@ wl_pointer_enter(void *data, struct wl_pointer *wl_pointer, uint32_t serial,
                  struct wl_surface *surface, wl_fixed_t surface_x,
                  wl_fixed_t surface_y)
 {
+    if (!input_ready()) {
+        return;
+    }
+
+    /* A stylus or touchscreen taps with no motion after the enter, so this is
+     * the only position the press that follows will get. */
+    if (ptr_enter(&cur, wl_fixed_to_int(surface_x),
+                  wl_fixed_to_int(surface_y))) {
+        /* enter carries no timestamp, so take the one a release of the held
+         * key would have had */
+        kbd_motion_key(&keyboard,
+                       (uint32_t) (monotime() + keyboard.last_press_offset),
+                       cur.x, cur.y);
+    }
 }
 
 void
 wl_pointer_leave(void *data, struct wl_pointer *wl_pointer, uint32_t serial,
                  struct wl_surface *surface)
 {
-    cur_x = cur_y = -1;
+    ptr_leave(&cur);
 }
 
 void
@@ -377,11 +391,9 @@ wl_pointer_motion(void *data, struct wl_pointer *wl_pointer, uint32_t time,
         return;
     }
 
-    cur_x = wl_fixed_to_int(surface_x);
-    cur_y = wl_fixed_to_int(surface_y);
-
-    if (cur_press) {
-        kbd_motion_key(&keyboard, time, cur_x, cur_y);
+    if (ptr_motion(&cur, wl_fixed_to_int(surface_x),
+                   wl_fixed_to_int(surface_y))) {
+        kbd_motion_key(&keyboard, time, cur.x, cur.y);
     }
 }
 
@@ -394,16 +406,18 @@ wl_pointer_button(void *data, struct wl_pointer *wl_pointer, uint32_t serial,
     }
 
     struct key *next_key;
-    cur_press = state == WL_POINTER_BUTTON_STATE_PRESSED;
+    bool pressed = state == WL_POINTER_BUTTON_STATE_PRESSED;
+    ptr_button(&cur, pressed);
 
-    if (cur_press) {
+    if (pressed) {
         kbd_unpress_key(&keyboard, time);
     } else {
         kbd_release_key(&keyboard, time);
     }
 
-    if (cur_press && cur_x >= 0 && cur_y >= 0) {
-        next_key = kbd_get_key(&keyboard, cur_x, cur_y);
+    int x, y;
+    if (pressed && ptr_target(&cur, &x, &y)) {
+        next_key = kbd_get_key(&keyboard, x, y);
         if (next_key) {
             kbd_press_key(&keyboard, next_key, time);
         } else if (keyboard.compose) {
