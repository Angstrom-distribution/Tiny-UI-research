+
+enum drw_format
+drw_pick_format(const struct drw *ctx, enum drw_format request)
+{
+    if (request == DRW_FORMAT_ARGB8888)
+        return DRW_FORMAT_ARGB8888;
+    if (request == DRW_FORMAT_RGB565 && !ctx->has_rgb565)
+        fprintf(stderr, "compositor does not advertise RGB565, falling back\n");
+    if (request == DRW_FORMAT_XRGB8888 && !ctx->has_xrgb8888)
+        fprintf(stderr, "compositor does not advertise XRGB8888, using ARGB8888\n");
+    if ((request == DRW_FORMAT_AUTO || request == DRW_FORMAT_RGB565) &&
+        ctx->has_rgb565)
+        return DRW_FORMAT_RGB565;
+    if (ctx->has_xrgb8888)
+        return DRW_FORMAT_XRGB8888;
+    /* every compositor must support ARGB8888 */
+    return DRW_FORMAT_ARGB8888;
+}
+
+bool
+drw_format_has_alpha(enum drw_format format)
+{
+    return format == DRW_FORMAT_ARGB8888;
+}
+
+static uint32_t
+drw_wl_format(enum drw_format format)
+{
+    switch (format) {
+    case DRW_FORMAT_RGB565: return WL_SHM_FORMAT_RGB565;
+    case DRW_FORMAT_XRGB8888: return WL_SHM_FORMAT_XRGB8888;
+    default: return WL_SHM_FORMAT_ARGB8888;
+    }
+}
+
+static cairo_format_t
+drw_cairo_format(enum drw_format format)
+{
+    switch (format) {
+    case DRW_FORMAT_RGB565: return CAIRO_FORMAT_RGB16_565;
+    case DRW_FORMAT_XRGB8888: return CAIRO_FORMAT_RGB24;
+    default: return CAIRO_FORMAT_ARGB32;
+    }
+}
+
+bool
+drw_buffer_geometry(enum drw_format format, uint32_t width, uint32_t height,
+                    uint32_t *stride, uint32_t *size)
+{
+    uint64_t bytes_per_pixel = format == DRW_FORMAT_RGB565 ? 2 : 4;
+    /* cairo wants rows padded to 4 bytes */
+    uint64_t row = (width * bytes_per_pixel + 3) & ~(uint64_t)3;
+    uint64_t total = row * height; /* both < 2^35, cannot wrap in 64 bits */
+
+    if (width == 0 || height == 0 || row > INT32_MAX || total > INT32_MAX)
+        return false;
+    *stride = row;
+    *size = total;
+    return true;
+}
+
+/* Surfaces without alpha would otherwise composite a translucent colour
+ * against black, so colours are made opaque for them. */
+static void
+drw_set_color(cairo_t *cr, enum drw_format format, Color color)
