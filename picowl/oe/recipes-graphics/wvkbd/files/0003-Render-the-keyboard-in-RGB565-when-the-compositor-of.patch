new file mode 100644
index 0000000..e107a73
--- /dev/null
+++ b/tests/test-draw.c
@@ -0,0 +1,223 @@
+/* Renders a keyboard layer into plain memory through the same drawing code
+ * the compositor path uses, once per pixel format, and checks pixel values. */
+#include <cairo.h>
+#include <linux/input-event-codes.h>
+#include <stdio.h>
+#include <string.h>
+
+#include "keyboard.h"
+
+static int failures;
+
+#define CHECK(cond, ...)                                                       \
+    do {                                                                       \
+        if (!(cond)) {                                                         \
+            fprintf(stderr, "FAIL %s:%d: ", __FILE__, __LINE__);               \
+            fprintf(stderr, __VA_ARGS__);                                      \
+            fputc('\n', stderr);                                               \
+            failures++;                                                        \
+        }                                                                      \
+    } while (0)
+
+static const char *format_name[] = {"auto", "rgb565", "xrgb8888", "argb8888"};
+
+/* What a stored pixel looks like for an opaque colour. The 565 truncation is
+ * what pixman does when it narrows 8-bit channels. */
+static uint32_t
+expected_pixel(enum drw_format f, Color c)
+{
+    uint32_t r = c.bgra[2], g = c.bgra[1], b = c.bgra[0];
+    if (f == DRW_FORMAT_RGB565)
+        return ((r >> 3) << 11) | ((g >> 2) << 5) | (b >> 3);
+    if (f == DRW_FORMAT_XRGB8888)
+        return (r << 16) | (g << 8) | b;
+    return 0xff000000u | (r << 16) | (g << 8) | b;
+}
+
+static uint32_t
+read_pixel(struct drwsurf *ds, uint32_t x, uint32_t y)
+{
+    uint32_t stride, size;
+    drw_buffer_geometry(ds->format, ds->width, ds->height, &stride, &size);
+    struct drwbuf *b = ds->back_buffer;
+    cairo_surface_flush(b->cairo_surf);
+    const unsigned char *p = b->pool_data + (size_t)y * stride;
+    uint32_t v;
+    if (ds->format == DRW_FORMAT_RGB565) {
+        uint16_t v16;
+        memcpy(&v16, p + x * 2, 2);
+        return v16;
+    }
+    memcpy(&v, p + x * 4, 4);
+    return ds->format == DRW_FORMAT_XRGB8888 ? v & 0xffffff : v;
+}
+
+static void
+test_geometry(void)
+{
+    uint32_t stride, size;
+
+    CHECK(drw_buffer_geometry(DRW_FORMAT_RGB565, 240, 100, &stride, &size) &&
+              stride == 480 && size == 48000,
+          "240x100 rgb565 is 480 bytes per row");
+    /* odd widths: 2 bytes per pixel must be padded to 4 */
+    CHECK(drw_buffer_geometry(DRW_FORMAT_RGB565, 241, 2, &stride, &size) &&
+              stride == 484 && size == 968,
+          "241 wide rgb565 rows are padded to 4 bytes");
+    CHECK(drw_buffer_geometry(DRW_FORMAT_ARGB8888, 240, 100, &stride, &size) &&
+              stride == 960 && size == 96000,
+          "240x100 argb8888 is 960 bytes per row");
+
+    for (int f = DRW_FORMAT_RGB565; f <= DRW_FORMAT_ARGB8888; f++) {
+        cairo_format_t cf = f == DRW_FORMAT_RGB565    ? CAIRO_FORMAT_RGB16_565
+                            : f == DRW_FORMAT_XRGB8888 ? CAIRO_FORMAT_RGB24
+                                                       : CAIRO_FORMAT_ARGB32;
+        for (uint32_t w = 1; w < 70; w++) {
+            CHECK(drw_buffer_geometry(f, w, 1, &stride, &size) &&
+                      (int)stride == cairo_format_stride_for_width(cf, w),
+                  "%s stride for width %u matches cairo", format_name[f], w);
+        }
+    }
+
+    CHECK(!drw_buffer_geometry(DRW_FORMAT_ARGB8888, 0, 10, &stride, &size),
+          "zero width is rejected");
+    CHECK(!drw_buffer_geometry(DRW_FORMAT_ARGB8888, UINT32_MAX, 1, &stride, &size),
+          "a width whose stride overflows int32 is rejected");
+    CHECK(!drw_buffer_geometry(DRW_FORMAT_ARGB8888, 40000, 40000, &stride, &size),
+          "a size beyond int32 is rejected");
+    CHECK(!drw_buffer_geometry(DRW_FORMAT_RGB565, 1, UINT32_MAX, &stride, &size),
+          "a huge height is rejected");
+}
+
+static void
+test_pick(void)
+{
+    enum drw_format f;
+    struct drw none = {0}, x = {.has_xrgb8888 = true},
+               both = {.has_rgb565 = true, .has_xrgb8888 = true};
+
+    CHECK(drw_parse_format("rgb565", &f) && f == DRW_FORMAT_RGB565, "parse");
+    CHECK(!drw_parse_format("rgb888", &f), "unknown format name is rejected");
+
+    CHECK(drw_pick_format(&both, DRW_FORMAT_AUTO) == DRW_FORMAT_RGB565,
+          "auto prefers rgb565");
+    CHECK(drw_pick_format(&x, DRW_FORMAT_AUTO) == DRW_FORMAT_XRGB8888,
+          "auto without rgb565 uses xrgb8888");
+    CHECK(drw_pick_format(&none, DRW_FORMAT_AUTO) == DRW_FORMAT_ARGB8888,
+          "auto with nothing advertised uses argb8888");
+    CHECK(drw_pick_format(&x, DRW_FORMAT_RGB565) == DRW_FORMAT_XRGB8888,
+          "requested rgb565 falls back to xrgb8888");
+    CHECK(drw_pick_format(&both, DRW_FORMAT_ARGB8888) == DRW_FORMAT_ARGB8888,
+          "an explicit request for argb8888 is honoured");
+    CHECK(drw_pick_format(&both, DRW_FORMAT_XRGB8888) == DRW_FORMAT_XRGB8888,
+          "an explicit request for xrgb8888 is honoured");
+
+    struct drw ctx = {0};
+    drw_note_shm_format(&ctx, 0x36314752); /* WL_SHM_FORMAT_RGB565 */
+    drw_note_shm_format(&ctx, 1);          /* XRGB8888 */
+    drw_note_shm_format(&ctx, 0x34325258); /* some other format */
+    CHECK(ctx.has_rgb565 && ctx.has_xrgb8888, "shm format events are recorded");
+}
+
+static void
+test_render(enum drw_format format, int corner_radius)
+{
+    const char *fn = format_name[format];
+    bool alpha = drw_format_has_alpha(format);
+    /* The baseplate alpha is below 255 to prove opaque formats ignore it. */
+    struct clr_scheme schemes[2] = {0};
+    for (int i = 0; i < 2; i++) {
+        schemes[i].bg = (Color){.bgra = {0x30, 0x20, 0x10, alpha ? 255 : 0x80}};
+        schemes[i].fg = (Color){.bgra = {0x20, 0x90, 0xe0, 255}};
+        schemes[i].high = (Color){.bgra = {0xf0, 0x40, 0x60, 255}};
+        schemes[i].text = (Color){.color = UINT32_MAX};
+        schemes[i].text_press = (Color){.color = UINT32_MAX};
+        schemes[i].rounding = 5;
+        schemes[i].font_description =
+            pango_font_description_from_string("Sans 14");
+    }
+
+    struct drw ctx = {0}; /* no wl_shm: draw into plain memory */
+    struct drwbuf back = {0}, display = {0};
+    struct drwsurf ds = {.ctx = &ctx, .format = format,
+                         .back_buffer = &back, .display_buffer = &display};
+    drwsurf_resize(&ds, 240, 100, 1.0);
+    CHECK(back.cairo_surf &&
+              cairo_surface_status(back.cairo_surf) == CAIRO_STATUS_SUCCESS,
+          "%s: cairo surface created", fn);
+
+    struct layout *l = &layouts[0];
+    kbd_init_layout(l, 240, 100);
+    struct kbd kb = {.surf = &ds, .schemes = schemes, .layout = l,
+                     .w = 240, .h = 100, .scale = 1.0,
+                     .corner_radius = corner_radius, .show_highlight = true};
+    kbd_draw_layout(&kb);
+
+    struct key *k = l->keys;
+    while (k->type == Pad || k->type == EndRow)
+        k++;
+    uint32_t px = k->x + KBD_KEY_BORDER + 5, py = k->y + KBD_KEY_BORDER + 5;
+
+    uint32_t got = read_pixel(&ds, px, py);
+    CHECK(got == expected_pixel(format, schemes[k->scheme].fg),
+          "%s: key background is %08x, want %08x", fn, got,
+          expected_pixel(format, schemes[k->scheme].fg));
+
+    /* between two keys nothing is drawn, so the baseplate shows */
+    Color bg = schemes[0].bg;
+    bg.bgra[3] = 255;
+    got = read_pixel(&ds, k->x, k->y + k->h / 2);
+    CHECK(got == expected_pixel(format, bg),
+          "%s: baseplate between keys is %08x, want %08x", fn, got,
+          expected_pixel(format, bg));
+
+    got = read_pixel(&ds, 0, 0);
+    if (corner_radius > 0 && alpha)
+        CHECK(got == 0, "%s: rounded corner is transparent, got %08x", fn, got);
+    else
+        CHECK(got == expected_pixel(format, bg),
+              "%s: corner is baseplate, got %08x", fn, got);
+
+    /* the label must put at least one pixel of another colour on the key */
+    PangoFontMap *fm = pango_cairo_font_map_get_default();
+    PangoFontFamily **fam;
+    int nfam;
+    pango_font_map_list_families(fm, &fam, &nfam);
+    g_free(fam);
+    if (nfam > 0) {
+        uint32_t keyclr = expected_pixel(format, schemes[k->scheme].fg);
+        int differing = 0;
+        for (uint32_t y = k->y + KBD_KEY_BORDER + 1;
+             y < k->y + k->h - KBD_KEY_BORDER - 1; y++)
+            for (uint32_t x = k->x + KBD_KEY_BORDER + 1;
+                 x < k->x + k->w - KBD_KEY_BORDER - 1; x++)
+                differing += read_pixel(&ds, x, y) != keyclr;
+        CHECK(differing > 0, "%s: label %s drew nothing", fn, k->label);
+    } else {
+        fprintf(stderr, "no fonts installed, skipping the label check\n");
+    }
+
+    kbd_draw_key(&kb, k, Press);
+    got = read_pixel(&ds, px, py);
+    CHECK(got == expected_pixel(format, schemes[k->scheme].high),
+          "%s: highlight is %08x, want %08x", fn, got,
+          expected_pixel(format, schemes[k->scheme].high));
+    /* the neighbouring baseplate must not change */
+    got = read_pixel(&ds, k->x, k->y + k->h / 2);
+    CHECK(got == expected_pixel(format, bg),
+          "%s: baseplate after highlight is %08x", fn, got);
+}
+
+int
+main(void)
+{
+    test_geometry();
+    test_pick();
+    for (int f = DRW_FORMAT_RGB565; f <= DRW_FORMAT_ARGB8888; f++) {
+        test_render(f, 0);
+        test_render(f, 8);
+    }
+    if (failures)
+        fprintf(stderr, "%d failure(s)\n", failures);
+    return failures ? 1 : 0;
+}
