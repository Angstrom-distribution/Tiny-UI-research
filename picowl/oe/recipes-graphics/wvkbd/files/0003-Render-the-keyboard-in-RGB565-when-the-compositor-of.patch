+        {"auto", DRW_FORMAT_AUTO},
+        {"rgb565", DRW_FORMAT_RGB565},
+        {"xrgb8888", DRW_FORMAT_XRGB8888},
+        {"argb8888", DRW_FORMAT_ARGB8888},
+    };
+    for (size_t i = 0; i < sizeof(known) / sizeof(known[0]); i++) {
