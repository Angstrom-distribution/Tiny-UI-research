index 3ca6390a..4748ddc0 100644
--- a/include/wlr/backend/drm.h
+++ b/include/wlr/backend/drm.h
@@ -100,4 +100,51 @@ const drmModeModeInfo *wlr_drm_mode_get_info(struct wlr_output_mode *mode);
 enum wl_output_transform wlr_drm_connector_get_panel_orientation(
 	struct wlr_output *output);
 
+/**
+ * Check whether the primary plane of a CRTC this connector can use supports
+ * the DRM "rotation" values needed for the transform. Only atomic modesetting
+ * is supported. No CRTC is allocated by this function.
+ */
+bool wlr_drm_connector_supports_hw_rotation(struct wlr_output *output,
+	enum wl_output_transform transform);
+
+/**
+ * Let the primary plane rotate the framebuffer in hardware.
+ *
+ * Contract: call this while the output is disabled (returns false
+ * otherwise), then commit a state which enables the output and sets a mode
+ * with wlr_output_state_set_mode(). For 90/270 degree transforms (and their
+ * flipped variants) the sizes of the connector's wlr_output_modes are
+ * swapped: a 240x320 panel exposes a 320x240 mode, and framebuffers are
+ * 320x240. The output's own transform should stay
+ * WL_OUTPUT_TRANSFORM_NORMAL, the rotation is done by the display hardware.
+ *
+ * Until that commit, output->current_mode is NULL and output->width, height
+ * and refresh are 0, so the commit is not skipped as unchanged and sends the
+ * new mode to clients. The driver may still reject the rotation in the
+ * commit: check the output size afterwards and fall back to software
+ * rotation (WL_OUTPUT_TRANSFORM_NORMAL here) if needed. While a rotation
+ * other than 0 is set, hardware cursors are refused.
+ *
+ * Returns false if unsupported (see wlr_drm_connector_supports_hw_rotation).
+ */
+bool wlr_drm_connector_set_hw_rotation(struct wlr_output *output,
+	enum wl_output_transform transform);
+
+/**
+ * Mark the connector as driven by a copy-type driver: one which copies the
+ * damaged framebuffer contents to device memory during the commit (shadow
+ * plane drivers, FB_DAMAGE_CLIPS). The scanned-out framebuffer is then
+ * released after each page-flip, so the swapchain can reuse it at once
+ * (buffer age 1). Commits without a new buffer leave the primary plane
+ * untouched; modesets and enabling the output still require a buffer.
+ *
+ * Only atomic modesetting is supported, this is a no-op otherwise.
+ *
+ * Requires a kernel with DRM_IOCTL_MODE_CLOSEFB (6.9+): on older kernels
+ * destroying an fb falls back to drmModeRmFB, which disables the plane
+ * scanning it out. Do not use this there.
+ */
+void wlr_drm_connector_set_copy_type(struct wlr_output *output, bool copy_type);
+
 #endif
