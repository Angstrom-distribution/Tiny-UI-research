+		return false;
+	}
 
 	struct wlr_box box = { .x = x, .y = y };
 
@@ -1222,6 +1297,12 @@ static void drm_connector_destroy_output(struct wlr_output *output) {
 	}
 
 	conn->output = (struct wlr_output){0};
+
+	// The next output on this connector starts unrotated, the compositor opts
+	// in again
+	conn->hw_rotation = 0;
+	conn->hw_swap = false;
+	conn->copy_type = false;
 }
 
