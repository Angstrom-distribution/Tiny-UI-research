+// Sets the wlr_output_mode size, swapped for 90/270 degree hardware rotation
+static void drm_mode_apply_rotation(struct wlr_drm_connector *conn,
+		struct wlr_drm_mode *mode) {
+	if (conn->hw_swap) {
+		mode->wlr_mode.width = mode->drm_mode.vdisplay;
+		mode->wlr_mode.height = mode->drm_mode.hdisplay;
+	} else {
+		mode->wlr_mode.width = mode->drm_mode.hdisplay;
+		mode->wlr_mode.height = mode->drm_mode.vdisplay;
+	}
+}
+
