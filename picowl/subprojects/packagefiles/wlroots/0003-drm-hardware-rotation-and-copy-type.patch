+/*
+ * wl_output_transform to DRM plane "rotation" bits. Both rotate counter-
+ * clockwise, and Wayland flips around the vertical axis before rotating.
+ * Hardware testing may show that the 90 and 270 rows (and their flipped
+ * variants) need to be swapped for a given driver.
+ */
+static const uint32_t hw_rotation_bits[] = {
+	[WL_OUTPUT_TRANSFORM_NORMAL] = DRM_MODE_ROTATE_0,
+	[WL_OUTPUT_TRANSFORM_90] = DRM_MODE_ROTATE_90,
+	[WL_OUTPUT_TRANSFORM_180] = DRM_MODE_ROTATE_180,
+	[WL_OUTPUT_TRANSFORM_270] = DRM_MODE_ROTATE_270,
+	[WL_OUTPUT_TRANSFORM_FLIPPED] = DRM_MODE_REFLECT_X | DRM_MODE_ROTATE_0,
+	[WL_OUTPUT_TRANSFORM_FLIPPED_90] = DRM_MODE_REFLECT_X | DRM_MODE_ROTATE_90,
+	[WL_OUTPUT_TRANSFORM_FLIPPED_180] = DRM_MODE_REFLECT_X | DRM_MODE_ROTATE_180,
+	[WL_OUTPUT_TRANSFORM_FLIPPED_270] = DRM_MODE_REFLECT_X | DRM_MODE_ROTATE_270,
+};
+
+static bool plane_supports_rotation(const struct wlr_drm_plane *plane,
+		uint32_t bits) {
+	return plane != NULL && plane->props.rotation != 0 &&
+		(plane->rotation_mask & bits) == bits;
+}
+
+static bool connector_supports_rotation(struct wlr_drm_connector *conn,
+		uint32_t bits) {
+	struct wlr_drm_backend *drm = conn->backend;
+	if (drm->iface != &atomic_iface) {
+		return false;
+	}
+	if (conn->crtc != NULL) {
+		return plane_supports_rotation(conn->crtc->primary, bits);
+	}
+	// Don't allocate a CRTC, check all the ones the connector could use
+	for (size_t i = 0; i < drm->num_crtcs; i++) {
+		if ((conn->possible_crtcs & (UINT32_C(1) << i)) == 0) {
+			continue;
+		}
+		if (plane_supports_rotation(drm->crtcs[i].primary, bits)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+bool wlr_drm_connector_supports_hw_rotation(struct wlr_output *output,
+		enum wl_output_transform transform) {
+	struct wlr_drm_connector *conn = get_drm_connector_from_output(output);
+	if ((size_t)transform >= sizeof(hw_rotation_bits) / sizeof(hw_rotation_bits[0])) {
+		return false;
+	}
+	return connector_supports_rotation(conn, hw_rotation_bits[transform]);
+}
+
+bool wlr_drm_connector_set_hw_rotation(struct wlr_output *output,
+		enum wl_output_transform transform) {
+	struct wlr_drm_connector *conn = get_drm_connector_from_output(output);
+	if (output->enabled) {
+		wlr_drm_conn_log(conn, WLR_ERROR,
+			"Hardware rotation can only be changed while the output is disabled");
+		return false;
+	}
+	if (!wlr_drm_connector_supports_hw_rotation(output, transform)) {
+		wlr_drm_conn_log(conn, WLR_DEBUG,
+			"Hardware rotation for transform %d not supported", (int)transform);
+		return false;
+	}
+
+	conn->hw_rotation = hw_rotation_bits[transform];
+	conn->hw_swap = transform % 2 == 1; // 90, 270 and their flipped variants
+
+	struct wlr_output_mode *wlr_mode;
+	wl_list_for_each(wlr_mode, &output->modes, link) {
+		struct wlr_drm_mode *mode = wl_container_of(wlr_mode, mode, wlr_mode);
+		drm_mode_apply_rotation(conn, mode);
+	}
+
+	// The backend owns these while the output is disabled. Clearing them
+	// makes sure the next commit with wlr_output_state_set_mode() isn't
+	// stripped as unchanged, and updates the size and the swapchain.
+	output->current_mode = NULL;
+	output->width = 0;
+	output->height = 0;
+	output->refresh = 0;
+
+	wlr_drm_conn_log(conn, WLR_INFO, "Hardware rotation 0x%"PRIx32"%s",
+		conn->hw_rotation, conn->hw_swap ? " (width/height swapped)" : "");
+	return true;
+}
+
+void wlr_drm_connector_set_copy_type(struct wlr_output *output, bool copy_type) {
+	struct wlr_drm_connector *conn = get_drm_connector_from_output(output);
+	if (conn->backend->iface != &atomic_iface) {
+		wlr_drm_conn_log(conn, WLR_DEBUG,
+			"Copy-type mode requires atomic modesetting, ignoring");
+		return;
+	}
+	conn->copy_type = copy_type;
+}
+
 enum wl_output_transform wlr_drm_connector_get_panel_orientation(
 		struct wlr_output *output) {
 	struct wlr_drm_connector *conn = get_drm_connector_from_output(output);
@@ -1622,6 +1802,7 @@ static bool connect_drm_connector(struct wlr_drm_connector *wlr_conn,
 			wlr_output_state_finish(&state);
 			return false;
 		}
+		drm_mode_apply_rotation(wlr_conn, mode);
 
 		// If this is the current mode set on the conn's crtc,
 		// then set it as the conn's output current mode.
@@ -2000,6 +2181,11 @@ static void handle_page_flip(int fd, unsigned seq,
 	if (plane->queued_fb) {
 		drm_fb_move(&plane->current_fb, &plane->queued_fb);
 	}
+	if (conn->copy_type) {
+		// The kernel copied the contents during the commit: release the
+		// buffer so the swapchain can reuse it right away
+		drm_fb_clear(&plane->current_fb);
+	}
 	if (conn->crtc->cursor && conn->crtc->cursor->queued_fb) {
 		drm_fb_move(&conn->crtc->cursor->current_fb,
 			&conn->crtc->cursor->queued_fb);
