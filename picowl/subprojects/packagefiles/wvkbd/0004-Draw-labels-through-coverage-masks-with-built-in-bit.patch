+#ifndef TEXT_H
+#define TEXT_H
+
+#include "mask.h"
+
+/* Label text, drawn through label masks. The backend is chosen at build time
+ * (meson option "text"): text-bitmap.c or text-pango.c. */
+struct text_font;
+
+/* Never returns NULL. The bitmap backend has no use for the description and
+ * picks its font by key height. */
+struct text_font *text_font_new(const char *description);
+void text_font_free(struct text_font *font);
+
+/* Draws the label centred in the box (x, y, w, h), all in buffer pixels, and
+ * clipped to the box shrunk by border. scale is the surface scale, for
+ * backends whose font size is not fixed in pixels. */
+void text_draw(struct text_font *font, const char *label,
+               const struct mask_target *target, int x, int y, int w, int h,
+               int border, double scale, Color color);
+
+#endif
diff --git a/tools/bdf2c.py b/tools/bdf2c.py
new file mode 100755
index 0000000..f93670a
--- /dev/null
+++ b/tools/bdf2c.py
@@ -0,0 +1,158 @@
+#!/usr/bin/env python3
+"""Turn X11 BDF fonts into the C table used by the bitmap text backend.
+
+usage: bdf2c.py -o OUT.c --layout layout.X.h ... NAME=FILE.bdf ...
+
+The table holds ASCII, ISO 8859-1 and every other code point that a layout
+header uses and the font has. Anything else is left out on purpose: the
+backend draws a box for it and logs it, which is more honest than shipping
+2000 glyphs that no key can ever show.
+"""
+import argparse
+import hashlib
+import re
+import sys
+
+LICENSE_NEEDLE = "public domain"
+
+
+def parse_bdf(path):
+    with open(path, "rb") as f:
+        raw = f.read()
+    text = raw.decode("latin-1")
+    font = {"sha256": hashlib.sha256(raw).hexdigest(), "glyphs": {}}
+    glyph = None
+    in_bitmap = False
+    for line in text.splitlines():
+        word, _, rest = line.partition(" ")
+        if in_bitmap:
+            if word == "ENDCHAR":
+                in_bitmap = False
+                if glyph["enc"] >= 0:
+                    font["glyphs"][glyph["enc"]] = glyph
+            else:
+                glyph["rows"].append(word)
+            continue
+        if word in ("FONT_ASCENT", "FONT_DESCENT"):
+            font[word] = int(rest)
+        elif word == "COPYRIGHT":
+            font["copyright"] = rest.strip().strip('"')
+        elif word == "FONT":
+            font["xlfd"] = rest
+        elif word == "FONTBOUNDINGBOX":
+            font["bbox"] = [int(v) for v in rest.split()]
+        elif word == "STARTCHAR":
+            glyph = {"rows": [], "enc": -1}
+        elif word == "ENCODING":
+            glyph["enc"] = int(rest.split()[0])
+        elif word == "DWIDTH":
+            glyph["adv"] = int(rest.split()[0])
+        elif word == "BBX":
+            glyph["w"], glyph["h"], glyph["xoff"], glyph["yoff"] = (
+                int(v) for v in rest.split())
+        elif word == "BITMAP":
+            in_bitmap = True
+    return font
+
+
+def layout_codepoints(paths):
+    cps = set()
+    # Labels are the first two string literals of every key initialiser.
+    pat = re.compile(r'\{\s*"((?:[^"\\]|\\.)*)"\s*,\s*"((?:[^"\\]|\\.)*)"')
+    for p in paths:
+        with open(p, encoding="utf-8") as f:
+            for m in pat.finditer(f.read()):
+                for lab in m.groups():
+                    cps.update(ord(c) for c in lab)
+    return cps
+
+
+def pack(glyph):
+    """Crop to the ink, return (w, h, xoff, yoff, bytes) with rows padded to
+    4 bytes, MSB first."""
+    w, h = glyph["w"], glyph["h"]
+    bits = []
+    for hexrow in glyph["rows"]:
+        full = len(hexrow) * 4
+        bits.append([(int(hexrow, 16) >> (full - 1 - x)) & 1 for x in range(w)])
+    ink_rows = [y for y, row in enumerate(bits) if any(row)]
+    if not ink_rows:
+        return 0, 0, 0, 0, b""
+    ink_cols = [x for x in range(w) if any(row[x] for row in bits)]
+    y0, y1, x0, x1 = ink_rows[0], ink_rows[-1], ink_cols[0], ink_cols[-1]
+    cw, ch = x1 - x0 + 1, y1 - y0 + 1
+    assert cw <= 32
+    out = bytearray()
+    for y in range(y0, y1 + 1):
+        v = 0
+        for x in range(x0, x1 + 1):
+            v = (v << 1) | bits[y][x]
+        v <<= 32 - cw
+        out += v.to_bytes(4, "big")
+    xoff = glyph["xoff"] + x0
+    # BDF yoff is the bottom row's offset above the baseline.
+    yoff = glyph["yoff"] + (h - 1 - y1)
+    return cw, ch, xoff, yoff, bytes(out)
+
+
+def emit_font(out, name, font, wanted):
+    if LICENSE_NEEDLE not in font.get("copyright", "").lower():
+        sys.exit("%s: COPYRIGHT is %r, not public domain" %
+                 (name, font.get("copyright")))
+    cps = sorted(c for c in wanted if c in font["glyphs"])
+    data = bytearray()
+    recs = []
+    for cp in cps:
+        g = font["glyphs"][cp]
+        w, h, xoff, yoff, bits = pack(g)
+        off = len(data)
+        data += bits
+        assert -128 <= xoff < 128 and -128 <= -(yoff + h) < 128
+        recs.append((cp, off, g["adv"], w, h, xoff, -(yoff + h)))
+    ident = "bmfont_" + name
+    out.write("/* %s\n * source sha256 %s\n * copyright field: %s\n */\n" %
+              (font["xlfd"], font["sha256"], font["copyright"]))
+    out.write("static const uint8_t %s_bits[] = {\n" % ident)
+    for i in range(0, len(data), 16):
+        out.write("\t" + ",".join("0x%02x" % b for b in data[i:i + 16]) + ",\n")
+    if not data:
+        out.write("\t0\n")
+    out.write("};\n\nstatic const struct bmglyph %s_glyphs[] = {\n" % ident)
+    for r in recs:
+        out.write("\t{0x%04x, %d, %d, %d, %d, %d, %d},\n" % r)
+    out.write("};\n\nconst struct bmfont %s = {\n" % ident)
+    bb = font["bbox"]
+    out.write("\t.name = \"%s\", .cell_w = %d, .cell_h = %d, .ascent = %d,\n" %
+              (name, bb[0], bb[1], font["FONT_ASCENT"]))
+    out.write("\t.glyphs = %s_glyphs, .nglyphs = %d, .bits = %s_bits,\n};\n\n" %
+              (ident, len(recs), ident))
+    return len(recs), len(data)
+
+
+def main():
+    ap = argparse.ArgumentParser()
+    ap.add_argument("-o", required=True)
+    ap.add_argument("--layout", action="append", default=[])
+    ap.add_argument("fonts", nargs="+", help="NAME=FILE.bdf, largest first")
+    args = ap.parse_args()
+
+    wanted = set(range(0x20, 0x7f)) | set(range(0xa0, 0x100))
+    wanted |= layout_codepoints(args.layout)
+
+    with open(args.o, "w", encoding="utf-8") as out:
+        out.write("/* Generated by tools/bdf2c.py from the X.Org misc-fixed BDF "
+                  "files. Do not edit;\n * rerun tools/regen-fonts.sh. */\n"
+                  "#include \"bmfont.h\"\n\n")
+        names = []
+        for spec in args.fonts:
+            name, _, path = spec.partition("=")
+            n, size = emit_font(out, name, parse_bdf(path), wanted)
+            print("%s: %d glyphs, %d bytes of masks" % (name, n, size),
+                  file=sys.stderr)
+            names.append("&bmfont_" + name)
+        out.write("const struct bmfont *const bmfonts[] = {%s};\n"
+                  "const unsigned nbmfonts = %d;\n" % (", ".join(names),
+                                                        len(names)))
+
+
+main()
