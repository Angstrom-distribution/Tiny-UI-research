+{
+    enum { GUARD = 4096, SW = 48, SH = 32 };
+    const char *fn = format_name[format];
+    struct drw ctx = {0};
+    struct drwbuf back = {0}, display = {0};
+    struct drwsurf ds = {.ctx = &ctx, .format = format,
+                         .back_buffer = &back, .display_buffer = &display};
+    drwsurf_resize(&ds, SW, SH, 1.0);
+
+    uint32_t stride, size;
+    drw_buffer_geometry(format, SW, SH, &stride, &size);
+    unsigned char *mem = malloc(size + 2 * GUARD);
+    memset(mem, 0xa5, size + 2 * GUARD);
+    memset(mem + GUARD, 0, size);
+    for (int i = 0; i < 2; i++) {
+        struct drwbuf *b = i ? &display : &back;
+        cairo_surface_destroy(b->cairo_surf);
+        b->pool_data = mem + GUARD;
+        b->cairo_surf = cairo_image_surface_create_for_data(
+            mem + GUARD,
+            format == DRW_FORMAT_RGB565    ? CAIRO_FORMAT_RGB16_565
+            : format == DRW_FORMAT_XRGB8888 ? CAIRO_FORMAT_RGB24
+                                            : CAIRO_FORMAT_ARGB32,
+            SW, SH, stride);
+    }
+    /* what a failed resize to a larger size leaves behind */
+    ds.width = 240;
+    ds.height = 100;
+
+    struct text_font *font = text_font_new("Sans 14");
+    Color white = {.color = UINT32_MAX};
+    drw_draw_text(&ds, white, 0, 0, SW, SH, 1, "Wq", font);
+    drw_draw_text(&ds, white, 100, 60, 100, 40, 1, "Wq", font);
+
+    int bad = 0;
+    for (int i = 0; i < GUARD; i++) {
+        bad += mem[i] != 0xa5;
+        bad += mem[GUARD + size + i] != 0xa5;
+    }
+    CHECK(bad == 0, "%s: %d guard bytes around the old buffer were written",
+          fn, bad);
+
+    /* a surface without memory is skipped */
+    cairo_surface_destroy(ds.back_buffer->cairo_surf);
+    ds.back_buffer->cairo_surf = NULL;
+    drw_draw_text(&ds, white, 0, 0, SW, SH, 1, "Wq", font);
+    text_font_free(font);
+    free(mem);
