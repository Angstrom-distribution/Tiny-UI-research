diff --git a/mask.c b/mask.c
new file mode 100644
index 0000000..8850854
--- /dev/null
+++ b/mask.c
@@ -0,0 +1,127 @@
+#include <string.h>
+
+#include "mask.h"
+
+size_t
+mask_stride(unsigned depth, unsigned w)
+{
+    return (((size_t)w * depth + 7) / 8 + 3) & ~(size_t)3;
+}
+
+/* Blend weights run 0..256 rather than 0..255 so that full coverage is an
+ * exact copy of the colour and the blend is a multiply and a shift, with no
+ * division per pixel (the iPAQ's CPU has no FPU and a slow divider). */
+struct alpha_lut {
+    unsigned depth, alpha;
+    uint16_t w[256];
+};
+
+static const struct alpha_lut *
+alpha_lut(unsigned depth, unsigned alpha)
+{
+    /* Labels are drawn in runs of one colour, so one cached table is enough
+     * and the divisions below happen once per run, not per pixel. */
+    static struct alpha_lut lut;
+    if (lut.depth == depth && lut.alpha == alpha)
+        return &lut;
+
+    unsigned levels = 1u << depth;
+    for (unsigned i = 0; i < levels; i++) {
+        unsigned cov = depth == 1 ? (i ? 255 : 0)
+                       : depth == 4 ? i * 17 : i;
+        if (alpha == 255)
+            lut.w[i] = cov + (cov >> 7);
+        else
+            lut.w[i] = (cov * alpha * 256 + 32512) / 65025;
+    }
+    lut.depth = depth;
+    lut.alpha = alpha;
+    return &lut;
+}
+
+static inline unsigned
+mix(unsigned dst, unsigned src, unsigned w)
+{
+    return (dst * (256 - w) + src * w) >> 8;
+}
+
+static inline unsigned
+coverage_index(const uint8_t *row, unsigned depth, unsigned x)
+{
+    switch (depth) {
+    case 1: return (row[x >> 3] >> (7 - (x & 7))) & 1;
+    case 4: return (row[x >> 1] >> ((x & 1) ? 0 : 4)) & 15;
+    default: return row[x];
+    }
+}
+
+void
+mask_blit(const struct mask_target *t, const struct label_mask *m, int x,
+          int y, Color color)
+{
+    if (!m->data || (m->depth != 1 && m->depth != 4 && m->depth != 8))
+        return;
+
+    int left = x + m->bx, top = y + m->by;
+    int x0 = left, y0 = top, x1 = left + m->w, y1 = top + m->h;
+    if (x0 < t->clip_x0) x0 = t->clip_x0;
+    if (y0 < t->clip_y0) y0 = t->clip_y0;
+    if (x1 > t->clip_x1) x1 = t->clip_x1;
+    if (y1 > t->clip_y1) y1 = t->clip_y1;
+    if (x0 < 0) x0 = 0;
+    if (y0 < 0) y0 = 0;
+    if (x1 > (int)t->width) x1 = t->width;
+    if (y1 > (int)t->height) y1 = t->height;
+    if (x0 >= x1 || y0 >= y1)
+        return;
+
+    unsigned r = color.bgra[2], g = color.bgra[1], b = color.bgra[0];
+    unsigned alpha = t->format == DRW_FORMAT_ARGB8888 ? color.bgra[3] : 255;
+    const struct alpha_lut *lut = alpha_lut(m->depth, alpha);
+    size_t mstride = mask_stride(m->depth, m->w);
+
+    for (int py = y0; py < y1; py++) {
+        const uint8_t *src = m->data + (size_t)(py - top) * mstride;
+        uint8_t *dst = t->data + (size_t)py * t->stride;
+
+        if (t->format == DRW_FORMAT_RGB565) {
+            unsigned sr = r >> 3, sg = g >> 2, sb = b >> 3;
+            for (int px = x0; px < x1; px++) {
+                unsigned w = lut->w[coverage_index(src, m->depth, px - left)];
+                if (!w)
+                    continue;
+                uint16_t v = ((sr << 11) | (sg << 5) | sb);
+                if (w != 256) {
+                    uint16_t d;
+                    memcpy(&d, dst + (size_t)px * 2, 2);
+                    v = (mix(d >> 11, sr, w) << 11) |
+                        (mix((d >> 5) & 63, sg, w) << 5) |
+                        mix(d & 31, sb, w);
+                }
+                memcpy(dst + (size_t)px * 2, &v, 2);
+            }
+        } else {
+            for (int px = x0; px < x1; px++) {
+                unsigned w = lut->w[coverage_index(src, m->depth, px - left)];
+                if (!w)
+                    continue;
+                uint32_t d;
+                memcpy(&d, dst + (size_t)px * 4, 4);
+                uint32_t v;
+                if (w == 256) {
+                    v = (r << 16) | (g << 8) | b;
+                    /* w includes the colour's alpha, so 256 means opaque */
+                    v |= 0xff000000u;
+                } else {
+                    v = (mix(d >> 24, 255, w) << 24) |
+                        (mix((d >> 16) & 255, r, w) << 16) |
+                        (mix((d >> 8) & 255, g, w) << 8) |
+                        mix(d & 255, b, w);
+                }
+                if (t->format == DRW_FORMAT_XRGB8888)
+                    v = (v & 0xffffff) | (d & 0xff000000u);
+                memcpy(dst + (size_t)px * 4, &v, 4);
+            }
+        }
+    }
+}
diff --git a/mask.h b/mask.h
new file mode 100644
index 0000000..5449708
--- /dev/null
+++ b/mask.h
@@ -0,0 +1,37 @@
+#ifndef MASK_H
+#define MASK_H
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "drw.h"
+
+/* A coverage mask: how much of the text colour each pixel gets. All text
+ * backends produce these, so there is a single blitter to get right. */
+struct label_mask {
+	uint8_t depth; /* bits per pixel: 1, 4 or 8; the top bits come first */
+	uint16_t w, h;
+	int16_t bx, by; /* top-left corner relative to the draw origin */
+	const uint8_t *data; /* h rows of mask_stride() bytes */
+};
+
+/* Rows are padded to 4 bytes so a row can be read as one word and masks can
+ * be stored back to back without alignment fixups. */
+size_t mask_stride(unsigned depth, unsigned w);
+
+struct mask_target {
+	uint8_t *data;
+	uint32_t stride, width, height;
+	enum drw_format format;
+	/* Pixels outside [clip_x0, clip_x1) x [clip_y0, clip_y1) and outside the
+	 * buffer are never written, so a long label cannot spill onto the next
+	 * key. */
+	int clip_x0, clip_y0, clip_x1, clip_y1;
+};
+
+/* Draws the mask with its origin at (x, y) in the colour. Formats without
+ * alpha ignore the colour's alpha channel. */
+void mask_blit(const struct mask_target *t, const struct label_mask *m, int x,
+               int y, Color color);
+
+#endif
