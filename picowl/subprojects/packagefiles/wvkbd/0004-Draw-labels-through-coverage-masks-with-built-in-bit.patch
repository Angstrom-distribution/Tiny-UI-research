diff --git a/tests/lsan.supp b/tests/lsan.supp
new file mode 100644
index 0000000..69bd980
--- /dev/null
+++ b/tests/lsan.supp
@@ -0,0 +1,17 @@
+# Leak sanitizer suppressions for the pango text backend.
+#
+# pango, fontconfig and the font libraries under them keep the font map, the
+# font patterns and the shaping caches in process-wide state that they never
+# free, so every test that renders a label reports them at exit although
+# nothing in this tree owns that memory. Each pattern names a shared library;
+# LSan matches it against every frame of a leak's stack, so a leak is hidden
+# only if one of its frames is inside one of these libraries.
+#
+# libcairo and libglib are left out on purpose: our own code allocates through
+# them (surfaces, contexts and regions, the pango layout), and suppressing
+# them would hide exactly the leaks a test is there to find. Nothing here
+# needs them, since pango's own stacks already contain a libpango frame.
+leak:libpango
+leak:libfontconfig
+leak:libfreetype
+leak:libharfbuzz
