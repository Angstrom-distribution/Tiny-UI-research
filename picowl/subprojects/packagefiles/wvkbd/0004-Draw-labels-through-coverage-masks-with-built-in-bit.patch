diff --git a/tests/test-bitmap.c b/tests/test-bitmap.c
new file mode 100644
index 0000000..9973eb4
--- /dev/null
+++ b/tests/test-bitmap.c
@@ -0,0 +1,250 @@
+/* The built-in bitmap fonts: glyph lookup, the missing-glyph box, font
+ * choice and end-to-end drawing. */
+#include <string.h>
+
+#include "check.h"
+#include "text-bitmap.h"
+#include "text.h"
+
+static const struct bmfont *
+font_named(const char *name)
+{
+    for (unsigned i = 0; i < nbmfonts; i++)
+        if (!strcmp(bmfonts[i]->name, name))
+            return bmfonts[i];
+    return NULL;
+}
+
+static void
+test_tables(void)
+{
+    CHECK(nbmfonts == 2, "two fonts, got %u", nbmfonts);
+    CHECK(font_named("6x13") && font_named("10x20"), "both fonts present");
+    /* largest first is what bm_pick_font relies on */
+    CHECK(bmfonts[0]->cell_h > bmfonts[1]->cell_h, "fonts are ordered");
+    for (unsigned i = 0; i < nbmfonts; i++) {
+        const struct bmfont *f = bmfonts[i];
+        /* find_glyph does a binary search */
+        for (uint32_t g = 1; g < f->nglyphs; g++)
+            CHECK(f->glyphs[g - 1].cp < f->glyphs[g].cp,
+                  "%s glyphs out of order at %u", f->name, g);
+    }
+}
+
+static void
+test_glyph_a(void)
+{
+    /* 'A' in 6x13.bdf, rows 2..10 of 13, cropped to the 5 columns of ink */
+    static const uint8_t rows[] = {0x20, 0x50, 0x88, 0x88, 0x88,
+                                   0xf8, 0x88, 0x88, 0x88};
+    struct label_mask m;
+    int adv;
+
+    bm_glyph_mask(font_named("6x13"), 'A', &m, &adv);
+    CHECK(m.depth == 1 && m.w == 5 && m.h == 9, "A is %ux%u at %u bpp", m.w,
+          m.h, m.depth);
+    CHECK(m.bx == 0 && m.by == -9, "A bearing %d,%d", m.bx, m.by);
+    CHECK(adv == 6, "A advances %d", adv);
+    for (unsigned y = 0; y < 9 && m.data; y++) {
+        const uint8_t *row = m.data + y * mask_stride(1, m.w);
+        CHECK(row[0] == rows[y] && !row[1] && !row[2] && !row[3],
+              "A row %u is %02x%02x%02x%02x, want %02x000000", y, row[0],
+              row[1], row[2], row[3], rows[y]);
+    }
+
+    bm_glyph_mask(font_named("10x20"), 'A', &m, &adv);
+    CHECK(m.w > 5 && m.h > 9 && adv == 10, "10x20 A is %ux%u, advance %d", m.w,
+          m.h, adv);
+}
+
+static void
+test_coverage(void)
+{
+    unsigned before = bm_missing_logged();
+
+    /* ASCII and ISO 8859-1 must be complete in both fonts */
+    for (unsigned i = 0; i < nbmfonts; i++) {
+        for (uint32_t cp = 0x20; cp < 0x100; cp++) {
+            if (cp >= 0x7f && cp < 0xa0)
+                continue;
+            struct label_mask m;
+            int adv;
+            bm_glyph_mask(bmfonts[i], cp, &m, &adv);
+            bool blank = cp == 0x20 || cp == 0xa0;
+            CHECK(blank ? m.w == 0 : m.w > 0 && m.h > 0,
+                  "%s U+%04X has a %ux%u mask", bmfonts[i]->name, cp, m.w, m.h);
+            CHECK(adv == bmfonts[i]->cell_w, "%s U+%04X advances %d",
+                  bmfonts[i]->name, cp, adv);
+        }
+        /* a few of the symbols the layouts use */
+        static const uint32_t symbols[] = {0x2190, 0x2191,
+                                           0x2192, 0x2193, 0x0416, 0x03a9,
+                                           0x0141, 0x05d0, 0x2026, 0x00ff};
+        for (unsigned s = 0; s < sizeof(symbols) / sizeof(symbols[0]); s++) {
+            struct label_mask m;
+            int adv;
+            bm_glyph_mask(bmfonts[i], symbols[s], &m, &adv);
+            CHECK(m.w > 0, "%s U+%04X is missing", bmfonts[i]->name, symbols[s]);
+        }
+    }
+    CHECK(bm_missing_logged() == before,
+          "present glyphs were reported missing");
+}
+
+static void
+test_missing(void)
+{
+    const struct bmfont *f = font_named("6x13");
+    struct label_mask m;
+    int adv;
+    unsigned before = bm_missing_logged();
+
+    /* an emoji no fixed font has */
+    bm_glyph_mask(f, 0x1f600, &m, &adv);
+    CHECK(m.depth == 1 && m.w == f->cell_w - 1 && m.h == f->ascent - 1,
+          "box is %ux%u", m.w, m.h);
+    CHECK(adv == f->cell_w, "box advances %d", adv);
+    CHECK(m.by == -(int)m.h, "box sits on the baseline");
+    CHECK(bm_missing_logged() == before + 1, "first miss is logged");
+
+    for (unsigned y = 0; y < m.h; y++) {
+        uint32_t row = 0;
+        for (int b = 0; b < 4; b++)
+            row = row << 8 | m.data[y * mask_stride(1, m.w) + b];
+        uint32_t edge = ~0u << (32 - m.w);
+        uint32_t want = (y == 0 || y == (unsigned)m.h - 1)
+                            ? edge
+                            : (0x80000000u | 0x80000000u >> (m.w - 1));
+        CHECK(row == want, "box row %u is %08x, want %08x", y, row, want);
+    }
+
+    /* the same code point again, from either font, stays quiet */
+    bm_glyph_mask(f, 0x1f600, &m, &adv);
+    bm_glyph_mask(font_named("10x20"), 0x1f600, &m, &adv);
+    CHECK(bm_missing_logged() == before + 1, "second miss is not logged again");
+    CHECK(m.w == 9 && m.h == 15, "10x20 box is %ux%u", m.w, m.h);
+
+    bm_glyph_mask(f, 0x1f601, &m, &adv);
+    CHECK(bm_missing_logged() == before + 2, "another code point is logged");
+
+    /* a label made of nothing but missing glyphs still draws boxes */
+    uint8_t big[64 * 20];
+    memset(big, 0, sizeof(big));
+    struct mask_target t = {.data = big, .stride = 64, .width = 32,
+                            .height = 20, .format = DRW_FORMAT_RGB565,
+                            .clip_x1 = 32, .clip_y1 = 20};
+    Color white = {.color = UINT32_MAX};
+    struct text_font *font = text_font_new("unused");
+    text_draw(font, "\xf0\x9f\x98\x80", &t, 0, 0, 32, 20, 1, 1.0, white);
+    int ink = 0;
+    for (size_t i = 0; i < sizeof(big); i++)
+        ink += big[i] != 0;
+    CHECK(ink > 0, "a missing glyph was skipped silently");
+    CHECK(bm_missing_logged() == before + 2, "drawing did not re-log");
+    text_font_free(font);
+}
+
+static void
+test_utf8(void)
+{
+    const char *p = "\xc3\xa9";
+    CHECK(bm_utf8_next(&p) == 0xe9 && !*p, "e acute");
+    p = "\xf0\x9f\x98\x80x";
+    CHECK(bm_utf8_next(&p) == 0x1f600 && *p == 'x', "emoji");
+    p = "\xe2\x82";
+    CHECK(bm_utf8_next(&p) == 0xfffd && p[0] == '\x82', "truncated sequence");
+    p = "\xc0\x80";
+    CHECK(bm_utf8_next(&p) == 0xfffd, "overlong NUL");
+    p = "\xed\xa0\x80";
+    CHECK(bm_utf8_next(&p) == 0xfffd, "surrogate");
+    p = "\xff";
+    CHECK(bm_utf8_next(&p) == 0xfffd && !*p, "invalid lead byte");
+    p = "\x80";
+    CHECK(bm_utf8_next(&p) == 0xfffd && !*p, "stray continuation byte");
+}
+
+static void
+test_pick(void)
+{
+    /* nothing fits 85 percent of 15 pixels: the smallest font, anyway */
+    CHECK(!strcmp(bm_pick_font("A", 40, 15)->name, "6x13"), "15 px");
+    CHECK(!strcmp(bm_pick_font("A", 40, 16)->name, "6x13"), "16 px");
+    CHECK(!strcmp(bm_pick_font("A", 40, 23)->name, "6x13"), "23 px");
+    CHECK(!strcmp(bm_pick_font("A", 40, 24)->name, "10x20"), "24 px");
+    /* too wide for the large font: fall back to the small one */
+    CHECK(!strcmp(bm_pick_font("AAAA", 24, 30)->name, "6x13"), "wide label");
+    /* too wide for both: the smallest, which shows the most of it */
+    CHECK(!strcmp(bm_pick_font("AAAAAAAAAA", 24, 30)->name, "6x13"),
+          "very wide label");
+
+    for (unsigned h = 16; h < 80; h++) {
+        const struct bmfont *f = bm_pick_font("A", 1000, h);
+        CHECK(f->cell_h * 100 <= h * 85, "%s is more than 85%% of %u px",
+              f->name, h);
+    }
+}
+
+static uint16_t
+get565(const uint8_t *mem, unsigned stride, unsigned x, unsigned y)
+{
+    uint16_t v;
+    memcpy(&v, mem + y * stride + x * 2, 2);
+    return v;
+}
+
+static void
+test_draw(void)
+{
+    enum { W = 40, H = 30, STRIDE = W * 2 };
+    static uint8_t mem[STRIDE * H];
+    struct mask_target t = {.data = mem, .stride = STRIDE, .width = W,
+                            .height = H, .format = DRW_FORMAT_RGB565,
+                            .clip_x1 = W, .clip_y1 = H};
+    Color white = {.color = UINT32_MAX};
+    struct text_font *font = text_font_new("ignored");
+
+    /* A box at (4,3) of 24x20 with a 2 pixel border: inner height 16 takes
+     * the 6x13 font. A long label must not leave the inner box. */
+    text_draw(font, "WWWWWWWWWWWW", &t, 4, 3, 24, 20, 2, 1.0, white);
+    int inside = 0, outside = 0;
+    for (unsigned y = 0; y < H; y++)
+        for (unsigned x = 0; x < W; x++) {
+            bool in = x >= 6 && x < 26 && y >= 5 && y < 21;
+            if (get565(mem, STRIDE, x, y))
+                in ? inside++ : outside++;
+        }
+    CHECK(inside > 0, "the label drew nothing");
+    CHECK(outside == 0, "%d pixels outside the inner box", outside);
+
+    /* a short label is centred; 20 px inside the border takes the 6x13 font */
+    memset(mem, 0, sizeof(mem));
+    text_draw(font, "I", &t, 0, 0, 40, 22, 1, 1.0, white);
+    int minx = W, maxx = -1, miny = H, maxy = -1;
+    for (int y = 0; y < H; y++)
+        for (int x = 0; x < W; x++)
+            if (get565(mem, STRIDE, x, y)) {
+                if (x < minx) minx = x;
+                if (x > maxx) maxx = x;
+                if (y < miny) miny = y;
+                if (y > maxy) maxy = y;
+            }
+    CHECK(maxx >= 0, "I drew nothing");
+    /* a 6 pixel cell centred in 40 starts at 17; 13 rows centred in 22 start
+     * at row 4 */
+    CHECK(minx >= 17 && maxx <= 22, "I spans %d..%d", minx, maxx);
+    CHECK(miny >= 4 && maxy <= 16, "I spans rows %d..%d", miny, maxy);
+    text_font_free(font);
+}
+
+int
+main(void)
+{
+    test_tables();
+    test_glyph_a();
+    test_coverage();
+    test_missing();
+    test_utf8();
+    test_pick();
+    test_draw();
+    return failures ? 1 : 0;
+}
