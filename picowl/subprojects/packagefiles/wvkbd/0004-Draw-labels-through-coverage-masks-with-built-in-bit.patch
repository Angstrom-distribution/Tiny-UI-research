diff --git a/Makefile b/Makefile
index a19831e..b423012 100644
--- a/Makefile
+++ b/Makefile
@@ -7,9 +7,20 @@ BIN=${NAME}-${LAYOUT}
 SRC=.
 MAN1 = ${NAME}.1
 
-PKGS = wayland-client xkbcommon pangocairo
-
-WVKBD_SOURCES += $(wildcard $(SRC)/*.c)
+# TEXT=pango for pango labels; the default draws with the built-in bitmap fonts
+TEXT ?= bitmap
+PKGS = wayland-client xkbcommon cairo
+ifeq ($(TEXT),pango)
+PKGS += pangocairo
+CFLAGS += -DTEXT_PANGO
+endif
+
+WVKBD_SOURCES += $(filter-out $(SRC)/text-%.c $(SRC)/bmfont-data.c, $(wildcard $(SRC)/*.c))
+ifeq ($(TEXT),pango)
+WVKBD_SOURCES += $(SRC)/text-pango.c
+else
+WVKBD_SOURCES += $(SRC)/text-bitmap.c $(SRC)/bmfont-data.c
+endif
 WVKBD_HEADERS += $(wildcard $(SRC)/*.h)
 WVKBD_DIR_SOURCES = $(foreach src, $(WVKBD_SOURCES), $(addprefix $(BUILDDIR)/, $(src)))
 
diff --git a/README.md b/README.md
index 0cd0e6f..3de351d 100644
--- a/README.md
+++ b/README.md
@@ -39,10 +39,15 @@ There are some areas that still need work:
 You'll need the following developer packages
 
  - cairo
- - pango
+ - pango (only for the optional pango text backend, see below)
  - wayland-client
  - xkbcommon
 
+Labels are drawn with built-in X11 bitmap fonts by default. That build links neither pango, pangocairo nor harfbuzz, and wvkbd itself has no direct fontconfig dependency.
+libcairo may still pull in fontconfig transitively, depending on how cairo was built, so whether the target has fontconfig is decided by the cairo recipe.
+To use pango instead (any font, any script, at the cost of the extra libraries), build with `make TEXT=pango` or
+`meson setup build -Dtext=pango`. The font tables in `bmfont-data.c` are generated by `tools/regen-fonts.sh`.
+
 You also need [scdoc](https://git.sr.ht/~sircmpwn/scdoc/) to generate the documentation.
 
 The default set of layouts is called `mobintl` *(mobile international)*, which groups various layouts aimed at mobile devices
