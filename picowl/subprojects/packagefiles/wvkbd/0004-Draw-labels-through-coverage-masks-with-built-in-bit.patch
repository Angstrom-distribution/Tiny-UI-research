+/* Shift, caps lock, backspace and enter are shapes rather than glyphs: the
+ * built-in fonts draw them too small to read and as one fixed bitmap, while
+ * these scale with the key. */
+enum icon { ICON_NONE, ICON_SHIFT, ICON_CAPS, ICON_BACKSPACE, ICON_ENTER };
+
+static enum icon
+drw_icon_for_label(const char *label)
+{
+    if (!strcmp(label, "\u21e7")) return ICON_SHIFT;
+    if (!strcmp(label, "\u21eb")) return ICON_CAPS;
+    if (!strcmp(label, "\u232b")) return ICON_BACKSPACE;
+    if (!strcmp(label, "\u21b5")) return ICON_ENTER;
+    return ICON_NONE;
+}
+
+static void
+drw_path(cairo_t *cr, double cx, double cy, double u, const double (*pts)[2],
+         int n)
+{
+    for (int i = 0; i < n; i++) {
+        double px = cx + pts[i][0] * u, py = cy + pts[i][1] * u;
+        if (i == 0)
+            cairo_move_to(cr, px, py);
+        else
+            cairo_line_to(cr, px, py);
+    }
+    cairo_close_path(cr);
+}
+
+static void
+drw_draw_icon(struct drwbuf *d, enum drw_format format, Color color,
+              enum icon icon, uint32_t x, uint32_t y, uint32_t w, uint32_t h,
+              uint32_t b)
+{
+    double inner = (w < h ? w : h) - 2.0 * b;
+    if (inner <= 0)
+        return;
+    double u = inner * 0.25; /* half the arrow's body, in pixels */
+    double cx = x + w / 2.0, cy = y + h / 2.0;
+    cairo_t *cr = d->cairo;
+
+    cairo_save(cr);
+    /* the keyboard turns antialiasing off for crisp key edges; diagonals
+     * need it */
+    cairo_set_antialias(cr, CAIRO_ANTIALIAS_DEFAULT);
+    drw_set_color(cr, format, color);
+    cairo_set_line_width(cr, u * 0.4 < 1.0 ? 1.0 : u * 0.4);
+    cairo_set_line_join(cr, CAIRO_LINE_JOIN_MITER);
+
+    static const double arrow[][2] = {
+        {0, -1.5}, {1.4, 0}, {0.6, 0}, {0.6, 1.4},
+        {-0.6, 1.4}, {-0.6, 0}, {-1.4, 0}};
+    static const double tag[][2] = {
+        {-1.8, 0}, {-0.8, -1.2}, {1.8, -1.2}, {1.8, 1.2}, {-0.8, 1.2}};
+    switch (icon) {
+    case ICON_SHIFT:
+        drw_path(cr, cx, cy, u, arrow, 7);
+        cairo_fill(cr);
+        break;
+    case ICON_CAPS:
+        drw_path(cr, cx, cy - 0.3 * u, u, arrow, 7);
+        cairo_fill(cr);
+        cairo_rectangle(cr, cx - 0.6 * u, cy + 1.4 * u, 1.2 * u, 0.4 * u);
+        cairo_fill(cr);
+        break;
+    case ICON_BACKSPACE:
+        drw_path(cr, cx, cy, u, tag, 5);
+        cairo_stroke(cr);
+        cairo_move_to(cr, cx - 0.2 * u, cy - 0.5 * u);
+        cairo_line_to(cr, cx + 0.9 * u, cy + 0.5 * u);
+        cairo_move_to(cr, cx + 0.9 * u, cy - 0.5 * u);
+        cairo_line_to(cr, cx - 0.2 * u, cy + 0.5 * u);
+        cairo_stroke(cr);
+        break;
+    case ICON_ENTER:
+        cairo_move_to(cr, cx + 1.4 * u, cy - 1.2 * u);
+        cairo_line_to(cr, cx + 1.4 * u, cy + 0.4 * u);
+        cairo_line_to(cr, cx - 0.4 * u, cy + 0.4 * u);
+        cairo_stroke(cr);
+        cairo_move_to(cr, cx - 1.6 * u, cy + 0.4 * u);
+        cairo_line_to(cr, cx - 0.4 * u, cy - 0.5 * u);
+        cairo_line_to(cr, cx - 0.4 * u, cy + 1.3 * u);
+        cairo_close_path(cr);
+        cairo_fill(cr);
+        break;
+    default:
+        break;
+    }
+    cairo_restore(cr);
+}
+
 void
 drw_draw_text(struct drwsurf *ds, Color color, uint32_t x, uint32_t y,
               uint32_t w, uint32_t h, uint32_t b, const char *label,
-              PangoFontDescription *font_description)
+              struct text_font *font)
 {
     drwsurf_flip(ds);
     struct drwbuf *d = ds->back_buffer;
     drwsurf_damage(ds, x, y, w, h);
 
-    cairo_save(d->cairo);
-
-    pango_layout_set_font_description(d->layout, font_description);
-
-    drw_set_color(d->cairo, ds->format, color);
-    cairo_move_to(d->cairo, x + w / 2, y + h / 2);
-
-    pango_layout_set_text(d->layout, label, -1);
-    pango_layout_set_width(d->layout, (w - (b * 2)) * PANGO_SCALE);
-    pango_layout_set_height(d->layout, (h - (b * 2)) * PANGO_SCALE);
-
-    int width, height;
-    pango_layout_get_pixel_size(d->layout, &width, &height);
-
-    cairo_rel_move_to(d->cairo, -width / 2, -height / 2);
+    enum icon icon = drw_icon_for_label(label);
+    if (icon != ICON_NONE) {
+        drw_draw_icon(d, ds->format, color, icon, x, y, w, h, b);
+        return;
+    }
 
-    pango_cairo_show_layout(d->cairo, d->layout);
-    cairo_restore(d->cairo);
+    /* ds->width and ds->height already describe a new size when setup_buffer
+     * failed part way, while the surface is still the old one. The blitter
+     * must only trust the memory that cairo actually draws into. */
+    if (!d->cairo_surf)
+        return;
+    cairo_surface_flush(d->cairo_surf);
+    unsigned char *data = cairo_image_surface_get_data(d->cairo_surf);
+    if (!data)
+        return;
+    int sw = cairo_image_surface_get_width(d->cairo_surf);
+    int sh = cairo_image_surface_get_height(d->cairo_surf);
+    struct mask_target t = {
+        .data = data, .stride = cairo_image_surface_get_stride(d->cairo_surf),
+        .width = sw, .height = sh, .format = ds->format,
+        .clip_x1 = sw, .clip_y1 = sh,
+    };
+    /* The mask blitter works in buffer pixels, which differ from surface
+     * coordinates when the compositor scales the surface. */
+    int bx = lround(x * ds->scale), by = lround(y * ds->scale);
+    int bw = lround((x + w) * ds->scale) - bx;
+    int bh = lround((y + h) * ds->scale) - by;
+
+    text_draw(font, label, &t, bx, by, bw, bh, lround(b * ds->scale),
+              ds->scale, color);
+    /* cairo does not know that the blitter changed the memory */
+    cairo_surface_mark_dirty(d->cairo_surf);
 }
 
