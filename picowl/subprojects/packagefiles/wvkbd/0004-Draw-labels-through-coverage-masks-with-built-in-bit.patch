diff --git a/bmfont.h b/bmfont.h
new file mode 100644
index 0000000..00437fa
--- /dev/null
+++ b/bmfont.h
@@ -0,0 +1,30 @@
+#ifndef BMFONT_H
+#define BMFONT_H
+
+#include <stdint.h>
+
+/* One glyph of a bitmap font. The 1 bpp mask is cropped to its ink, rows are
+ * padded to 4 bytes and the first pixel of a row is the top bit. bx and by
+ * place the mask's top-left corner relative to the pen position on the
+ * baseline (by is negative above it). */
+struct bmglyph {
+	uint32_t cp;
+	uint32_t off; /* into bmfont.bits */
+	uint8_t adv;  /* pen advance; combining marks have 0 */
+	uint8_t w, h;
+	int8_t bx, by;
+};
+
+struct bmfont {
+	const char *name;
+	uint8_t cell_w, cell_h, ascent;
+	const struct bmglyph *glyphs; /* sorted by cp */
+	uint32_t nglyphs;
+	const uint8_t *bits;
+};
+
+/* Largest first. */
+extern const struct bmfont *const bmfonts[];
+extern const unsigned nbmfonts;
+
+#endif
