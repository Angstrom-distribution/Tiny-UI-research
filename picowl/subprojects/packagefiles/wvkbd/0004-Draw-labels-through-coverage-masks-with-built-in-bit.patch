diff --git a/tests/test-mask.c b/tests/test-mask.c
new file mode 100644
index 0000000..93be28a
--- /dev/null
+++ b/tests/test-mask.c
@@ -0,0 +1,283 @@
+/* The mask blitter, pixel for pixel. Expected values are written out by hand
+ * (white on black makes the blend arithmetic checkable on paper) rather than
+ * recomputed with the blitter's own formula. */
+#include <string.h>
+
+#include "check.h"
+#include "mask.h"
+
+#define SENTINEL 0xa5
+
+/* A small buffer with a row stride larger than the pixel data, filled with a
+ * sentinel so writes into the padding or past the end show up. */
+struct buf {
+    uint8_t mem[512];
+    struct mask_target t;
+};
+
+static void
+buf_init(struct buf *b, enum drw_format f, uint32_t w, uint32_t h,
+         uint32_t init)
+{
+    unsigned bpp = f == DRW_FORMAT_RGB565 ? 2 : 4;
+    memset(b->mem, SENTINEL, sizeof(b->mem));
+    b->t = (struct mask_target){
+        .data = b->mem, .stride = (w * bpp + 3) & ~3u, .width = w,
+        .height = h, .format = f, .clip_x1 = w, .clip_y1 = h};
+    for (uint32_t y = 0; y < h; y++)
+        for (uint32_t x = 0; x < w; x++)
+            memcpy(b->mem + y * b->t.stride + x * bpp, &init, bpp);
+}
+
+static uint32_t
+px(const struct buf *b, uint32_t x, uint32_t y)
+{
+    unsigned bpp = b->t.format == DRW_FORMAT_RGB565 ? 2 : 4;
+    uint32_t v = 0;
+    memcpy(&v, b->mem + y * b->t.stride + x * bpp, bpp);
+    return v;
+}
+
+/* Nothing outside the w x h pixels, padding included, may change. */
+static void
+check_untouched_outside(const struct buf *b, const char *what)
+{
+    unsigned bpp = b->t.format == DRW_FORMAT_RGB565 ? 2 : 4;
+    for (size_t i = 0; i < sizeof(b->mem); i++) {
+        size_t row = i / b->t.stride, col = i % b->t.stride;
+        bool inside = row < b->t.height && col < b->t.width * bpp;
+        CHECK(inside || b->mem[i] == SENTINEL,
+              "%s: byte %zu outside the image was written", what, i);
+    }
+}
+
+static const enum drw_format formats[] = {DRW_FORMAT_RGB565,
+                                          DRW_FORMAT_XRGB8888,
+                                          DRW_FORMAT_ARGB8888};
+static const char *const fname[] = {"rgb565", "xrgb8888", "argb8888"};
+
+/* background and white as the format stores them */
+static uint32_t
+bg_of(enum drw_format f)
+{
+    return f == DRW_FORMAT_XRGB8888 ? 0x00000000u : 0;
+}
+
+static void
+test_stride(void)
+{
+    CHECK(mask_stride(1, 1) == 4, "1 bpp, 1 px");
+    CHECK(mask_stride(1, 32) == 4, "1 bpp, 32 px");
+    CHECK(mask_stride(1, 33) == 8, "1 bpp, 33 px");
+    CHECK(mask_stride(4, 8) == 4, "4 bpp, 8 px");
+    CHECK(mask_stride(4, 9) == 8, "4 bpp, 9 px is 5 bytes, padded to 8");
+    CHECK(mask_stride(8, 4) == 4, "8 bpp, 4 px");
+    CHECK(mask_stride(8, 5) == 8, "8 bpp, 5 px");
+    CHECK(mask_stride(8, 0) == 0, "empty mask");
+}
+
+static void
+test_1bpp(void)
+{
+    /* 10 wide: two data bytes per row, two bytes of padding. Bits and bytes
+     * past the 10th pixel are set to prove they are never read. */
+    static const uint8_t bits[] = {
+        0xaa, 0xbf, 0xff, 0xff, /* 1010101010 */
+        0xff, 0xc0, 0x00, 0x00, /* 1111111111 */
+    };
+    const struct label_mask m = {.depth = 1, .w = 10, .h = 2, .data = bits};
+    /* b = 0x20, g = 0x90, r = 0xe0 */
+    const Color c = {.bgra = {0x20, 0x90, 0xe0, 0xff}};
+    const uint32_t want[] = {(0xe0 >> 3) << 11 | (0x90 >> 2) << 5 | (0x20 >> 3),
+                             0x00e09020, 0xffe09020};
+
+    for (int i = 0; i < 3; i++) {
+        struct buf b;
+        buf_init(&b, formats[i], 11, 3, bg_of(formats[i]));
+        mask_blit(&b.t, &m, 0, 1, c);
+        for (uint32_t x = 0; x < 11; x++) {
+            uint32_t r0 = (x < 10 && x % 2 == 0) ? want[i] : bg_of(formats[i]);
+            uint32_t r1 = x < 10 ? want[i] : bg_of(formats[i]);
+            CHECK(px(&b, x, 0) == bg_of(formats[i]), "%s: row above", fname[i]);
+            CHECK(px(&b, x, 1) == r0, "%s: row 0 x=%u got %08x want %08x",
+                  fname[i], x, px(&b, x, 1), r0);
+            CHECK(px(&b, x, 2) == r1, "%s: row 1 x=%u got %08x want %08x",
+                  fname[i], x, px(&b, x, 2), r1);
+        }
+        check_untouched_outside(&b, fname[i]);
+    }
+}
+
+static void
+test_alpha(void)
+{
+    const Color white = {.color = UINT32_MAX};
+    /* 8 bpp, 3 wide so rows pad from 3 to 4 bytes (the pad byte is 0xff) */
+    static const uint8_t a8[] = {0, 64, 128, 0xff, 255, 0, 64, 0xff};
+    /* 4 bpp: nibbles 0 4 8 | 15 0 4, the nibble after the third is junk */
+    static const uint8_t a4[] = {0x04, 0x8f, 0xff, 0xff, 0xf0, 0x4f, 0xff, 0xff};
+    const struct label_mask m8 = {.depth = 8, .w = 3, .h = 2, .data = a8};
+    const struct label_mask m4 = {.depth = 4, .w = 3, .h = 2, .data = a4};
+
+    /* [format][coverage 64, 128, 255] for 8 bpp, [4, 8, 15] for 4 bpp */
+    static const uint32_t w8[3][3] = {{0x39e7, 0x7bef, 0xffff},
+                                      {0x3f3f3f, 0x808080, 0xffffff},
+                                      {0x3f3f3f3f, 0x80808080, 0xffffffff}};
+    static const uint32_t w4[3][3] = {{0x4208, 0x8430, 0xffff},
+                                      {0x434343, 0x888888, 0xffffff},
+                                      {0x43434343, 0x88888888, 0xffffffff}};
+
+    for (int i = 0; i < 3; i++) {
+        const uint32_t black = bg_of(formats[i]);
+        const struct label_mask *ms[2] = {&m8, &m4};
+        const uint32_t (*want[2])[3] = {w8, w4};
+        for (int d = 0; d < 2; d++) {
+            struct buf b;
+            buf_init(&b, formats[i], 4, 2, black);
+            mask_blit(&b.t, ms[d], 0, 0, white);
+            const uint32_t *w = want[d][i];
+            const uint32_t expect[2][4] = {{black, w[0], w[1], black},
+                                           {w[2], black, w[0], black}};
+            for (uint32_t y = 0; y < 2; y++)
+                for (uint32_t x = 0; x < 4; x++)
+                    CHECK(px(&b, x, y) == expect[y][x],
+                          "%s %d bpp (%u,%u) got %08x want %08x", fname[i],
+                          d ? 4 : 8, x, y, px(&b, x, y), expect[y][x]);
+            check_untouched_outside(&b, fname[i]);
+        }
+    }
+
+    /* a blit over an existing colour mixes with it: 50 % white over mid grey
+     * in 565 is (0x10*127 + 0x1f*129) >> 8 = 0x17 for red and blue and
+     * (0x20*127 + 0x3f*129) >> 8 = 0x2f for green */
+    struct buf b;
+    static const uint8_t half[] = {128, 0, 0, 0};
+    const struct label_mask mh = {.depth = 8, .w = 1, .h = 1, .data = half};
+    buf_init(&b, DRW_FORMAT_RGB565, 1, 1, 0x8410);
+    mask_blit(&b.t, &mh, 0, 0, white);
+    CHECK(px(&b, 0, 0) == (0x17u << 11 | 0x2fu << 5 | 0x17u),
+          "blend over grey got %04x", px(&b, 0, 0));
+}
+
+static void
+test_alpha_channel(void)
+{
+    static const uint8_t full[] = {255, 0, 0, 0};
+    const struct label_mask m = {.depth = 8, .w = 1, .h = 1, .data = full};
+    /* weight 255 * 128 / 255 = 128, scaled to 0..256 and rounded: 129 */
+    const Color half = {.bgra = {0xff, 0xff, 0xff, 128}};
+
+    struct buf b;
+    buf_init(&b, DRW_FORMAT_ARGB8888, 1, 1, 0);
+    mask_blit(&b.t, &m, 0, 0, half);
+    CHECK(px(&b, 0, 0) == 0x80808080u,
+          "translucent text on transparent got %08x", px(&b, 0, 0));
+
+    /* formats without alpha must ignore it, or labels would fade out */
+    const Color clear = {.bgra = {0xff, 0xff, 0xff, 0}};
+    buf_init(&b, DRW_FORMAT_RGB565, 1, 1, 0);
+    mask_blit(&b.t, &m, 0, 0, clear);
+    CHECK(px(&b, 0, 0) == 0xffff, "rgb565 honoured alpha: %04x", px(&b, 0, 0));
+    buf_init(&b, DRW_FORMAT_XRGB8888, 1, 1, 0xab000000u);
+    mask_blit(&b.t, &m, 0, 0, clear);
+    CHECK(px(&b, 0, 0) == 0xabffffffu,
+          "xrgb8888 honoured alpha or lost its pad byte: %08x", px(&b, 0, 0));
+}
+
+static void
+test_clipping(void)
+{
+    static const uint8_t ones[] = {0xf0, 0, 0, 0, 0xf0, 0, 0, 0, 0xf0, 0, 0, 0};
+    struct label_mask m = {.depth = 1, .w = 4, .h = 3, .data = ones};
+    const Color red = {.bgra = {0, 0, 0xff, 0xff}};
+
+    for (int i = 0; i < 3; i++) {
+        const uint32_t black = bg_of(formats[i]);
+        uint32_t red_px = i == 0 ? 0xf800 : i == 1 ? 0xff0000 : 0xffff0000u;
+        struct buf b;
+
+        /* past the top-left corner: only (0..1, 0..1) is inside */
+        buf_init(&b, formats[i], 5, 3, black);
+        mask_blit(&b.t, &m, -2, -1, red);
+        for (uint32_t y = 0; y < 3; y++)
+            for (uint32_t x = 0; x < 5; x++)
+                CHECK(px(&b, x, y) == (x < 2 && y < 2 ? red_px : black),
+                      "%s top-left (%u,%u)", fname[i], x, y);
+        check_untouched_outside(&b, fname[i]);
+
+        /* past the bottom-right corner: only (3..4, 2) is inside; stride
+         * padding sits right of x = 4 in the 565 buffer */
+        buf_init(&b, formats[i], 5, 3, black);
+        mask_blit(&b.t, &m, 3, 2, red);
+        for (uint32_t y = 0; y < 3; y++)
+            for (uint32_t x = 0; x < 5; x++)
+                CHECK(px(&b, x, y) == (x >= 3 && y == 2 ? red_px : black),
+                      "%s bottom-right (%u,%u)", fname[i], x, y);
+        check_untouched_outside(&b, fname[i]);
+
+        /* completely outside */
+        buf_init(&b, formats[i], 5, 3, black);
+        mask_blit(&b.t, &m, 5, 0, red);
+        mask_blit(&b.t, &m, -4, 0, red);
+        mask_blit(&b.t, &m, 0, 3, red);
+        mask_blit(&b.t, &m, 0, -3, red);
+        for (uint32_t y = 0; y < 3; y++)
+            for (uint32_t x = 0; x < 5; x++)
+                CHECK(px(&b, x, y) == black, "%s outside (%u,%u)", fname[i], x, y);
+        check_untouched_outside(&b, fname[i]);
+
+        /* the bearing moves the mask from the draw origin */
+        m.bx = -1;
+        m.by = -2;
+        buf_init(&b, formats[i], 5, 3, black);
+        mask_blit(&b.t, &m, 3, 3, red);
+        for (uint32_t y = 0; y < 3; y++)
+            for (uint32_t x = 0; x < 5; x++)
+                CHECK(px(&b, x, y) == (x >= 2 && x < 5 && y >= 1 ? red_px : black),
+                      "%s bearing (%u,%u) got %08x", fname[i], x, y, px(&b, x, y));
+        m.bx = m.by = 0;
+
+        /* an explicit clip rectangle inside the buffer */
+        buf_init(&b, formats[i], 5, 3, black);
+        b.t.clip_x0 = 1; b.t.clip_x1 = 3; b.t.clip_y0 = 1; b.t.clip_y1 = 2;
+        mask_blit(&b.t, &m, 0, 0, red);
+        for (uint32_t y = 0; y < 3; y++)
+            for (uint32_t x = 0; x < 5; x++)
+                CHECK(px(&b, x, y) == (x >= 1 && x < 3 && y == 1 ? red_px : black),
+                      "%s clip rect (%u,%u)", fname[i], x, y);
+
+        /* a clip rectangle larger than the buffer must not extend it */
+        buf_init(&b, formats[i], 5, 3, black);
+        b.t.clip_x0 = -10; b.t.clip_y0 = -10; b.t.clip_x1 = 100; b.t.clip_y1 = 100;
+        mask_blit(&b.t, &m, 3, 2, red);
+        check_untouched_outside(&b, fname[i]);
+    }
+}
+
+static void
+test_rejects(void)
+{
+    static const uint8_t bits[] = {0xff, 0xff, 0xff, 0xff};
+    const Color red = {.bgra = {0, 0, 0xff, 0xff}};
+    struct buf b;
+
+    buf_init(&b, DRW_FORMAT_ARGB8888, 2, 1, 0);
+    struct label_mask bad = {.depth = 2, .w = 2, .h = 1, .data = bits};
+    mask_blit(&b.t, &bad, 0, 0, red);
+    struct label_mask none = {.depth = 8, .w = 2, .h = 1, .data = NULL};
+    mask_blit(&b.t, &none, 0, 0, red);
+    CHECK(px(&b, 0, 0) == 0 && px(&b, 1, 0) == 0,
+          "a mask with a bad depth or no data drew something");
+}
+
+int
+main(void)
+{
+    test_stride();
+    test_1bpp();
+    test_alpha();
+    test_alpha_channel();
+    test_clipping();
+    test_rejects();
+    return failures ? 1 : 0;
+}
diff --git a/tests/test-pango.c b/tests/test-pango.c
new file mode 100644
index 0000000..5010898
--- /dev/null
+++ b/tests/test-pango.c
@@ -0,0 +1,88 @@
+/* The pango backend renders each label once into an 8 bpp mask. */
+#include <pango/pangocairo.h>
+#include <string.h>
+
+#include "check.h"
+#include "text-pango.h"
+#include "text.h"
+
+int
+main(void)
+{
+    int nfam;
+    PangoFontFamily **fam;
+    pango_font_map_list_families(pango_cairo_font_map_get_default(), &fam,
+                                 &nfam);
+    g_free(fam);
+    if (nfam == 0) {
+        fprintf(stderr, "no fonts installed, skipping\n");
+        return 77; /* meson's "skipped" */
+    }
+
+    struct text_font *font = text_font_new("Sans 14");
+    int lw, lh;
+    const struct label_mask *m = text_pango_mask(font, "Wq", 1.0, 0, 0, &lw, &lh);
+
+    CHECK(m != NULL, "no mask for a plain label");
+    if (m) {
+        CHECK(m->depth == 8 && m->w > 0 && m->h > 0, "mask is %ux%u at %u bpp",
+              m->w, m->h, m->depth);
+        CHECK(lw >= m->w && lh >= m->h, "logical box %dx%d smaller than ink",
+              lw, lh);
+        size_t stride = mask_stride(8, m->w);
+        unsigned lit = 0, pad = 0;
+        for (unsigned y = 0; y < m->h; y++)
+            for (size_t x = 0; x < stride; x++) {
+                if (x < m->w)
+                    lit += m->data[y * stride + x] != 0;
+                else
+                    pad += m->data[y * stride + x] != 0;
+            }
+        CHECK(lit > 0, "the mask is empty");
+        CHECK(pad == 0, "row padding is not zero");
+        CHECK(text_pango_mask(font, "Wq", 1.0, 0, 0, NULL, NULL) == m,
+              "the second lookup rendered again");
+
+        const struct label_mask *big =
+            text_pango_mask(font, "Wq", 2.0, 0, 0, NULL, NULL);
+        CHECK(big && big != m && big->h > m->h, "scale 2 is not taller");
+    }
+
+    /* a label longer than the key wraps instead of being clipped sideways */
+    {
+        const char *lbl = "alpha beta gamma delta";
+        int fw, fh, nw, nh;
+        const struct label_mask *flat =
+            text_pango_mask(font, lbl, 1.0, 0, 0, &fw, &fh);
+        const struct label_mask *wrapped =
+            text_pango_mask(font, lbl, 1.0, 60, 200, &nw, &nh);
+        CHECK(flat && wrapped, "no mask for a long label");
+        if (flat && wrapped) {
+            CHECK(fw > 60, "the long label is not wider than the key");
+            CHECK(nw <= 60, "wrapped label is %d wide, key is 60", nw);
+            CHECK(nh > fh, "wrapping did not add lines");
+        }
+        const struct label_mask *cut =
+            text_pango_mask(font, lbl, 1.0, 60, 20, &nw, &nh);
+        CHECK(cut && nh < 2 * fh, "height limit did not ellipsize");
+    }
+
+    CHECK(text_pango_mask(font, " ", 1.0, 0, 0, NULL, NULL) == NULL,
+          "a blank label has ink");
+
+    /* end to end through the blitter */
+    enum { W = 60, H = 30, STRIDE = W * 4 };
+    static uint8_t mem[STRIDE * H];
+    struct mask_target t = {.data = mem, .stride = STRIDE, .width = W,
+                            .height = H, .format = DRW_FORMAT_XRGB8888,
+                            .clip_x1 = W, .clip_y1 = H};
+    Color white = {.color = UINT32_MAX};
+    text_draw(font, "Wq", &t, 0, 0, W, H, 1, 1.0, white);
+    unsigned ink = 0;
+    for (size_t i = 0; i < sizeof(mem); i++)
+        ink += mem[i] != 0;
+    CHECK(ink > 0, "text_draw drew nothing");
+
+    text_font_free(font);
+    return failures ? 1 : 0;
+}
diff --git a/text-bitmap.c b/text-bitmap.c
new file mode 100644
index 0000000..78bf3ea
--- /dev/null
+++ b/text-bitmap.c
@@ -0,0 +1,222 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "text.h"
+#include "text-bitmap.h"
+
+struct text_font {
+    int unused; /* C forbids empty structs */
+};
+
+struct text_font *
+text_font_new(const char *description)
+{
+    static struct text_font only;
+    (void)description;
+    return &only;
+}
+
+void
+text_font_free(struct text_font *font)
+{
+    (void)font;
+}
+
+uint32_t
+bm_utf8_next(const char **s)
+{
+    const unsigned char *p = (const unsigned char *)*s;
+    uint32_t cp;
+    int n;
+
+    if (p[0] < 0x80) {
+        *s += 1;
+        return p[0];
+    } else if ((p[0] & 0xe0) == 0xc0) {
+        cp = p[0] & 0x1f, n = 1;
+    } else if ((p[0] & 0xf0) == 0xe0) {
+        cp = p[0] & 0x0f, n = 2;
+    } else if ((p[0] & 0xf8) == 0xf0) {
+        cp = p[0] & 0x07, n = 3;
+    } else {
+        *s += 1;
+        return 0xfffd;
+    }
+    for (int i = 1; i <= n; i++) {
+        if ((p[i] & 0xc0) != 0x80) {
+            *s += 1;
+            return 0xfffd;
+        }
+        cp = (cp << 6) | (p[i] & 0x3f);
+    }
+    /* overlong forms, surrogates and out-of-range values are not text */
+    static const uint32_t min[] = {0, 0x80, 0x800, 0x10000};
+    if (cp < min[n] || cp > 0x10ffff || (cp >= 0xd800 && cp < 0xe000)) {
+        *s += 1;
+        return 0xfffd;
+    }
+    *s += n + 1;
+    return cp;
+}
+
+static const struct bmglyph *
+find_glyph(const struct bmfont *font, uint32_t cp)
+{
+    uint32_t lo = 0, hi = font->nglyphs;
+    while (lo < hi) {
+        uint32_t mid = lo + (hi - lo) / 2;
+        if (font->glyphs[mid].cp == cp)
+            return &font->glyphs[mid];
+        if (font->glyphs[mid].cp < cp)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return NULL;
+}
+
+/* Enough for every symbol a layout can use without logging a second time; a
+ * layout with more missing glyphs gets one summary line instead of a flood. */
+#define MAX_LOGGED 64
+static uint32_t logged[MAX_LOGGED];
+static unsigned nlogged;
+static bool overflow_logged;
+
+static void
+log_missing(uint32_t cp, const struct bmfont *font)
+{
+    for (unsigned i = 0; i < nlogged; i++)
+        if (logged[i] == cp)
+            return;
+    if (nlogged == MAX_LOGGED) {
+        if (!overflow_logged)
+            fprintf(stderr, "wvkbd: more than %d glyphs missing from the "
+                            "built-in fonts, not logging the rest\n",
+                    MAX_LOGGED);
+        overflow_logged = true;
+        return;
+    }
+    logged[nlogged++] = cp;
+    fprintf(stderr, "wvkbd: no glyph for U+%04X in the %s font, drawing a box\n",
+            cp, font->name);
+}
+
+unsigned
+bm_missing_logged(void)
+{
+    return nlogged + overflow_logged;
+}
+
+/* An outline as wide as the glyph cell minus a column of spacing and as tall
+ * as a capital, built once per font. */
+static void
+box_mask(const struct bmfont *font, struct label_mask *mask, int *adv)
+{
+    static uint8_t bits[4][32 * 4];
+    static bool built[4];
+    unsigned idx = 0;
+    while (idx < nbmfonts && bmfonts[idx] != font)
+        idx++;
+    unsigned w = font->cell_w - 1, h = font->ascent - 1;
+    if (idx >= 4 || w > 32 || h > 32) {
+        *mask = (struct label_mask){0};
+        *adv = font->cell_w;
+        return;
+    }
+    if (!built[idx]) {
+        for (unsigned y = 0; y < h; y++) {
+            uint32_t row = (y == 0 || y == h - 1)
+                               ? ~0u << (32 - w)
+                               : (0x80000000u | (0x80000000u >> (w - 1)));
+            for (int b = 0; b < 4; b++)
+                bits[idx][y * 4 + b] = row >> (24 - 8 * b);
+        }
+        built[idx] = true;
+    }
+    *mask = (struct label_mask){.depth = 1, .w = w, .h = h, .bx = 0,
+                                .by = -(int)h, .data = bits[idx]};
+    *adv = font->cell_w;
+}
+
+void
+bm_glyph_mask(const struct bmfont *font, uint32_t cp, struct label_mask *mask,
+              int *adv)
+{
+    const struct bmglyph *g = find_glyph(font, cp);
+    if (!g) {
+        log_missing(cp, font);
+        box_mask(font, mask, adv);
+        return;
+    }
+    *mask = (struct label_mask){.depth = 1, .w = g->w, .h = g->h,
+                                .bx = g->bx, .by = g->by,
+                                .data = font->bits + g->off};
+    *adv = g->adv;
+}
+
+unsigned
+bm_label_width(const struct bmfont *font, const char *label)
+{
+    unsigned width = 0;
+    while (*label) {
+        struct label_mask m;
+        int adv;
+        bm_glyph_mask(font, bm_utf8_next(&label), &m, &adv);
+        width += adv;
+    }
+    return width;
+}
+
+const struct bmfont *
+bm_pick_font(const char *label, unsigned inner_w, unsigned inner_h)
+{
+    const struct bmfont *fits_height = NULL;
+    for (unsigned i = 0; i < nbmfonts; i++) {
+        const struct bmfont *f = bmfonts[i];
+        if (f->cell_h * 100u > inner_h * 85u)
+            continue;
+        fits_height = f;
+        if (bm_label_width(f, label) <= inner_w)
+            return f;
+    }
+    if (fits_height)
+        return fits_height;
+    static bool warned;
+    if (!warned)
+        fprintf(stderr, "wvkbd: keys are too short for the smallest built-in "
+                        "font (%s), text will be cramped\n",
+                bmfonts[nbmfonts - 1]->name);
+    warned = true;
+    return bmfonts[nbmfonts - 1];
+}
+
+void
+text_draw(struct text_font *font, const char *label,
+          const struct mask_target *target, int x, int y, int w, int h,
+          int border, double scale, Color color)
+{
+    (void)font;
+    (void)scale;
+    int iw = w - 2 * border, ih = h - 2 * border;
+    if (iw <= 0 || ih <= 0)
+        return;
+
+    struct mask_target t = *target;
+    if (t.clip_x0 < x + border) t.clip_x0 = x + border;
+    if (t.clip_y0 < y + border) t.clip_y0 = y + border;
+    if (t.clip_x1 > x + w - border) t.clip_x1 = x + w - border;
+    if (t.clip_y1 > y + h - border) t.clip_y1 = y + h - border;
+
+    const struct bmfont *f = bm_pick_font(label, iw, ih);
+    int pen = x + (w - (int)bm_label_width(f, label)) / 2;
+    int baseline = y + (h - f->cell_h) / 2 + f->ascent;
+
+    while (*label) {
+        struct label_mask m;
+        int adv;
+        bm_glyph_mask(f, bm_utf8_next(&label), &m, &adv);
+        mask_blit(&t, &m, pen, baseline, color);
+        pen += adv;
+    }
+}
diff --git a/text-bitmap.h b/text-bitmap.h
new file mode 100644
index 0000000..4f61fcc
--- /dev/null
+++ b/text-bitmap.h
@@ -0,0 +1,26 @@
+#ifndef TEXT_BITMAP_H
+#define TEXT_BITMAP_H
+
+#include "bmfont.h"
+#include "mask.h"
+
+/* The glyph for a code point as a mask with the pen at (0, baseline), or the
+ * box that stands in for a glyph the font lacks (logged once per code point).
+ * adv is the pen advance. */
+void bm_glyph_mask(const struct bmfont *font, uint32_t cp,
+                   struct label_mask *mask, int *adv);
+
+/* Largest font whose cell is at most 85 percent of inner_h and whose label
+ * fits inner_w; failing the width the smallest one that fits the height. */
+const struct bmfont *bm_pick_font(const char *label, unsigned inner_w,
+                                  unsigned inner_h);
+
+unsigned bm_label_width(const struct bmfont *font, const char *label);
+
+/* Decodes one UTF-8 sequence, U+FFFD for malformed input (one byte used). */
+uint32_t bm_utf8_next(const char **s);
+
+/* How many distinct code points have been reported missing so far. */
+unsigned bm_missing_logged(void);
+
+#endif
diff --git a/text-pango.c b/text-pango.c
new file mode 100644
index 0000000..d5f0f25
--- /dev/null
+++ b/text-pango.c
@@ -0,0 +1,200 @@
+#include <cairo.h>
+#include <pango/pangocairo.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "text.h"
+#include "text-pango.h"
+
+struct text_font {
+    PangoFontDescription *desc;
+};
+
+/* Rendering a label through pango costs a font lookup and shaping, which is
+ * far too slow for every key press on a 200 MHz CPU, so each label is
+ * rendered once into a mask and kept. */
+struct entry {
+    struct entry *next;
+    struct text_font *font;
+    double scale;
+    int inner_w, inner_h;
+    char *label;
+    struct label_mask mask;
+    int logical_w, logical_h;
+};
+
+#define NBUCKETS 256
+static struct entry *buckets[NBUCKETS];
+
+struct text_font *
+text_font_new(const char *description)
+{
+    struct text_font *f = calloc(1, sizeof(*f));
+    if (!f)
+        abort();
+    f->desc = pango_font_description_from_string(description);
+    return f;
+}
+
+static void
+entry_free(struct entry *e)
+{
+    free((void *)e->mask.data);
+    free(e->label);
+    free(e);
+}
+
+void
+text_font_free(struct text_font *font)
+{
+    /* entries point at the font, so they must not outlive it */
+    for (int i = 0; i < NBUCKETS; i++) {
+        for (struct entry **p = &buckets[i]; *p;) {
+            struct entry *e = *p;
+            if (e->font == font) {
+                *p = e->next;
+                entry_free(e);
+            } else {
+                p = &e->next;
+            }
+        }
+    }
+    pango_font_description_free(font->desc);
+    free(font);
+}
+
+static unsigned
+hash(const char *s, const void *font)
+{
+    unsigned h = 2166136261u ^ (unsigned)(size_t)font;
+    for (; *s; s++)
+        h = (h ^ (unsigned char)*s) * 16777619u;
+    return h % NBUCKETS;
+}
+
+static void
+render(struct entry *e)
+{
+    cairo_surface_t *probe =
+        cairo_image_surface_create(CAIRO_FORMAT_A8, 1, 1);
+    cairo_t *cr = cairo_create(probe);
+    PangoLayout *layout = pango_cairo_create_layout(cr);
+    PangoFontDescription *desc = pango_font_description_copy(e->font->desc);
+
+    if (e->scale != 1.0) {
+        int size = pango_font_description_get_size(desc) * e->scale;
+        if (pango_font_description_get_size_is_absolute(desc))
+            pango_font_description_set_absolute_size(desc, size);
+        else
+            pango_font_description_set_size(desc, size);
+    }
+    pango_layout_set_font_description(layout, desc);
+    pango_layout_set_auto_dir(layout, false);
+    pango_layout_set_text(layout, e->label, -1);
+    /* A label wider than its key wraps, and what still does not fit the key's
+     * height is ellipsized, as the cairo/pango drawing this replaces did. */
+    if (e->inner_w > 0 && e->inner_h > 0) {
+        pango_layout_set_width(layout, e->inner_w * PANGO_SCALE);
+        pango_layout_set_height(layout, e->inner_h * PANGO_SCALE);
+        pango_layout_set_wrap(layout, PANGO_WRAP_WORD_CHAR);
+        pango_layout_set_ellipsize(layout, PANGO_ELLIPSIZE_END);
+        pango_layout_set_alignment(layout, PANGO_ALIGN_CENTER);
+    }
+
+    PangoRectangle ink, logical;
+    pango_layout_get_pixel_extents(layout, &ink, &logical);
+    e->logical_w = logical.width;
+    e->logical_h = logical.height;
+
+    if (ink.width > 0 && ink.height > 0 && ink.width < 4096 &&
+        ink.height < 4096) {
+        cairo_surface_t *surf =
+            cairo_image_surface_create(CAIRO_FORMAT_A8, ink.width, ink.height);
+        cairo_t *scr = cairo_create(surf);
+        cairo_set_source_rgba(scr, 0, 0, 0, 1);
+        cairo_move_to(scr, -ink.x, -ink.y);
+        pango_cairo_update_layout(scr, layout);
+        pango_cairo_show_layout(scr, layout);
+        cairo_surface_flush(surf);
+
+        size_t stride = mask_stride(8, ink.width);
+        uint8_t *data = calloc(ink.height, stride);
+        if (data && cairo_status(scr) == CAIRO_STATUS_SUCCESS) {
+            const uint8_t *src = cairo_image_surface_get_data(surf);
+            int sstride = cairo_image_surface_get_stride(surf);
+            for (int y = 0; y < ink.height; y++)
+                memcpy(data + y * stride, src + (size_t)y * sstride, ink.width);
+            e->mask = (struct label_mask){
+                .depth = 8, .w = ink.width, .h = ink.height,
+                .bx = ink.x - logical.x, .by = ink.y - logical.y,
+                .data = data};
+        } else {
+            free(data);
+        }
+        cairo_destroy(scr);
+        cairo_surface_destroy(surf);
+    }
+
+    pango_font_description_free(desc);
+    g_object_unref(layout);
+    cairo_destroy(cr);
+    cairo_surface_destroy(probe);
+}
+
+const struct label_mask *
+text_pango_mask(struct text_font *font, const char *label, double scale,
+                int inner_w, int inner_h, int *logical_w, int *logical_h)
+{
+    unsigned b = hash(label, font);
+    struct entry *e;
+    for (e = buckets[b]; e; e = e->next)
+        if (e->font == font && e->scale == scale && e->inner_w == inner_w &&
+            e->inner_h == inner_h && !strcmp(e->label, label))
+            break;
+    if (!e) {
+        e = calloc(1, sizeof(*e));
+        if (!e)
+            return NULL;
+        e->font = font;
+        e->scale = scale;
+        e->inner_w = inner_w;
+        e->inner_h = inner_h;
+        e->label = strdup(label);
+        if (!e->label) {
+            free(e);
+            return NULL;
+        }
+        render(e);
+        e->next = buckets[b];
+        buckets[b] = e;
+    }
+    if (logical_w)
+        *logical_w = e->logical_w;
+    if (logical_h)
+        *logical_h = e->logical_h;
+    return e->mask.data ? &e->mask : NULL;
+}
+
+void
+text_draw(struct text_font *font, const char *label,
+          const struct mask_target *target, int x, int y, int w, int h,
+          int border, double scale, Color color)
+{
+    int iw = w - 2 * border, ih = h - 2 * border;
+    if (iw <= 0 || ih <= 0)
+        return;
+
+    int lw, lh;
+    const struct label_mask *m =
+        text_pango_mask(font, label, scale, iw, ih, &lw, &lh);
+    if (!m)
+        return;
+
+    struct mask_target t = *target;
+    if (t.clip_x0 < x + border) t.clip_x0 = x + border;
+    if (t.clip_y0 < y + border) t.clip_y0 = y + border;
+    if (t.clip_x1 > x + w - border) t.clip_x1 = x + w - border;
+    if (t.clip_y1 > y + h - border) t.clip_y1 = y + h - border;
+
+    mask_blit(&t, m, x + (w - lw) / 2, y + (h - lh) / 2, color);
+}
