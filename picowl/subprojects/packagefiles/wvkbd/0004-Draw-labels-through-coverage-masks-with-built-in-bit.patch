new file mode 100755
index 0000000..eab7619
--- /dev/null
+++ b/tools/regen-fonts.sh
@@ -0,0 +1,39 @@
+#!/bin/sh
+# Regenerates bmfont-data.c from the X.Org misc-fixed BDF sources. The output
+# is committed, so normal builds need neither the network nor python.
+set -e
+here=$(cd "$(dirname "$0")" && pwd)
+root=$here/..
+# A pinned revision and checksums, so the committed output can be reproduced
+# and a moved upstream branch is noticed instead of silently changing glyphs.
+rev=c4e2af05583764fae3d0b2aa20d5c93b031cbcbf
+base=https://gitlab.freedesktop.org/xorg/font/misc-misc/-/raw/$rev
+sha256_10x20=3480bcb4a20b67fe7fb88e01f179caf781954e642c3a7a77f325de1a435c1208
+sha256_6x13=c68c55ca8effcdc2714fffa9c8e07df290411867b00b547eeae952f7473efc9b
+tmp=$(mktemp -d)
+trap 'rm -rf "$tmp"' EXIT
+
+sha256() {
+	if command -v sha256sum >/dev/null 2>&1; then
+		sha256sum "$1" | cut -d' ' -f1
+	else
+		shasum -a 256 "$1" | cut -d' ' -f1
+	fi
+}
+
+for f in 10x20 6x13; do
+	curl -fsSL -o "$tmp/$f.bdf" "$base/$f.bdf"
+	want=$(eval echo "\$sha256_$f")
+	got=$(sha256 "$tmp/$f.bdf")
+	if [ "$got" != "$want" ]; then
+		echo "$f.bdf at $rev has sha256 $got, expected $want" >&2
+		exit 1
+	fi
+	# The generator re-checks this; failing here names the file early.
+	grep -q '^COPYRIGHT ".*[Pp]ublic domain' "$tmp/$f.bdf" ||
+		{ echo "$f.bdf is not marked public domain" >&2; exit 1; }
+done
+
+python3 "$here/bdf2c.py" -o "$root/bmfont-data.c" \
+	--layout "$root/layout.mobintl.h" --layout "$root/layout.deskintl.h" \
+	10x20="$tmp/10x20.bdf" 6x13="$tmp/6x13.bdf"
