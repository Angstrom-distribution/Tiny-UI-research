diff --git a/hold.c b/hold.c
new file mode 100644
index 0000000..a9dcd8e
--- /dev/null
+++ b/hold.c
@@ -0,0 +1,48 @@
+#include "hold.h"
+
+void
+hold_init(struct hold *h)
+{
+    h->pending = false;
+    h->due = 0;
+}
+
+bool
+hold_release(struct hold *h, int64_t press, int64_t release, int ms)
+{
+    int64_t due = press + ms;
+
+    /* a bad ms must not hold a key for ever */
+    if (ms <= 0 || ms > HOLD_MAX_MS || release >= due) {
+        h->pending = false;
+        return true;
+    }
+    h->pending = true;
+    h->due = due;
+    return false;
+}
+
+void
+hold_cancel(struct hold *h)
+{
+    h->pending = false;
+}
+
+bool
+hold_expired(const struct hold *h, int64_t now)
+{
+    return h->pending && now >= h->due;
+}
+
+int
+hold_timeout(const struct hold *h, int64_t now, int other_ms)
+{
+    if (!h->pending)
+        return other_ms;
+    int64_t wait = h->due - now;
+    if (wait < 0)
+        wait = 0;
+    if (other_ms >= 0 && other_ms < wait)
+        return other_ms;
+    return (int)wait;
+}
diff --git a/hold.h b/hold.h
new file mode 100644
index 0000000..95f7563
--- /dev/null
+++ b/hold.h
@@ -0,0 +1,42 @@
+#ifndef HOLD_H
+#define HOLD_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+/* How long a pressed key stays drawn highlighted, kept free of clocks and
+ * Wayland calls so the schedule can be tested: every time is a monotonic
+ * millisecond value that the caller passes in.
+ *
+ * A tap on a touchscreen lasts 35 to 76 ms, and the highlighted frame is
+ * replaced by the plain one right after the release. On a panel with a slow
+ * response that leaves the highlight on screen for far less than the eye
+ * needs, so the redraw of the plain key can be held back until a minimum time
+ * after the press. Only the redraw waits: the key event is sent at the true
+ * release time. */
+#define HOLD_MAX_MS 1000
+
+struct hold {
+    bool pending;
+    int64_t due; /* when the plain key is to be drawn again */
+};
+
+void hold_init(struct hold *h);
+
+/* The key went down at press and up at release. Returns true when the plain
+ * key is to be drawn at once (ms is 0, or the press lasted long enough),
+ * false when the redraw was scheduled and hold_expired will say when. */
+bool hold_release(struct hold *h, int64_t press, int64_t release, int ms);
+
+/* A new press, a hide or a redraw of the layer: whatever was scheduled is
+ * moot because the key is drawn right now or not at all. */
+void hold_cancel(struct hold *h);
+
+bool hold_expired(const struct hold *h, int64_t now);
+
+/* The poll() timeout: the nearer of the scheduled redraw and other_ms, the
+ * wait some other job needs (-1 for none, as poll takes it). -1 means wait
+ * for events only. */
+int hold_timeout(const struct hold *h, int64_t now, int other_ms);
+
+#endif
