diff --git a/tests/test-hold.c b/tests/test-hold.c
new file mode 100644
index 0000000..bcd370d
--- /dev/null
+++ b/tests/test-hold.c
@@ -0,0 +1,89 @@
+/* The highlight hold schedule. Every time is a made-up monotonic value, so
+ * nothing here depends on a clock. The 40 and 200 ms taps follow what a real
+ * iPAQ session logged: a tap lasts 35 to 76 ms. */
+#include "check.h"
+#include "hold.h"
+
+static void
+test_quick_tap(void)
+{
+    struct hold h;
+    hold_init(&h);
+    bool now = hold_release(&h, 1000, 1040, 150);
+    CHECK(!now, "a 40 ms tap with 150 ms is not drawn plain at the release");
+    CHECK(h.pending, "it is scheduled");
+    CHECK(h.due == 1150, "due at press + 150, got %lld", (long long)h.due);
+    CHECK(!hold_expired(&h, 1149), "not expired a millisecond early");
+    CHECK(hold_expired(&h, 1150), "expired at the deadline");
+    CHECK(hold_expired(&h, 5000), "and stays expired");
+}
+
+static void
+test_slow_press(void)
+{
+    struct hold h;
+    hold_init(&h);
+    CHECK(hold_release(&h, 1000, 1200, 150),
+          "a press longer than the hold is drawn plain at once");
+    CHECK(!h.pending && !hold_expired(&h, 1200), "nothing is left scheduled");
+    CHECK(hold_release(&h, 1000, 1150, 150),
+          "released exactly at the deadline is already long enough");
+}
+
+static void
+test_off(void)
+{
+    struct hold h;
+    hold_init(&h);
+    CHECK(hold_release(&h, 1000, 1010, 0), "0 is off: plain at once");
+    CHECK(!h.pending, "and nothing is scheduled");
+    CHECK(hold_release(&h, 1010, 1000, 0),
+          "off stays off when the release looks earlier than the press");
+    CHECK(hold_release(&h, 1000, 1010, -5), "a negative value is off too");
+    CHECK(hold_release(&h, 1000, 1010, HOLD_MAX_MS + 1),
+          "a value past the maximum never holds a key");
+    CHECK(!h.pending, "nothing scheduled for it either");
+}
+
+static void
+test_new_press_cancels(void)
+{
+    struct hold h;
+    hold_init(&h);
+    hold_release(&h, 1000, 1040, 150);
+    hold_cancel(&h);
+    CHECK(!h.pending, "cancel clears the schedule");
+    CHECK(!hold_expired(&h, 9999), "a cancelled schedule never expires");
+    CHECK(hold_timeout(&h, 1050, -1) == -1,
+          "and poll waits for events only again");
+    CHECK(hold_timeout(&h, 1050, 10) == 10, "or for the other job alone");
+}
+
+static void
+test_timeout(void)
+{
+    struct hold h;
+    hold_init(&h);
+    CHECK(hold_timeout(&h, 0, -1) == -1, "nothing to wait for: -1");
+    CHECK(hold_timeout(&h, 0, 10) == 10, "no hold: the other deadline");
+
+    hold_release(&h, 1000, 1040, 150); /* due 1150 */
+    CHECK(hold_timeout(&h, 1050, -1) == 100, "only the hold: the time left");
+    CHECK(hold_timeout(&h, 1050, 10) == 10, "the nearer one wins: repeat");
+    CHECK(hold_timeout(&h, 1050, 500) == 100, "the nearer one wins: hold");
+    CHECK(hold_timeout(&h, 1050, 100) == 100, "equal deadlines");
+    CHECK(hold_timeout(&h, 1150, -1) == 0, "due now: do not wait");
+    CHECK(hold_timeout(&h, 1300, 10) == 0, "overdue: do not wait");
+    CHECK(hold_timeout(&h, 1300, 0) == 0, "overdue and other due");
+}
+
+int
+main(void)
+{
+    test_quick_tap();
+    test_slow_press();
+    test_off();
+    test_new_press_cancels();
+    test_timeout();
+    return failures ? 1 : 0;
+}
diff --git a/wvkbd.1.scd b/wvkbd.1.scd
index 27a28bd..d9a6aa4 100644
--- a/wvkbd.1.scd
+++ b/wvkbd.1.scd
@@ -97,6 +97,15 @@ can be patched to add new features.
 	Don't highlight a key while it is pressed (draw it the same as an
 	unpressed key). Useful for privacy, e.g. when typing on a lockscreen.
 
+*--highlight-ms* _MS_
+	Keep a pressed key drawn highlighted until at least _MS_ milliseconds
+	after it was pressed, even when it is released sooner (0 to 1000, 0 draws
+	the plain key as soon as the button is up). A short tap lasts a few tens
+	of milliseconds, which a slow display may not show at all. Only the
+	redraw waits: the key release is still sent when it happens. The default
+	depends on the layout: 150 for the ipaq layout, 0 for the others. It has
+	no effect together with *--no-highlight*.
+
 *--no-feedback*
 	Disable all visual key-press feedback; shorthand for *--no-popup* and
 	*--no-highlight* together.
-- 
