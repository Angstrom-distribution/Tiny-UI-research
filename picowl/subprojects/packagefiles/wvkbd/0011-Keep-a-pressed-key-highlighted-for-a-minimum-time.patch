diff --git a/tests/check-highlight.sh b/tests/check-highlight.sh
new file mode 100755
index 0000000..c3bf307
--- /dev/null
+++ b/tests/check-highlight.sh
@@ -0,0 +1,52 @@
+#!/bin/sh
+# usage: check-highlight.sh BINARY CONFIG_HEADER
+# -D makes the binary report the resolved hold right after option parsing,
+# before it connects to Wayland, so this needs no compositor. The default is
+# read from the layout's config header, which proves the macro reaches the
+# binary.
+bin=$1
+cfg=$2
+want=$(sed -n 's/^#define DEFAULT_HIGHLIGHT_MS \([0-9][0-9]*\)$/\1/p' "$cfg")
+[ -n "$want" ] || { echo "no DEFAULT_HIGHLIGHT_MS in $cfg"; exit 1; }
+
+unset WAYLAND_DISPLAY WAYLAND_SOCKET
+export XDG_RUNTIME_DIR=${TMPDIR:-/tmp}
+
+state() {
+	"$bin" -D "$@" 2>&1 | sed -n 's/^wvkbd: highlight hold \([0-9]*\) ms$/\1/p'
+}
+expect() {
+	exp=$1; shift
+	got=$(state "$@")
+	[ "$got" = "$exp" ] || { echo "args '$*': got '$got', want '$exp'"; exit 1; }
+}
+# Without a compositor even a good command line ends in a failed connect, so
+# the exit status says nothing: a rejected value is one that stops before the
+# resolved value is reported, and that says why.
+rejected() {
+	out=$("$bin" -D "$@" 2>&1)
+	case $out in
+	*"highlight hold"*) echo "args '$*' were accepted"; exit 1 ;;
+	esac
+	case $out in
+	*usage:*) ;;
+	*) echo "args '$*' were not answered with the usage"; exit 1 ;;
+	esac
+}
+
+expect "$want"
+expect 0 --highlight-ms 0
+expect 150 --highlight-ms 150
+expect 1000 --highlight-ms 1000
+expect 70 --highlight-ms 100 --highlight-ms 70
+
+rejected --highlight-ms
+rejected --highlight-ms -1
+rejected --highlight-ms 1001
+rejected --highlight-ms abc
+rejected --highlight-ms 12x
+rejected --highlight-ms ''
+
+help=$("$bin" --help 2>&1)
+echo "$help" | grep -- '--highlight-ms' | grep -q "default $want" ||
+	{ echo "--help does not name --highlight-ms with its default $want"; exit 1; }
