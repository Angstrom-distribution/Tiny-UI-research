diff --git a/geometry.c b/geometry.c
new file mode 100644
index 0000000..5d0bf86
--- /dev/null
+++ b/geometry.c
@@ -0,0 +1,144 @@
+/* Key geometry, kept apart from keyboard.c because it needs neither Wayland
+ * nor xkbcommon: the build-time cache tool links it on the build machine. */
+#include <stdint.h>
+#include <string.h>
+
+#include "keyboard.h"
+
+uint32_t
+kbd_pick_height(bool landscape, uint32_t screen_w, uint32_t configured,
+                bool forced)
+{
+#ifdef KBD_DEFAULT_HEIGHT
+    if (!forced)
+        return KBD_DEFAULT_HEIGHT(screen_w, landscape);
+#endif
+    (void)landscape;
+    (void)screen_w;
+    (void)forced;
+    return configured;
+}
+
+uint8_t
+kbd_get_rows(struct layout *l)
+{
+    uint8_t rows = 0;
+    struct key *k = l->keys;
+    while (k->type != Last) {
+        if (k->type == EndRow) {
+            rows++;
+        }
+        k++;
+    }
+    return rows + 1;
+}
+
+void
+kbd_init_layout(struct layout *l, uint32_t width, uint32_t height)
+{
+    uint32_t y = 0;
+    uint8_t rows = kbd_get_rows(l);
+
+    l->keyheight = height / rows;
+
+    struct key *k = l->keys;
+    double rowlength = kbd_get_row_length(k);
+    double units = 0.0; /* widths of the keys of this row so far */
+    while (k->type != Last) {
+        if (k->type == EndRow) {
+            y += l->keyheight;
+            units = 0.0;
+            rowlength = kbd_get_row_length(k + 1);
+        } else if (k->width > 0) {
+            /* Both edges are rounded from the exact position, so the keys
+             * of a row always end exactly at the width. Rounding the
+             * accumulated pixel position as an upstream version did could
+             * be one pixel off after floating point error, and the last key
+             * then stuck out of the surface (seen at --width 200). */
+            uint32_t left = (uint32_t)(units * width / rowlength + 0.5);
+            units += k->width;
+            uint32_t right = (uint32_t)(units * width / rowlength + 0.5);
+            k->x = left;
+            k->y = y;
+            k->w = right - left;
+        }
+        k->h = l->keyheight;
+        k++;
+    }
+}
+
+double
+kbd_get_row_length(struct key *k)
+{
+    double l = 0.0;
+    while ((k->type != Last) && (k->type != EndRow)) {
+        l += k->width;
+        k++;
+    }
+    return l;
+}
+
+void
+kbd_each_label(struct layout *l, double scale, uint32_t popup_kbd_h,
+               kbd_label_fn fn, void *data)
+{
+    for (struct key *k = l->keys; k->type != Last; k++) {
+        if (k->type == Pad || k->type == EndRow)
+            continue;
+        /* The same boxes drw_draw_text computes for the key, and the same
+         * two labels key_label can pick: icons are shapes and an empty label
+         * draws nothing. */
+        struct drw_label_box box[2];
+        box[0] = drw_label_box(scale, k->x, k->y, k->w, k->h, KBD_KEY_BORDER);
+        int nbox = 1;
+        if (popup_kbd_h) {
+            /* The popup draws the key one keyboard height higher, and with a
+             * fractional scale the rounding of its edges then differs. */
+            box[1] = drw_label_box(scale, k->x, popup_kbd_h + k->y - k->h,
+                                   k->w, k->h, KBD_KEY_BORDER);
+            nbox = box[1].w == box[0].w && box[1].h == box[0].h ? 1 : 2;
+        }
+        const char *labels[2] = {k->label, k->shift_label};
+        for (int b = 0; b < nbox; b++) {
+            int iw = box[b].w - 2 * box[b].border;
+            int ih = box[b].h - 2 * box[b].border;
+            if (iw <= 0 || ih <= 0)
+                continue;
+            for (int i = 0; i < 2; i++) {
+                if (!labels[i] || !*labels[i] || drw_label_is_icon(labels[i]))
+                    continue;
+                fn(data, labels[i], iw, ih);
+            }
+        }
+    }
+}
+
+/* A cache made for other labels must not be used, and nothing else tells the
+ * reader that the layout changed, so the version is derived from the text. */
+uint32_t
+kbd_layout_version(void)
+{
+    uint32_t h = 2166136261u;
+    for (int i = 0; i < NumLayouts; i++) {
+        for (struct key *k = layouts[i].keys; k->type != Last; k++) {
+            const char *s[2] = {k->label, k->shift_label};
+            for (int j = 0; j < 2; j++) {
+                for (const char *p = s[j] ? s[j] : ""; *p; p++)
+                    h = (h ^ (unsigned char)*p) * 16777619u;
+                h = (h ^ 0xffu) * 16777619u;
+            }
+        }
+        h = (h ^ 0xfeu) * 16777619u;
+    }
+    return h;
+}
+
+#ifndef LAYOUT_NAME
+#define LAYOUT_NAME "wvkbd"
+#endif
+
+const char *
+kbd_layout_name(void)
+{
+    return LAYOUT_NAME;
+}
