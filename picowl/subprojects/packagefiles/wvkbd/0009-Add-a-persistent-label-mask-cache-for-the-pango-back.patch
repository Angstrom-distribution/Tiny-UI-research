diff --git a/Makefile b/Makefile
index b423012..5eccab2 100644
--- a/Makefile
+++ b/Makefile
@@ -11,8 +11,8 @@ MAN1 = ${NAME}.1
 TEXT ?= bitmap
 PKGS = wayland-client xkbcommon cairo
 ifeq ($(TEXT),pango)
-PKGS += pangocairo
-CFLAGS += -DTEXT_PANGO
+PKGS += pangocairo pangoft2 fontconfig
+CFLAGS += -DTEXT_PANGO -DHAVE_FONTCONFIG
 endif
 
 WVKBD_SOURCES += $(filter-out $(SRC)/text-%.c $(SRC)/bmfont-data.c, $(wildcard $(SRC)/*.c))
@@ -25,7 +25,7 @@ WVKBD_HEADERS += $(wildcard $(SRC)/*.h)
 WVKBD_DIR_SOURCES = $(foreach src, $(WVKBD_SOURCES), $(addprefix $(BUILDDIR)/, $(src)))
 
 PKG_CONFIG ?= pkg-config
-CFLAGS += -std=gnu99 -Wall -g -DWITH_WAYLAND_SHM -DLAYOUT=\"layout.${LAYOUT}.h\" -DKEYMAP=\"keymap.${LAYOUT}.h\"
+CFLAGS += -std=gnu99 -Wall -g -DWITH_WAYLAND_SHM -DLAYOUT=\"layout.${LAYOUT}.h\" -DLAYOUT_NAME=\"${LAYOUT}\" -DKEYMAP=\"keymap.${LAYOUT}.h\"
 CFLAGS += $(shell $(PKG_CONFIG) --cflags $(PKGS))
 LDFLAGS += $(shell $(PKG_CONFIG) --libs $(PKGS)) -lm -lutil -lrt
 
diff --git a/README.md b/README.md
index 7c275b9..8ee4674 100644
--- a/README.md
+++ b/README.md
@@ -48,6 +48,27 @@ libcairo may still pull in fontconfig transitively, depending on how cairo was b
 To use pango instead (any font, any script, at the cost of the extra libraries), build with `make TEXT=pango` or
 `meson setup build -Dtext=pango`. The font tables in `bmfont-data.c` are generated by `tools/regen-fonts.sh`.
 
+#### Label cache (pango text only)
+
+A pango build renders each label once into a mask. To spare a small machine the fontconfig scan and the
+shaping, the masks of a keyboard size are kept in one file in `--cache-dir` (default `/var/cache/wvkbd-ipaq`,
+set with `-Dcache_dir=...` at build time; `--no-cache` turns the cache off) and mapped read-only by every later start.
+
+- **First start:** the visible layer is rendered at once and the other layers while the keyboard is idle (two
+  labels per wake-up, after 10 ms of quiet), then the file is written once, atomically (temporary file, then rename).
+- **`wvkbd-ipaq --prerender [--screen WxH]`** does that work synchronously and exits with status 0 if the file was
+  written, and non-zero with a message if not; run it from a package post-install or first-boot hook.
+- **`-Dcache_tool=true`** builds `wvkbd-cache-gen DIR` with the native toolchain. It writes the files for 240x320,
+  320x240, 480x640 and 640x480 so that the target never runs pango. The output is byte for byte the same every time.
+  The tool is not installed.
+
+A file that is truncated, corrupt, from another format version, layout, geometry, scale or font is a miss: the
+labels are rendered and the file is written again. The font includes the file it resolves to (path, size and
+modification time) and the versions of pango, cairo, harfbuzz and fontconfig, so a font or library update makes the
+old file a miss and a new one is written beside it. Files made on another machine (`wvkbd-cache-gen`) are only used
+where those versions and that font file are the same. The file format is described in `cache.h` and in wvkbd(1).
+The bitmap text build has no cache and ignores these options.
+
 You also need [scdoc](https://git.sr.ht/~sircmpwn/scdoc/) to generate the documentation.
 
 The default set of layouts is called `mobintl` *(mobile international)*, which groups various layouts aimed at mobile devices
diff --git a/cache.c b/cache.c
new file mode 100644
index 0000000..daa4307
--- /dev/null
+++ b/cache.c
@@ -0,0 +1,518 @@
+#include <errno.h>
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "cache.h"
+
+#define MAX_FILE (64u << 20)
+#define MAX_MASK_DIM 4096
+static const uint8_t magic[8] = {'W', 'V', 'K', 'B', 'D', 'L', 'C', 1};
+
+/* Header field offsets, see cache.h. */
+enum {
+    H_VERSION = 8, H_HDRSIZE = 12, H_FILESIZE = 16, H_CRC = 20,
+    H_LAYOUTVER = 24, H_WIDTH = 28, H_HEIGHT = 32, H_SCALE = 36,
+    H_DEPTH = 40, H_COUNT = 44, H_FONTHASH = 48, H_LAYOUT = 56,
+    H_FONT = 88,
+};
+
+static void
+put16(uint8_t *p, uint32_t v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+    put16(p, v);
+    put16(p + 2, v >> 16);
+}
+
+static void
+put64(uint8_t *p, uint64_t v)
+{
+    put32(p, (uint32_t)v);
+    put32(p + 4, (uint32_t)(v >> 32));
+}
+
+static uint32_t
+get16(const uint8_t *p)
+{
+    return p[0] | (uint32_t)p[1] << 8;
+}
+
+static uint32_t
+get32(const uint8_t *p)
+{
+    return get16(p) | get16(p + 2) << 16;
+}
+
+static uint64_t
+get64(const uint8_t *p)
+{
+    return get32(p) | (uint64_t)get32(p + 4) << 32;
+}
+
+static uint64_t
+fnv64(uint64_t h, const void *data, size_t len)
+{
+    const uint8_t *p = data;
+    for (size_t i = 0; i < len; i++)
+        h = (h ^ p[i]) * 1099511628211ull;
+    return h;
+}
+
+uint64_t
+cache_key(const char *label, int inner_w, int inner_h)
+{
+    uint8_t box[9] = {0xff};
+    put32(box + 1, (uint32_t)inner_w);
+    put32(box + 5, (uint32_t)inner_h);
+    uint64_t h = fnv64(14695981039346656037ull, label, strlen(label));
+    return fnv64(h, box, sizeof(box));
+}
+
+uint64_t
+cache_identity_hash(const char *font, const char *env)
+{
+    /* the separator keeps "ab" + "c" apart from "a" + "bc" */
+    static const uint8_t sep = 0xff;
+    uint64_t h = fnv64(14695981039346656037ull, font, strlen(font));
+    h = fnv64(h, &sep, 1);
+    return env ? fnv64(h, env, strlen(env)) : h;
+}
+
+uint32_t
+cache_checksum(const uint8_t *file, size_t len)
+{
+    static uint32_t table[256];
+    if (!table[1]) {
+        for (uint32_t i = 0; i < 256; i++) {
+            uint32_t c = i;
+            for (int k = 0; k < 8; k++)
+                c = c & 1 ? 0xedb88320u ^ (c >> 1) : c >> 1;
+            table[i] = c;
+        }
+    }
+    uint32_t crc = 0xffffffffu;
+    for (size_t i = 0; i < len; i++) {
+        uint8_t b = (i >= H_CRC && i < H_CRC + 4) ? 0 : file[i];
+        crc = table[(crc ^ b) & 0xff] ^ (crc >> 8);
+    }
+    return ~crc;
+}
+
+static bool
+params_ok(const struct cache_params *p)
+{
+    return p->layout_name && p->font && strlen(p->layout_name) < CACHE_LAYOUT_LEN &&
+           strlen(p->font) < CACHE_FONT_LEN &&
+           (p->depth == 1 || p->depth == 4 || p->depth == 8);
+}
+
+/* The header a file for p starts with, apart from the sizes and the checksum.
+ * The reader compares against it byte for byte, which also rejects junk
+ * after the strings' NULs. */
+static void
+fill_header(uint8_t *h, const struct cache_params *p)
+{
+    memcpy(h, magic, sizeof(magic));
+    put32(h + H_VERSION, CACHE_FORMAT_VERSION);
+    put32(h + H_HDRSIZE, CACHE_HEADER_SIZE);
+    put32(h + H_LAYOUTVER, p->layout_version);
+    put32(h + H_WIDTH, p->width);
+    put32(h + H_HEIGHT, p->height);
+    put32(h + H_SCALE, p->scale_milli);
+    put32(h + H_DEPTH, p->depth);
+    put64(h + H_FONTHASH, cache_identity_hash(p->font, p->env));
+    strncpy((char *)h + H_LAYOUT, p->layout_name, CACHE_LAYOUT_LEN);
+    strncpy((char *)h + H_FONT, p->font, CACHE_FONT_LEN);
+}
+
+bool
+cache_path(char *path, size_t len, const char *dir,
+           const struct cache_params *p)
+{
+    if (!params_ok(p))
+        return false;
+    int n = snprintf(path, len, "%s/%s-%ux%u-s%u-%016llx.cache", dir,
+                     p->layout_name, p->width, p->height, p->scale_milli,
+                     (unsigned long long)cache_identity_hash(p->font, p->env));
+    return n > 0 && (size_t)n < len;
+}
+
+struct wr_ent {
+    const struct cache_item *item;
+    uint32_t offset;
+    uint16_t w, h;
+};
+
+static int
+cmp_ent(const void *a, const void *b)
+{
+    uint64_t ka = ((const struct wr_ent *)a)->item->key;
+    uint64_t kb = ((const struct wr_ent *)b)->item->key;
+    return ka < kb ? -1 : ka > kb;
+}
+
+static bool
+has_ink(const struct label_mask *m)
+{
+    return m->w > 0 && m->h > 0;
+}
+
+static bool
+same_mask(const struct label_mask *a, const struct label_mask *b)
+{
+    if (has_ink(a) != has_ink(b))
+        return false;
+    if (!has_ink(a))
+        return true;
+    return a->w == b->w && a->h == b->h &&
+           !memcmp(a->data, b->data, mask_stride(a->depth, a->w) * a->h);
+}
+
+static bool
+same_item(const struct cache_item *a, const struct cache_item *b)
+{
+    return a->logical_w == b->logical_w && a->logical_h == b->logical_h &&
+           a->mask.bx == b->mask.bx && a->mask.by == b->mask.by &&
+           same_mask(&a->mask, &b->mask);
+}
+
+static int
+fail(char *err, size_t errlen, const char *what, const char *path, int e)
+{
+    if (err && errlen) {
+        if (e)
+            snprintf(err, errlen, "%s %s: %s", what, path, strerror(e));
+        else
+            snprintf(err, errlen, "%s %s", what, path);
+    }
+    return -1;
+}
+
+static int
+write_all(int fd, const uint8_t *buf, size_t len)
+{
+    while (len) {
+        ssize_t n = write(fd, buf, len);
+        if (n < 0) {
+            if (errno == EINTR)
+                continue;
+            return -1;
+        }
+        buf += n;
+        len -= n;
+    }
+    return 0;
+}
+
+int
+cache_write(const char *dir, const struct cache_params *p,
+            const struct cache_item *items, size_t n, char *err, size_t errlen)
+{
+    char path[1024], tmp[1100];
+    if (!params_ok(p) || !cache_path(path, sizeof(path), dir, p))
+        return fail(err, errlen, "bad cache parameters for", dir, 0);
+    if (n > (1u << 20))
+        return fail(err, errlen, "too many labels for", path, 0);
+
+    struct wr_ent *ent = calloc(n ? n : 1, sizeof(*ent));
+    struct wr_ent *shared = calloc(n ? n : 1, sizeof(*shared));
+    uint8_t *file = NULL;
+    int fd = -1, ret = -1;
+    if (!ent || !shared) {
+        fail(err, errlen, "out of memory writing", path, 0);
+        goto out;
+    }
+    for (size_t i = 0; i < n; i++)
+        ent[i].item = &items[i];
+    qsort(ent, n, sizeof(*ent), cmp_ent);
+
+    /* Merge equal keys, and place every distinct mask once. */
+    size_t count = 0, nshared = 0;
+    uint64_t data_size = 0;
+    for (size_t i = 0; i < n; i++) {
+        const struct cache_item *it = ent[i].item;
+        if (count && ent[count - 1].item->key == it->key) {
+            if (!same_item(ent[count - 1].item, it)) {
+                fail(err, errlen, "two different labels share a key in", path, 0);
+                goto out;
+            }
+            continue;
+        }
+        const struct label_mask *m = &it->mask;
+        if ((m->w && m->h) &&
+            (!m->data || m->depth != p->depth || m->w > MAX_MASK_DIM ||
+             m->h > MAX_MASK_DIM)) {
+            fail(err, errlen, "unusable mask for", path, 0);
+            goto out;
+        }
+        ent[count] = ent[i];
+        ent[count].w = has_ink(m) ? m->w : 0;
+        ent[count].h = has_ink(m) ? m->h : 0;
+        ent[count].offset = 0;
+        if (has_ink(m)) {
+            size_t j;
+            for (j = 0; j < nshared; j++)
+                if (same_mask(&shared[j].item->mask, m))
+                    break;
+            if (j == nshared) {
+                shared[nshared].item = it;
+                shared[nshared].offset = 0; /* set below */
+                data_size += mask_stride(p->depth, m->w) * m->h;
+                nshared++;
+            }
+        }
+        count++;
+    }
+
+    size_t index_end = CACHE_HEADER_SIZE + count * CACHE_INDEX_SIZE;
+    if (data_size > MAX_FILE || index_end + data_size > MAX_FILE) {
+        fail(err, errlen, "cache too large:", path, 0);
+        goto out;
+    }
+    size_t total = index_end + data_size;
+    file = calloc(1, total);
+    if (!file) {
+        fail(err, errlen, "out of memory writing", path, 0);
+        goto out;
+    }
+    fill_header(file, p);
+    put32(file + H_FILESIZE, total);
+    put32(file + H_COUNT, count);
+
+    size_t next = index_end;
+    for (size_t j = 0; j < nshared; j++) {
+        const struct label_mask *m = &shared[j].item->mask;
+        size_t size = mask_stride(p->depth, m->w) * m->h;
+        memcpy(file + next, m->data, size);
+        shared[j].offset = next;
+        next += size;
+    }
+    for (size_t i = 0; i < count; i++) {
+        const struct label_mask *m = &ent[i].item->mask;
+        uint32_t off = 0;
+        if (has_ink(m)) {
+            for (size_t j = 0; j < nshared; j++)
+                if (same_mask(&shared[j].item->mask, m)) {
+                    off = shared[j].offset;
+                    break;
+                }
+        }
+        uint8_t *e = file + CACHE_HEADER_SIZE + i * CACHE_INDEX_SIZE;
+        put64(e, ent[i].item->key);
+        put32(e + 8, off);
+        put16(e + 12, ent[i].w);
+        put16(e + 14, ent[i].h);
+        put16(e + 16, (uint16_t)m->bx);
+        put16(e + 18, (uint16_t)m->by);
+        put16(e + 20, ent[i].item->logical_w);
+        put16(e + 22, ent[i].item->logical_h);
+    }
+    put32(file + H_CRC, cache_checksum(file, total));
+
+    /* Same directory as the target, or the rename could cross file systems
+     * and stop being atomic. */
+    if (mkdir(dir, 0755) < 0 && errno != EEXIST) {
+        fail(err, errlen, "cannot create", dir, errno);
+        goto out;
+    }
+    const char *base = strrchr(path, '/') + 1;
+    snprintf(tmp, sizeof(tmp), "%.*s/.%s.XXXXXX", (int)(base - path - 1), path,
+             base);
+    fd = mkstemp(tmp);
+    if (fd < 0) {
+        fail(err, errlen, "cannot create a temporary file in", dir, errno);
+        goto out;
+    }
+    if (write_all(fd, file, total) < 0) {
+        fail(err, errlen, "cannot write", tmp, errno);
+        goto unlink_tmp;
+    }
+    /* The data must be on disk before the name points at it. */
+    if (fsync(fd) < 0 || fchmod(fd, 0644) < 0) {
+        fail(err, errlen, "cannot sync", tmp, errno);
+        goto unlink_tmp;
+    }
+    if (close(fd) < 0) {
+        fd = -1;
+        fail(err, errlen, "cannot close", tmp, errno);
+        goto unlink_tmp;
+    }
+    fd = -1;
+    if (rename(tmp, path) < 0) {
+        fail(err, errlen, "cannot rename onto", path, errno);
+        goto unlink_tmp;
+    }
+    ret = 0;
+    goto out;
+
+unlink_tmp:
+    unlink(tmp);
+out:
+    if (fd >= 0)
+        close(fd);
+    free(file);
+    free(shared);
+    free(ent);
+    return ret;
+}
+
+struct cache {
+    const uint8_t *base;
+    size_t len, count;
+    uint32_t depth;
+    void *map; /* non-NULL when base is an mmap */
+};
+
+/* Every offset and size is checked here, once, so that a lookup afterwards
+ * can hand out pointers without looking at the file again. */
+static bool
+validate_file(const uint8_t *b, size_t len, const struct cache_params *p,
+              size_t *count_out)
+{
+    if (!params_ok(p) || len < CACHE_HEADER_SIZE || len > MAX_FILE)
+        return false;
+    uint8_t want[CACHE_HEADER_SIZE] = {0};
+    fill_header(want, p);
+    /* The sizes, the checksum and the count are the file's own and are
+     * checked below; everything else must match what we asked for. */
+    if (memcmp(b, want, H_FILESIZE) ||
+        memcmp(b + H_LAYOUTVER, want + H_LAYOUTVER, H_COUNT - H_LAYOUTVER) ||
+        memcmp(b + H_FONTHASH, want + H_FONTHASH,
+               CACHE_HEADER_SIZE - H_FONTHASH))
+        return false;
+    if (get32(b + H_FILESIZE) != len)
+        return false;
+    if (get32(b + H_CRC) != cache_checksum(b, len))
+        return false;
+    uint64_t count = get32(b + H_COUNT);
+    uint64_t data_start = CACHE_HEADER_SIZE + count * CACHE_INDEX_SIZE;
+    if (data_start > len)
+        return false;
+    unsigned depth = p->depth;
+    uint64_t prev = 0;
+    for (uint64_t i = 0; i < count; i++) {
+        const uint8_t *e = b + CACHE_HEADER_SIZE + i * CACHE_INDEX_SIZE;
+        uint64_t key = get64(e);
+        /* strictly ascending, so the binary search is sound and no key is
+         * there twice */
+        if (i && key <= prev)
+            return false;
+        prev = key;
+        uint64_t off = get32(e + 8), w = get16(e + 12), h = get16(e + 14);
+        if (!w || !h) {
+            if (w || h || off)
+                return false;
+            continue;
+        }
+        if (w > MAX_MASK_DIM || h > MAX_MASK_DIM)
+            return false;
+        uint64_t size = (uint64_t)mask_stride(depth, w) * h;
+        if (off % 4 || off < data_start || off > len || size > len - off)
+            return false;
+    }
+    *count_out = count;
+    return true;
+}
+
+struct cache *
+cache_open_buffer(const void *buf, size_t len, const struct cache_params *p)
+{
+    size_t count;
+    if (!validate_file(buf, len, p, &count))
+        return NULL;
+    struct cache *c = calloc(1, sizeof(*c));
+    if (!c)
+        return NULL;
+    c->base = buf;
+    c->len = len;
+    c->count = count;
+    c->depth = p->depth;
+    return c;
+}
+
+struct cache *
+cache_open(const char *dir, const struct cache_params *p)
+{
+    char path[1024];
+    if (!cache_path(path, sizeof(path), dir, p))
+        return NULL;
+    int fd = open(path, O_RDONLY | O_CLOEXEC);
+    if (fd < 0)
+        return NULL;
+    struct stat st;
+    void *map = MAP_FAILED;
+    if (fstat(fd, &st) == 0 && S_ISREG(st.st_mode) &&
+        st.st_size >= CACHE_HEADER_SIZE && st.st_size <= MAX_FILE)
+        map = mmap(NULL, st.st_size, PROT_READ, MAP_PRIVATE, fd, 0);
+    close(fd);
+    if (map == MAP_FAILED)
+        return NULL;
+    struct cache *c = cache_open_buffer(map, st.st_size, p);
+    if (!c) {
+        munmap(map, st.st_size);
+        return NULL;
+    }
+    c->map = map;
+    return c;
+}
+
+bool
+cache_item_at(const struct cache *c, size_t i, struct cache_item *out)
+{
+    if (i >= c->count)
+        return false;
+    const uint8_t *e = c->base + CACHE_HEADER_SIZE + i * CACHE_INDEX_SIZE;
+    uint32_t w = get16(e + 12), h = get16(e + 14);
+    out->key = get64(e);
+    out->mask = (struct label_mask){
+        .depth = c->depth, .w = w, .h = h,
+        .bx = (int16_t)get16(e + 16), .by = (int16_t)get16(e + 18),
+        .data = w && h ? c->base + get32(e + 8) : NULL};
+    out->logical_w = get16(e + 20);
+    out->logical_h = get16(e + 22);
+    return true;
+}
+
+bool
+cache_lookup(const struct cache *c, uint64_t key, struct cache_item *out)
+{
+    size_t lo = 0, hi = c->count;
+    while (lo < hi) {
+        size_t mid = lo + (hi - lo) / 2;
+        uint64_t k = get64(c->base + CACHE_HEADER_SIZE + mid * CACHE_INDEX_SIZE);
+        if (k == key)
+            return cache_item_at(c, mid, out);
+        if (k < key)
+            lo = mid + 1;
+        else
+            hi = mid;
+    }
+    return false;
+}
+
+size_t
+cache_count(const struct cache *c)
+{
+    return c->count;
+}
+
+void
+cache_close(struct cache *c)
+{
+    if (!c)
+        return;
+    if (c->map)
+        munmap(c->map, c->len);
+    free(c);
+}
diff --git a/cache.h b/cache.h
new file mode 100644
index 0000000..b663ea2
--- /dev/null
+++ b/cache.h
@@ -0,0 +1,106 @@
+#ifndef CACHE_H
+#define CACHE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+#include "mask.h"
+
+/* The persistent label mask cache: every mask of a keyboard geometry in one
+ * file that a later start maps instead of asking pango to render again.
+ *
+ * File format version 2, all integers little endian:
+ *
+ *   offset size  field
+ *        0    8  magic "WVKBDLC\1"
+ *        8    4  format version (2)
+ *       12    4  header size (216)
+ *       16    4  file size
+ *       20    4  CRC-32 of the whole file, this field counted as zero
+ *       24    4  layout version (derived from the label text)
+ *       28    4  keyboard width in pixels
+ *       32    4  keyboard height in pixels
+ *       36    4  surface scale times 1000
+ *       40    4  mask depth in bits per pixel (1, 4 or 8)
+ *       44    4  label count
+ *       48    8  hash of the font description and of the environment
+ *       56   32  layout name, NUL padded
+ *       88  128  font description, NUL padded
+ *      216       index, label count entries of 24 bytes, sorted by key:
+ *                  0 8 key (hash of label and key box)
+ *                  8 4 offset of the mask data in the file
+ *                 12 2 width   14 2 height   (0 and 0: the label has no ink)
+ *                 16 2 bearing x   18 2 bearing y   (signed)
+ *                 20 2 logical width   22 2 logical height
+ *      after the index: mask data, every mask at a multiple of 4 bytes, rows
+ *                padded to 4 bytes as mask_stride() says. Equal masks are
+ *                stored once and several index entries point at them.
+ *
+ * Nothing in the file is a timestamp or an address, so the same input gives
+ * the same bytes. */
+
+#define CACHE_FORMAT_VERSION 2
+#define CACHE_HEADER_SIZE 216
+#define CACHE_INDEX_SIZE 24
+#define CACHE_LAYOUT_LEN 32
+#define CACHE_FONT_LEN 128
+
+/* What a file must have been made for to be of use. */
+struct cache_params {
+	const char *layout_name;
+	uint32_t layout_version;
+	uint32_t width, height;
+	uint32_t scale_milli;
+	const char *font;
+	/* What else the masks depend on and the font description does not say:
+	 * library versions and the font file behind the description. Only its
+	 * hash is stored, in the file and in the file name, so a changed
+	 * environment is a miss. NULL is the same as "". */
+	const char *env;
+	uint32_t depth;
+};
+
+struct cache_item {
+	uint64_t key;
+	struct label_mask mask;
+	uint16_t logical_w, logical_h;
+};
+
+/* The key of a label drawn in a box of inner_w x inner_h pixels: the same
+ * text wraps differently in a key of another size. */
+uint64_t cache_key(const char *label, int inner_w, int inner_h);
+uint64_t cache_identity_hash(const char *font, const char *env);
+/* CRC-32 of a whole file image with its checksum field counted as zero. */
+uint32_t cache_checksum(const uint8_t *file, size_t len);
+
+/* Writes the file name for the parameters into path. False if too long. */
+bool cache_path(char *path, size_t len, const char *dir,
+                const struct cache_params *p);
+
+/* Writes the cache for the parameters, replacing any earlier one in one step:
+ * the data goes to a temporary file in the same directory, which is renamed
+ * over the final name only when it is complete, so a reader never sees half a
+ * file and a failure leaves the old file in place. The directory is created
+ * if it is missing. Items with equal keys are merged when they are equal and
+ * rejected otherwise. Returns 0, or -1 with a message in err. */
+int cache_write(const char *dir, const struct cache_params *p,
+                const struct cache_item *items, size_t n, char *err,
+                size_t errlen);
+
+struct cache;
+/* Maps the file read-only and checks it against the parameters. NULL means
+ * a miss for any reason: no file, wrong size, wrong checksum, made for other
+ * parameters, or an offset or size that does not fit the file. */
+struct cache *cache_open(const char *dir, const struct cache_params *p);
+/* The same checks on memory the caller keeps alive. */
+struct cache *cache_open_buffer(const void *buf, size_t len,
+                                const struct cache_params *p);
+/* The mask data of a found item points into the file, so it is valid until
+ * cache_close. */
+bool cache_lookup(const struct cache *c, uint64_t key, struct cache_item *out);
+size_t cache_count(const struct cache *c);
+bool cache_item_at(const struct cache *c, size_t i, struct cache_item *out);
+void cache_close(struct cache *c);
+
+#endif
