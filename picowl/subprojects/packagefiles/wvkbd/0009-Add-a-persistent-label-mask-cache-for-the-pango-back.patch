new file mode 100644
index 0000000..9801c2a
--- /dev/null
+++ b/prerender.c
@@ -0,0 +1,32 @@
+#include "keyboard.h"
+#include "prerender.h"
+#include "text.h"
+
+static void
+want_label(void *data, const char *label, int inner_w, int inner_h)
+{
+    (void)data;
+    text_cache_want(label, inner_w, inner_h);
+}
+
+int
+kbd_prerender(const char *dir, const char *font_desc, uint32_t w, uint32_t h,
+              double scale, bool popup, char *err, size_t errlen)
+{
+    /* the labels' boxes depend on the key sizes, which depend on the size */
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_init_layout(&layouts[i], w, h);
+
+    struct text_font *font = text_font_new(font_desc);
+    struct text_cache_config cfg = {
+        .dir = dir, .layout_name = kbd_layout_name(),
+        .layout_version = kbd_layout_version(), .width = w, .height = h,
+        .scale = scale, .read = false};
+    text_cache_attach(font, &cfg);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_each_label(&layouts[i], scale, popup ? h : 0, want_label, NULL);
+    int ret = text_cache_flush(err, errlen);
+    text_cache_attach(NULL, NULL);
+    text_font_free(font);
+    return ret;
+}
