diff --git a/tests/test-cache.c b/tests/test-cache.c
new file mode 100644
index 0000000..7c6daf9
--- /dev/null
+++ b/tests/test-cache.c
@@ -0,0 +1,721 @@
+/* The label cache file: round trip, determinism, and a reader that treats
+ * every damaged or hostile file as a miss without reading outside it. Needs
+ * no pango, so it runs in every build. */
+#include <dirent.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <signal.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cache.h"
+#include "check.h"
+
+static char root[256];
+
+static const struct cache_params params = {
+    .layout_name = "ipaq", .layout_version = 0x1234abcd, .width = 240,
+    .height = 100, .scale_milli = 1000, .font = "Sans 8", .depth = 8};
+
+/* a deterministic mask whose pixels depend on seed, w and h only */
+static uint8_t *
+make_data(unsigned depth, unsigned w, unsigned h, unsigned seed)
+{
+    size_t stride = mask_stride(depth, w);
+    uint8_t *d = calloc(h, stride);
+    unsigned x = seed * 2654435761u + 1;
+    for (unsigned r = 0; r < h; r++)
+        for (size_t i = 0; i < (w * depth + 7) / 8; i++) {
+            x = x * 1664525u + 1013904223u;
+            d[r * stride + i] = x >> 24;
+        }
+    return d;
+}
+
+#define NITEMS 40
+static struct cache_item items[NITEMS];
+static unsigned nitems;
+
+/* NITEMS keys of which the ones divisible by 5 have no ink and the ones
+ * divisible by 7 repeat the mask of key 1, so there is sharing to check */
+static void
+make_items(unsigned depth, bool reverse)
+{
+    for (unsigned i = 0; i < nitems; i++)
+        free((void *)items[i].mask.data);
+    nitems = NITEMS;
+    for (unsigned n = 0; n < NITEMS; n++) {
+        unsigned i = reverse ? NITEMS - 1 - n : n;
+        unsigned seed = i % 7 == 0 ? 1 : i;
+        unsigned w = 3 + seed % 17, h = 4 + seed % 13;
+        struct cache_item *it = &items[n];
+        it->key = cache_key("label", i, i * 3);
+        it->logical_w = 10 + i;
+        it->logical_h = 12 + i;
+        if (i % 5 == 0) {
+            it->mask = (struct label_mask){.depth = depth, .bx = 0, .by = 0};
+        } else {
+            it->mask = (struct label_mask){
+                .depth = depth, .w = w, .h = h, .bx = (int16_t)(i - 20),
+                .by = (int16_t)(2 * i), .data = make_data(depth, w, h, seed)};
+        }
+    }
+}
+
+static size_t
+mask_size(const struct label_mask *m)
+{
+    return mask_stride(m->depth, m->w) * m->h;
+}
+
+static uint8_t *
+slurp(const char *path, size_t *len)
+{
+    FILE *f = fopen(path, "rb");
+    if (!f)
+        return NULL;
+    fseek(f, 0, SEEK_END);
+    *len = ftell(f);
+    rewind(f);
+    uint8_t *b = malloc(*len ? *len : 1);
+    if (fread(b, 1, *len, f) != *len) {
+        free(b);
+        b = NULL;
+    }
+    fclose(f);
+    return b;
+}
+
+static void
+spit(const char *path, const uint8_t *b, size_t len)
+{
+    FILE *f = fopen(path, "wb");
+    if (f) {
+        fwrite(b, 1, len, f);
+        fclose(f);
+    }
+}
+
+static char *
+make_dir(const char *name)
+{
+    static char path[4][320];
+    static int n;
+    char *p = path[n++ % 4];
+    snprintf(p, 320, "%s/%s", root, name);
+    mkdir(p, 0755);
+    return p;
+}
+
+static unsigned
+count_files(const char *dir)
+{
+    unsigned n = 0;
+    DIR *d = opendir(dir);
+    for (struct dirent *e; d && (e = readdir(d));)
+        n += e->d_name[0] != '.' || (e->d_name[1] && strcmp(e->d_name, ".."));
+    if (d)
+        closedir(d);
+    return n;
+}
+
+/* every byte of every mask, so that a bad offset reads outside the buffer
+ * where a sanitizer can see it */
+static unsigned
+touch_all(const struct cache *c)
+{
+    unsigned sum = 0;
+    for (size_t i = 0; i < cache_count(c); i++) {
+        struct cache_item it;
+        if (!cache_item_at(c, i, &it))
+            return ~0u;
+        size_t size = it.mask.w && it.mask.h ? mask_size(&it.mask) : 0;
+        for (size_t k = 0; k < size; k++)
+            sum += it.mask.data[k];
+    }
+    return sum;
+}
+
+static void
+same_items(const struct cache *c, const char *what)
+{
+    for (unsigned i = 0; i < NITEMS; i++) {
+        struct cache_item got;
+        const struct cache_item *want = &items[i];
+        bool ink = want->mask.w && want->mask.h;
+        if (!cache_lookup(c, want->key, &got)) {
+            CHECK(0, "%s: key %u not found", what, i);
+            continue;
+        }
+        CHECK(got.mask.depth == want->mask.depth && got.mask.bx == want->mask.bx &&
+                  got.mask.by == want->mask.by &&
+                  got.logical_w == want->logical_w &&
+                  got.logical_h == want->logical_h,
+              "%s: key %u metrics differ", what, i);
+        CHECK(got.mask.w == want->mask.w && got.mask.h == want->mask.h,
+              "%s: key %u size %ux%u, wanted %ux%u", what, i, got.mask.w,
+              got.mask.h, want->mask.w, want->mask.h);
+        if (ink && got.mask.w == want->mask.w && got.mask.h == want->mask.h)
+            CHECK(!memcmp(got.mask.data, want->mask.data, mask_size(&want->mask)),
+                  "%s: key %u mask differs", what, i);
+        else if (!ink)
+            CHECK(got.mask.data == NULL, "%s: key %u has data without ink", what, i);
+    }
+    struct cache_item none;
+    CHECK(!cache_lookup(c, cache_key("absent", 1, 1), &none),
+          "%s: an absent key was found", what);
+}
+
+static char err[512];
+
+static void
+write_ok(const char *dir, const struct cache_params *p)
+{
+    int r = cache_write(dir, p, items, nitems, err, sizeof(err));
+    CHECK(r == 0, "cache_write: %s", err);
+}
+
+static void
+test_round_trip(void)
+{
+    static const unsigned depths[] = {8, 4, 1};
+    for (int d = 0; d < 3; d++) {
+        struct cache_params p = params;
+        p.depth = depths[d];
+        make_items(p.depth, false);
+        char *dir = make_dir("rt");
+        write_ok(dir, &p);
+        struct cache *c = cache_open(dir, &p);
+        CHECK(c != NULL, "depth %u: the file just written is a miss", p.depth);
+        if (!c)
+            continue;
+        CHECK(cache_count(c) == NITEMS, "count %zu", cache_count(c));
+        same_items(c, "round trip");
+
+        /* the index is sorted, and equal masks are stored once */
+        uint64_t prev = 0;
+        const uint8_t *shared = NULL;
+        unsigned sharing = 0;
+        for (size_t i = 0; i < cache_count(c); i++) {
+            struct cache_item it;
+            cache_item_at(c, i, &it);
+            CHECK(i == 0 || it.key > prev, "index not sorted at %zu", i);
+            prev = it.key;
+            CHECK(((uintptr_t)it.mask.data & 3) == 0, "unaligned mask data");
+        }
+        for (unsigned i = 0; i < NITEMS; i += 7) {
+            struct cache_item it;
+            cache_lookup(c, items[i].key, &it);
+            if (i % 5 == 0)
+                continue; /* no ink */
+            if (!shared)
+                shared = it.mask.data;
+            sharing += it.mask.data == shared;
+        }
+        CHECK(sharing >= 4, "identical masks are not shared (%u)", sharing);
+        cache_close(c);
+
+        char path[1024];
+        cache_path(path, sizeof(path), dir, &p);
+        struct stat st;
+        stat(path, &st);
+        size_t total = 0;
+        for (unsigned i = 0; i < NITEMS; i++)
+            total += mask_size(&items[i].mask);
+        CHECK((size_t)st.st_size < CACHE_HEADER_SIZE + NITEMS * CACHE_INDEX_SIZE + total,
+              "sharing saved nothing: %lld bytes", (long long)st.st_size);
+        CHECK(count_files(dir) == 1, "directory holds %u files", count_files(dir));
+        unlink(path);
+    }
+}
+
+static void
+test_deterministic(void)
+{
+    make_items(8, false);
+    char *a = make_dir("det-a");
+    write_ok(a, &params);
+    make_items(8, true); /* same content, other order of arrival */
+    char *b = make_dir("det-b");
+    write_ok(b, &params);
+    char pa[1024], pb[1024];
+    cache_path(pa, sizeof(pa), a, &params);
+    cache_path(pb, sizeof(pb), b, &params);
+    size_t la, lb;
+    uint8_t *fa = slurp(pa, &la), *fb = slurp(pb, &lb);
+    CHECK(fa && fb && la == lb && !memcmp(fa, fb, la),
+          "the same labels written in another order give another file");
+    free(fa);
+    free(fb);
+}
+
+static void
+fix_checksum(uint8_t *f, size_t len)
+{
+    uint32_t c = cache_checksum(f, len);
+    f[20] = c;
+    f[21] = c >> 8;
+    f[22] = c >> 16;
+    f[23] = c >> 24;
+}
+
+static void
+put32(uint8_t *p, uint32_t v)
+{
+    p[0] = v;
+    p[1] = v >> 8;
+    p[2] = v >> 16;
+    p[3] = v >> 24;
+}
+
+/* what the reader says to an image, in a buffer of exactly its size so that a
+ * sanitizer sees any read beyond it */
+static bool
+accepts(const uint8_t *img, size_t len, const struct cache_params *p)
+{
+    uint8_t *copy = malloc(len ? len : 1);
+    memcpy(copy, img, len);
+    struct cache *c = cache_open_buffer(copy, len, p);
+    bool ok = c != NULL;
+    if (c) {
+        touch_all(c);
+        for (unsigned i = 0; i < NITEMS; i++) {
+            struct cache_item it;
+            cache_lookup(c, items[i].key, &it);
+        }
+        cache_close(c);
+    }
+    free(copy);
+    return ok;
+}
+
+static void
+test_damage(void)
+{
+    make_items(8, false);
+    char *dir = make_dir("dmg");
+    write_ok(dir, &params);
+    char path[1024];
+    cache_path(path, sizeof(path), dir, &params);
+    size_t len;
+    uint8_t *img = slurp(path, &len);
+    if (!img) {
+        CHECK(0, "cannot read back the cache");
+        return;
+    }
+    size_t index_end = CACHE_HEADER_SIZE + NITEMS * CACHE_INDEX_SIZE;
+    CHECK(accepts(img, len, &params), "the intact image is a miss");
+
+    /* One flipped byte anywhere: the checksum must catch it. Counted by the
+     * region of the file it is in. */
+    unsigned hdr = 0, idx = 0, data = 0, missed = 0;
+    for (size_t i = 0; i < len; i++) {
+        img[i] ^= 0x10;
+        if (accepts(img, len, &params)) {
+            missed++;
+            CHECK(0, "a flipped byte at offset %zu was accepted", i);
+        }
+        img[i] ^= 0x10;
+        if (i < CACHE_HEADER_SIZE)
+            hdr++;
+        else if (i < index_end)
+            idx++;
+        else
+            data++;
+    }
+    fprintf(stderr, "flipped %u header, %u index and %u data bytes: %u accepted\n",
+            hdr, idx, data, missed);
+
+    /* the same through a real file and mmap, one byte per region */
+    size_t spots[] = {0, 9, 13, 17, 21, 25, 30, 38, 42, 46, 50, 60, 100,
+                      CACHE_HEADER_SIZE, CACHE_HEADER_SIZE + 9,
+                      CACHE_HEADER_SIZE + 13, CACHE_HEADER_SIZE + 17,
+                      index_end, (index_end + len) / 2, len - 1};
+    for (size_t s = 0; s < sizeof(spots) / sizeof(spots[0]); s++) {
+        img[spots[s]] ^= 0x01;
+        spit(path, img, len);
+        CHECK(cache_open(dir, &params) == NULL,
+              "file with byte %zu flipped is a hit", spots[s]);
+        img[spots[s]] ^= 0x01;
+    }
+
+    /* truncated at every length, and with a byte added */
+    for (size_t n = 0; n < len; n++)
+        if (accepts(img, n, &params)) {
+            CHECK(0, "the image cut to %zu bytes was accepted", n);
+            break;
+        }
+    spit(path, img, len - 1);
+    CHECK(cache_open(dir, &params) == NULL, "a truncated file is a hit");
+    spit(path, img, 0);
+    CHECK(cache_open(dir, &params) == NULL, "an empty file is a hit");
+    uint8_t *longer = malloc(len + 1);
+    memcpy(longer, img, len);
+    longer[len] = 0;
+    CHECK(!accepts(longer, len + 1, &params), "a file with a byte appended was accepted");
+    fix_checksum(longer, len + 1);
+    CHECK(!accepts(longer, len + 1, &params),
+          "an appended byte with a fixed checksum was accepted");
+    free(longer);
+
+    /* A wrong format version, with the checksum made right again. */
+    uint8_t *e = malloc(len);
+    memcpy(e, img, len);
+    put32(e + 8, CACHE_FORMAT_VERSION + 1);
+    fix_checksum(e, len);
+    CHECK(!accepts(e, len, &params), "an unknown format version was accepted");
+    memcpy(e, img, len);
+    put32(e + 8, 1);
+    fix_checksum(e, len);
+    CHECK(!accepts(e, len, &params), "format version 1 was accepted");
+    memcpy(e, img, len);
+    put32(e + 12, CACHE_HEADER_SIZE + 8);
+    fix_checksum(e, len);
+    CHECK(!accepts(e, len, &params), "a header size we do not know was accepted");
+    memcpy(e, img, len);
+    put32(e + 16, (uint32_t)len + 4);
+    fix_checksum(e, len);
+    CHECK(!accepts(e, len, &params), "a file size field that lies was accepted");
+
+    /* A file made for something else is a miss when asked for this. */
+    struct cache_params q;
+    q = params; q.width++;
+    CHECK(!accepts(img, len, &q), "wrong width accepted");
+    q = params; q.height++;
+    CHECK(!accepts(img, len, &q), "wrong height accepted");
+    q = params; q.scale_milli = 2000;
+    CHECK(!accepts(img, len, &q), "wrong scale accepted");
+    q = params; q.layout_version++;
+    CHECK(!accepts(img, len, &q), "wrong layout version accepted");
+    q = params; q.layout_name = "mobintl";
+    CHECK(!accepts(img, len, &q), "wrong layout name accepted");
+    q = params; q.font = "Sans 9";
+    CHECK(!accepts(img, len, &q), "wrong font accepted");
+    q = params; q.depth = 4;
+    CHECK(!accepts(img, len, &q), "wrong depth accepted");
+    q = params; q.env = "pango 1.56.3";
+    CHECK(!accepts(img, len, &q), "another environment accepted");
+    q = params; q.env = "";
+    CHECK(accepts(img, len, &q), "an empty environment is not the same as none");
+
+    /* Hostile index entries under a correct checksum. The first ink entry
+     * is tampered with in turn. */
+    size_t ink = 0;
+    for (size_t i = 0; i < NITEMS; i++) {
+        const uint8_t *en = img + CACHE_HEADER_SIZE + i * CACHE_INDEX_SIZE;
+        if (en[12] || en[13]) {
+            ink = i;
+            break;
+        }
+    }
+    uint8_t *en = e + CACHE_HEADER_SIZE + ink * CACHE_INDEX_SIZE;
+    struct {
+        const char *what;
+        int field; /* byte offset in the entry */
+        uint32_t value;
+        int bytes;
+    } hostile[] = {
+        {"offset at the end of the file", 8, (uint32_t)len, 4},
+        {"offset one word before the end", 8, (uint32_t)len - 4, 4},
+        {"offset beyond the file", 8, (uint32_t)len + 4096, 4},
+        {"offset 0xfffffffc", 8, 0xfffffffcu, 4},
+        {"offset 0xffffffff", 8, 0xffffffffu, 4},
+        {"offset inside the header", 8, 8, 4},
+        {"offset inside the index", 8, CACHE_HEADER_SIZE + 4, 4},
+        {"unaligned offset", 8, (uint32_t)index_end + 2, 4},
+        {"width 0xffff", 12, 0xffff, 2},
+        {"height 0xffff", 14, 0xffff, 2},
+        {"width 4097", 12, 4097, 2},
+        {"height 4097", 14, 4097, 2},
+        {"zero width with data", 12, 0, 2},
+        {"zero height with data", 14, 0, 2},
+    };
+    for (size_t h = 0; h < sizeof(hostile) / sizeof(hostile[0]); h++) {
+        memcpy(e, img, len);
+        if (hostile[h].bytes == 4)
+            put32(en + hostile[h].field, hostile[h].value);
+        else {
+            en[hostile[h].field] = hostile[h].value;
+            en[hostile[h].field + 1] = hostile[h].value >> 8;
+        }
+        fix_checksum(e, len);
+        CHECK(!accepts(e, len, &params), "hostile entry accepted: %s",
+              hostile[h].what);
+    }
+    /* a mask that starts inside the file but ends past it */
+    {
+        memcpy(e, img, len);
+        put32(en + 8, (uint32_t)(len - 8) & ~3u);
+        en[12] = 200; en[13] = 0; en[14] = 200; en[15] = 0;
+        fix_checksum(e, len);
+        CHECK(!accepts(e, len, &params), "a mask running past the end was accepted");
+    }
+    /* a no-ink entry may not carry an offset */
+    for (size_t i = 0; i < NITEMS; i++) {
+        uint8_t *x = e + CACHE_HEADER_SIZE + i * CACHE_INDEX_SIZE;
+        memcpy(e, img, len);
+        if (!x[12] && !x[13]) {
+            put32(x + 8, (uint32_t)index_end);
+            fix_checksum(e, len);
+            CHECK(!accepts(e, len, &params), "an empty mask with an offset was accepted");
+            break;
+        }
+    }
+    /* an index that is not sorted, or has a key twice */
+    memcpy(e, img, len);
+    {
+        uint8_t tmp[CACHE_INDEX_SIZE];
+        uint8_t *a = e + CACHE_HEADER_SIZE, *b = a + CACHE_INDEX_SIZE;
+        memcpy(tmp, a, sizeof(tmp));
+        memcpy(a, b, sizeof(tmp));
+        memcpy(b, tmp, sizeof(tmp));
+        fix_checksum(e, len);
+        CHECK(!accepts(e, len, &params), "an unsorted index was accepted");
+        memcpy(e, img, len);
+        memcpy(b, a, 8);
+        fix_checksum(e, len);
+        CHECK(!accepts(e, len, &params), "a duplicate key was accepted");
+    }
+    /* label counts that do not fit the file */
+    static const uint32_t counts[] = {NITEMS + 1, 0xffffffffu, 0x80000000u,
+                                      0x0aaaaaabu, 0x00ffffffu};
+    for (size_t k = 0; k < sizeof(counts) / sizeof(counts[0]); k++) {
+        memcpy(e, img, len);
+        put32(e + 44, counts[k]);
+        fix_checksum(e, len);
+        CHECK(!accepts(e, len, &params), "label count %u was accepted", counts[k]);
+    }
+    memcpy(e, img, len);
+    put32(e + 44, NITEMS - 1);
+    fix_checksum(e, len);
+    /* one entry fewer leaves its mask behind: harmless, and still safe */
+    (void)accepts(e, len, &params);
+
+    /* Whatever a corrupted header or index says, a file the reader accepts
+     * must be safe to read to the end. Three patterns per byte, checksum
+     * fixed each time; run under the sanitizers this is the memory check. */
+    unsigned accepted = 0, tried = 0;
+    for (size_t i = 0; i < index_end; i++) {
+        static const uint8_t pat[] = {0x01, 0x80, 0xff};
+        for (int k = 0; k < 3; k++) {
+            memcpy(e, img, len);
+            e[i] ^= pat[k];
+            fix_checksum(e, len);
+            tried++;
+            accepted += accepts(e, len, &params);
+        }
+    }
+    fprintf(stderr, "checksum-fixed corruptions: %u tried, %u still valid files\n",
+            tried, accepted);
+    free(e);
+
+    /* no file, a directory in its place, a file that is not ours */
+    unlink(path);
+    CHECK(cache_open(dir, &params) == NULL, "a missing file is a hit");
+    mkdir(path, 0755);
+    CHECK(cache_open(dir, &params) == NULL, "a directory is a hit");
+    rmdir(path);
+    uint8_t junk[4096];
+    for (size_t i = 0; i < sizeof(junk); i++)
+        junk[i] = i * 31;
+    spit(path, junk, sizeof(junk));
+    CHECK(cache_open(dir, &params) == NULL, "junk is a hit");
+    unlink(path);
+    CHECK(cache_open("/nonexistent-dir-for-test", &params) == NULL,
+          "a missing directory is a hit");
+    free(img);
+}
+
+static void
+test_atomic(void)
+{
+    make_items(8, false);
+    char *dir = make_dir("atomic");
+    write_ok(dir, &params);
+    char path[1024];
+    cache_path(path, sizeof(path), dir, &params);
+    size_t before_len;
+    uint8_t *before = slurp(path, &before_len);
+
+    /* A write that dies half way: the file size limit makes write() fail
+     * after a few bytes. The old file must be untouched and no temporary
+     * file may be left. */
+    struct rlimit old, lim;
+    getrlimit(RLIMIT_FSIZE, &old);
+    signal(SIGXFSZ, SIG_IGN);
+    lim = old;
+    lim.rlim_cur = 100;
+    setrlimit(RLIMIT_FSIZE, &lim);
+    make_items(8, true);
+    for (unsigned i = 0; i < nitems; i++)
+        items[i].logical_w += 1; /* other content than before */
+    int r = cache_write(dir, &params, items, nitems, err, sizeof(err));
+    setrlimit(RLIMIT_FSIZE, &old);
+    CHECK(r < 0 && err[0], "a write past the size limit reported success");
+    fprintf(stderr, "injected write failure: %s\n", err);
+    size_t after_len;
+    uint8_t *after = slurp(path, &after_len);
+    CHECK(after && after_len == before_len && !memcmp(before, after, after_len),
+          "a failed write changed the existing file");
+    CHECK(count_files(dir) == 1, "a failed write left %u files in the directory",
+          count_files(dir));
+    free(after);
+
+    /* The rename fails: the target is a directory with something in it. */
+    char *dir2 = make_dir("atomic-dir");
+    char path2[1024], inner[1100];
+    cache_path(path2, sizeof(path2), dir2, &params);
+    mkdir(path2, 0755);
+    snprintf(inner, sizeof(inner), "%s/x", path2);
+    spit(inner, (const uint8_t *)"x", 1);
+    r = cache_write(dir2, &params, items, nitems, err, sizeof(err));
+    CHECK(r < 0, "a rename onto a directory reported success");
+    fprintf(stderr, "injected rename failure: %s\n", err);
+    CHECK(count_files(dir2) == 1, "a failed rename left a temporary file (%u entries)",
+          count_files(dir2));
+    unlink(inner);
+    rmdir(path2);
+
+    /* no directory and none can be made */
+    char file_as_dir[320];
+    snprintf(file_as_dir, sizeof(file_as_dir), "%s/plainfile", root);
+    spit(file_as_dir, (const uint8_t *)"x", 1);
+    char below[400];
+    snprintf(below, sizeof(below), "%s/sub", file_as_dir);
+    r = cache_write(below, &params, items, nitems, err, sizeof(err));
+    CHECK(r < 0 && err[0], "a write below a regular file reported success");
+    fprintf(stderr, "uncreatable directory: %s\n", err);
+
+    /* a missing directory is made */
+    char fresh[400];
+    snprintf(fresh, sizeof(fresh), "%s/fresh", root);
+    write_ok(fresh, &params);
+    struct cache *fc = cache_open(fresh, &params);
+    CHECK(fc != NULL, "the cache in a new directory is a miss");
+    cache_close(fc);
+
+    /* A reader that opens the file again and again while it is replaced
+     * again and again never sees a miss: the name always leads to a
+     * complete file. */
+    int p[2];
+    if (pipe(p) == 0) {
+        pid_t pid = fork();
+        if (pid == 0) {
+            close(p[1]);
+            fcntl(p[0], F_SETFL, O_NONBLOCK);
+            unsigned misses = 0, hits = 0;
+            char c;
+            while (read(p[0], &c, 1) < 0 && errno == EAGAIN) {
+                struct cache *k = cache_open(dir, &params);
+                if (k) {
+                    touch_all(k);
+                    cache_close(k);
+                    hits++;
+                } else {
+                    misses++;
+                }
+            }
+            _exit(misses ? 1 : hits ? 0 : 2);
+        }
+        close(p[0]);
+        for (int i = 0; i < 300; i++) {
+            make_items(8, i & 1);
+            for (unsigned k = 0; k < nitems; k++)
+                items[k].logical_h += i; /* a different file each time */
+            write_ok(dir, &params);
+        }
+        close(p[1]);
+        int status;
+        waitpid(pid, &status, 0);
+        CHECK(WIFEXITED(status) && WEXITSTATUS(status) == 0,
+              "a reader running during 300 rewrites saw a miss (status %d)",
+              WIFEXITED(status) ? WEXITSTATUS(status) : -1);
+        CHECK(count_files(dir) == 1, "rewrites left %u files", count_files(dir));
+    }
+    free(before);
+}
+
+/* The environment (library versions, the font file) is part of the key: a
+ * file made under another one is not found by name, and is refused even when
+ * put where the new key looks, so that a stale mask is never drawn. */
+static void
+test_environment(void)
+{
+    static const char old_env[] =
+        "pango 1.56.3;cairo 1.18.4;font /usr/share/fonts/sans.ttf 757076 1700000000";
+    static const char new_env[] =
+        "pango 1.56.3;cairo 1.18.4;font /usr/share/fonts/sans.ttf 757076 1700000001";
+    struct cache_params a = params, b = params;
+    a.env = old_env;
+    b.env = new_env;
+
+    make_items(8, false);
+    char *dir = make_dir("env");
+    write_ok(dir, &a);
+    char pa[1024], pb[1024], pn[1024];
+    cache_path(pa, sizeof(pa), dir, &a);
+    cache_path(pb, sizeof(pb), dir, &b);
+    cache_path(pn, sizeof(pn), dir, &params);
+    CHECK(strcmp(pa, pb) && strcmp(pa, pn) && strcmp(pb, pn),
+          "the file name does not depend on the environment");
+
+    struct cache *c = cache_open(dir, &a);
+    CHECK(c != NULL, "the file is a miss under the environment it was made for");
+    cache_close(c);
+    c = cache_open(dir, &b);
+    CHECK(c == NULL, "a changed environment found the old file");
+    cache_close(c);
+    c = cache_open(dir, &params);
+    CHECK(c == NULL, "no environment found a file made with one");
+    cache_close(c);
+
+    /* the header refuses it as well, whatever the file is called */
+    size_t len;
+    uint8_t *img = slurp(pa, &len);
+    if (!img) {
+        CHECK(0, "cannot read back the cache");
+        return;
+    }
+    CHECK(accepts(img, len, &a), "the intact image is a miss");
+    CHECK(!accepts(img, len, &b), "a changed environment accepted the old image");
+    spit(pb, img, len);
+    CHECK(cache_open(dir, &b) == NULL,
+          "the old file under the new name was used");
+    free(img);
+
+    /* and a new file for the new environment sits beside the old one */
+    write_ok(dir, &b);
+    CHECK(count_files(dir) == 2, "%u files for two environments", count_files(dir));
+    c = cache_open(dir, &b);
+    CHECK(c != NULL, "the file for the new environment is a miss");
+    cache_close(c);
+}
+
+int
+main(void)
+{
+    const char *tmp = getenv("TMPDIR");
+    snprintf(root, sizeof(root), "%s/wvkbd-cache-test-XXXXXX", tmp ? tmp : "/tmp");
+    if (!mkdtemp(root)) {
+        perror("mkdtemp");
+        return 1;
+    }
+
+    test_round_trip();
+    test_deterministic();
+    test_damage();
+    test_environment();
+    test_atomic();
+
+    for (unsigned i = 0; i < nitems; i++)
+        free((void *)items[i].mask.data);
+    char cmd[300];
+    snprintf(cmd, sizeof(cmd), "rm -rf '%s'", root);
+    if (system(cmd))
+        fprintf(stderr, "could not remove %s\n", root);
+    return failures ? 1 : 0;
+}
diff --git a/tests/test-cachedraw.c b/tests/test-cachedraw.c
new file mode 100644
index 0000000..bbddbd8
--- /dev/null
+++ b/tests/test-cachedraw.c
@@ -0,0 +1,114 @@
+/* Draws every layer, in every shift state and with the popup, from a cache
+ * file made by --prerender, and checks that pango was never asked for a
+ * label. This ties the sizes the cache is made for to the sizes drawing
+ * looks labels up with. */
+#include <cairo.h>
+#include <pango/pangocairo.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "check.h"
+#include "keyboard.h"
+#include "prerender.h"
+#include "text-pango.h"
+#include "text.h"
+
+#define FONT "Sans 8"
+
+static void
+run(const char *dir, double scale, uint32_t w, uint32_t h)
+{
+    char err[512] = "";
+    CHECK(kbd_prerender(dir, FONT, w, h, scale, true, err, sizeof(err)) == 0,
+          "prerender at scale %.2f: %s", scale, err);
+
+    struct text_font *font = text_font_new(FONT);
+    struct clr_scheme schemes[2] = {0};
+    for (int i = 0; i < 2; i++) {
+        schemes[i].bg = (Color){.bgra = {0x30, 0x20, 0x10, 255}};
+        schemes[i].fg = (Color){.bgra = {0x20, 0x90, 0xe0, 255}};
+        schemes[i].high = (Color){.bgra = {0xf0, 0x40, 0x60, 255}};
+        schemes[i].text = (Color){.color = UINT32_MAX};
+        schemes[i].text_press = (Color){.color = UINT32_MAX};
+        schemes[i].rounding = 2;
+        schemes[i].text_font = font;
+    }
+    struct drw ctx = {0};
+    struct drwbuf back = {0}, display = {0}, pback = {0}, pdisplay = {0};
+    struct drwsurf ds = {.ctx = &ctx, .format = DRW_FORMAT_RGB565,
+                         .back_buffer = &back, .display_buffer = &display};
+    struct drwsurf popup = {.ctx = &ctx, .format = DRW_FORMAT_ARGB8888,
+                            .back_buffer = &pback, .display_buffer = &pdisplay};
+    CHECK(drwsurf_resize(&ds, w, h, scale) && drwsurf_resize(&popup, w, h * 2, scale),
+          "buffers");
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_init_layout(&layouts[i], w, h);
+    struct kbd kb = {.surf = &ds, .popup_surf = &popup, .schemes = schemes,
+                     .layout = &layouts[0], .w = w, .h = h, .scale = scale,
+                     .show_highlight = true, .show_popup = true};
+
+    struct text_cache_config cfg = {
+        .dir = dir, .layout_name = kbd_layout_name(),
+        .layout_version = kbd_layout_version(), .width = w, .height = h,
+        .scale = scale, .read = true};
+    text_cache_attach(font, &cfg);
+
+    unsigned before = text_pango_render_count();
+    static const uint8_t states[] = {0, Shift, CapsLock};
+    unsigned drawn = 0;
+    for (int i = 0; i < NumLayouts; i++) {
+        for (unsigned s = 0; s < sizeof(states); s++) {
+            kb.layout = &layouts[i];
+            kb.mods = states[s];
+            kbd_draw_layout(&kb);
+            for (struct key *k = layouts[i].keys; k->type != Last; k++)
+                if (k->type != Pad && k->type != EndRow) {
+                    kbd_draw_key(&kb, k, Press); /* the popup too */
+                    drawn++;
+                }
+        }
+    }
+    CHECK(drawn > 100, "only %u keys drawn", drawn);
+    CHECK(text_pango_render_count() == before,
+          "scale %.2f: %u labels were rendered although the cache had them",
+          scale, text_pango_render_count() - before);
+
+    text_cache_attach(NULL, NULL);
+    drwsurf_drop_buffers(&ds);
+    drwsurf_drop_buffers(&popup);
+    cairo_region_destroy(ds.damage);
+    cairo_region_destroy(ds.backport_damage);
+    cairo_region_destroy(popup.damage);
+    cairo_region_destroy(popup.backport_damage);
+    text_font_free(font);
+}
+
+int
+main(void)
+{
+    int nfam;
+    PangoFontFamily **fam;
+    pango_font_map_list_families(pango_cairo_font_map_get_default(), &fam, &nfam);
+    g_free(fam);
+    if (nfam == 0) {
+        fprintf(stderr, "no fonts installed, skipping\n");
+        return 77;
+    }
+    char root[256];
+    const char *tmp = getenv("TMPDIR");
+    snprintf(root, sizeof(root), "%s/wvkbd-cdraw-XXXXXX", tmp ? tmp : "/tmp");
+    if (!mkdtemp(root)) {
+        perror("mkdtemp");
+        return 1;
+    }
+    run(root, 1.0, 240, kbd_pick_height(false, 240, KBD_PIXEL_HEIGHT, false));
+    /* a fractional scale rounds every edge, so boxes differ from scale 1 */
+    run(root, 1.5, 240, kbd_pick_height(false, 240, KBD_PIXEL_HEIGHT, false));
+    char cmd[300];
+    snprintf(cmd, sizeof(cmd), "rm -rf '%s'", root);
+    if (system(cmd))
+        fprintf(stderr, "could not remove %s\n", root);
+    return failures ? 1 : 0;
+}
diff --git a/tests/test-pangocache.c b/tests/test-pangocache.c
new file mode 100644
index 0000000..533abec
--- /dev/null
+++ b/tests/test-pangocache.c
@@ -0,0 +1,415 @@
+/* The pango backend with the persistent cache: what a first start renders,
+ * what a second start does not, and what happens to a damaged file. */
+#include <dirent.h>
+#ifdef HAVE_FONTCONFIG
+#include <fontconfig/fontconfig.h>
+#endif
+#include <pango/pangocairo.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <utime.h>
+
+#include "cache.h"
+#include "check.h"
+#include "keyboard.h"
+#include "prerender.h"
+#include "text-pango.h"
+#include "text.h"
+
+#define FONT "Sans 8"
+
+static char root[256];
+
+struct label_box {
+    const char *label;
+    int w, h;
+};
+static struct label_box boxes[2000];
+static unsigned nboxes;
+
+/* the distinct (label, box) pairs, which is what ends up in the file */
+static void
+collect(void *data, const char *label, int w, int h)
+{
+    (void)data;
+    for (unsigned i = 0; i < nboxes; i++)
+        if (boxes[i].w == w && boxes[i].h == h && !strcmp(boxes[i].label, label))
+            return;
+    if (nboxes < sizeof(boxes) / sizeof(boxes[0]))
+        boxes[nboxes++] = (struct label_box){label, w, h};
+}
+
+static void
+want_all(void *data, const char *label, int w, int h)
+{
+    (void)data;
+    text_cache_want(label, w, h);
+}
+
+static char *
+make_dir(const char *name)
+{
+    static char path[4][320];
+    static int n;
+    char *p = path[n++ % 4];
+    snprintf(p, 320, "%s/%s", root, name);
+    mkdir(p, 0755);
+    return p;
+}
+
+static uint32_t kw, kh;
+/* what the key of a file made with FONT here contains besides the font name */
+static const char *env;
+
+static struct text_cache_config
+config(const char *dir)
+{
+    return (struct text_cache_config){
+        .dir = dir, .layout_name = kbd_layout_name(),
+        .layout_version = kbd_layout_version(), .width = kw, .height = kh,
+        .scale = 1.0, .read = true};
+}
+
+static struct cache_params
+cparams(void)
+{
+    return (struct cache_params){
+        .layout_name = kbd_layout_name(), .layout_version = kbd_layout_version(),
+        .width = kw, .height = kh, .scale_milli = 1000, .font = FONT,
+        .env = env, .depth = 8};
+}
+
+static void
+start(struct text_font *font, const char *dir)
+{
+    struct text_cache_config cfg = config(dir);
+    text_cache_attach(font, &cfg);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_each_label(&layouts[i], 1.0, 0, want_all, NULL);
+}
+
+static void
+start_env(struct text_font *font, const char *dir, const char *key_env)
+{
+    struct text_cache_config cfg = config(dir);
+    cfg.env = key_env;
+    text_cache_attach(font, &cfg);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_each_label(&layouts[i], 1.0, 0, want_all, NULL);
+}
+
+static void
+run_idle(unsigned *calls, unsigned *worst)
+{
+    *calls = *worst = 0;
+    while (text_cache_pending()) {
+        unsigned before = text_pango_render_count();
+        text_cache_step(2);
+        unsigned d = text_pango_render_count() - before;
+        if (d > *worst)
+            *worst = d;
+        (*calls)++;
+    }
+}
+
+static unsigned
+count_files(const char *dir)
+{
+    unsigned n = 0;
+    DIR *d = opendir(dir);
+    for (struct dirent *e; d && (e = readdir(d));)
+        n += e->d_name[0] != '.' || (e->d_name[1] && strcmp(e->d_name, ".."));
+    if (d)
+        closedir(d);
+    return n;
+}
+
+static void
+draw(struct text_font *f, const char *label, int iw, int ih, uint8_t *mem,
+     int w, int h)
+{
+    memset(mem, 0, (size_t)w * h * 4);
+    struct mask_target t = {.data = mem, .stride = w * 4, .width = w,
+                            .height = h, .format = DRW_FORMAT_XRGB8888,
+                            .clip_x1 = w, .clip_y1 = h};
+    Color white = {.color = UINT32_MAX};
+    text_draw(f, label, &t, 0, 0, iw + 2 * KBD_KEY_BORDER,
+              ih + 2 * KBD_KEY_BORDER, KBD_KEY_BORDER, 1.0, white);
+}
+
+int
+main(void)
+{
+    int nfam;
+    PangoFontFamily **fam;
+    pango_font_map_list_families(pango_cairo_font_map_get_default(), &fam, &nfam);
+    g_free(fam);
+    if (nfam == 0) {
+        fprintf(stderr, "no fonts installed, skipping\n");
+        return 77;
+    }
+    const char *tmp = getenv("TMPDIR");
+    snprintf(root, sizeof(root), "%s/wvkbd-pcache-XXXXXX", tmp ? tmp : "/tmp");
+    if (!mkdtemp(root)) {
+        perror("mkdtemp");
+        return 1;
+    }
+
+    /* the key names the libraries and the font file in use */
+    struct text_font *fenv = text_font_new(FONT);
+    env = text_pango_environment(fenv);
+    CHECK(strstr(env, pango_version_string()), "no pango version in \"%s\"", env);
+    CHECK(strstr(env, cairo_version_string()), "no cairo version in \"%s\"", env);
+#ifdef HAVE_FONTCONFIG
+    char fcv[32];
+    snprintf(fcv, sizeof(fcv), "fontconfig %d", FcGetVersion());
+    CHECK(strstr(env, fcv), "no fontconfig version in \"%s\"", env);
+    const char *file = strstr(env, ";font ");
+    CHECK(file, "the font file is not in \"%s\"", env);
+    if (file) {
+        /* ";font <path> <size> <mtime> #<index>": the path may hold spaces */
+        char path[512];
+        snprintf(path, sizeof(path), "%s", file + 6);
+        char *end = strrchr(path, '#');
+        for (int skip = 0; end && skip < 3; skip++) {
+            *end = 0;
+            end = strrchr(path, ' ');
+        }
+        struct stat fst;
+        CHECK(end, "the font entry is malformed in \"%s\"", env);
+        if (end) {
+            *end = 0;
+            CHECK(stat(path, &fst) == 0, "the font file %s is not there", path);
+            char want[600];
+            snprintf(want, sizeof(want), "%s %lld %lld", path,
+                     (long long)fst.st_size, (long long)fst.st_mtime);
+            CHECK(strstr(env, want), "size and mtime of %s are not in \"%s\"",
+                  path, env);
+        }
+    }
+#else
+    fprintf(stderr, "no fontconfig: the key has library versions only: %s\n", env);
+#endif
+
+    kw = 240;
+    kh = kbd_pick_height(false, kw, KBD_PIXEL_HEIGHT, false);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_init_layout(&layouts[i], kw, kh);
+    for (int i = 0; i < NumLayouts; i++)
+        kbd_each_label(&layouts[i], 1.0, 0, collect, NULL);
+    CHECK(nboxes > 20, "only %u labels in the layouts", nboxes);
+
+    struct cache_params p = cparams();
+    char *dir = make_dir("a");
+    char path[1024];
+    cache_path(path, sizeof(path), dir, &p);
+
+    /* First start: nothing on disk. Drawing renders what it shows; the rest
+     * is rendered in small steps and the file appears once, at the end. */
+    struct text_font *f1 = text_font_new(FONT);
+    start(f1, dir);
+    CHECK(text_cache_pending(), "a first start has nothing to do");
+    unsigned r0 = text_pango_render_count();
+    text_pango_mask(f1, boxes[0].label, 1.0, boxes[0].w, boxes[0].h, NULL, NULL);
+    CHECK(text_pango_render_count() == r0 + 1,
+          "the visible label was not rendered synchronously");
+    CHECK(access(path, F_OK) != 0, "the file exists before the work is done");
+    unsigned calls, worst;
