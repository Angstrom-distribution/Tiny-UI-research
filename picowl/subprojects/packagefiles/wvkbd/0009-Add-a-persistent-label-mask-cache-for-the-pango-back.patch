index 0000000..35ecd43
--- /dev/null
+++ b/tests/check-prerender.sh
@@ -0,0 +1,77 @@
+#!/bin/sh
+# usage: check-prerender.sh BINARY TEXT_BACKEND
+# --prerender must not need a compositor, and its exit status is what a
+# package post-install hook acts on.
+bin=$1
+text=$2
+
+unset WAYLAND_DISPLAY WAYLAND_SOCKET
+export XDG_RUNTIME_DIR=${TMPDIR:-/tmp}
+work=$(mktemp -d "${TMPDIR:-/tmp}/wvkbd-prerender.XXXXXX") || exit 1
+trap 'rm -rf "$work"' EXIT
+
+fail() { echo "FAIL: $*"; exit 1; }
+
+# The options are documented where the user looks first, in both builds.
+help=$("$bin" --help 2>&1)
+for opt in --cache-dir --no-cache --prerender --screen; do
+	echo "$help" | grep -q -- "  $opt" || fail "--help lacks $opt"
+done
+echo "$help" | grep -q '/var/cache/wvkbd-ipaq' || fail "--help does not show the default cache directory"
+
+if [ "$text" != pango ]; then
+	# The bitmap backend has no cache: nothing to do is not a failure, and
+	# nothing is written.
+	"$bin" --prerender --cache-dir "$work/c" --screen 240x320 2>"$work/err"
+	[ $? -eq 0 ] || fail "bitmap --prerender exited non-zero"
+	grep -q 'nothing to do' "$work/err" || fail "no message from bitmap --prerender"
+	[ ! -e "$work/c" ] || fail "bitmap --prerender created the cache directory"
+	exit 0
+fi
+
+count() { ls -A "$1" 2>/dev/null | wc -l | tr -d ' '; }
+
+"$bin" --prerender --cache-dir "$work/c" --screen 240x320 2>"$work/err"
+st=$?
+[ $st -eq 0 ] || { cat "$work/err"; fail "--prerender exited $st"; }
+[ "$(count "$work/c")" = 1 ] || fail "expected one file, found $(count "$work/c")"
+f=$(ls "$work/c")
+case $f in *-240x*.cache) ;; *) fail "unexpected file name $f" ;; esac
+[ -s "$work/c/$f" ] || fail "the cache file is empty"
+cp "$work/c/$f" "$work/first"
+
+# Again: replaces the file with the same bytes, leaves nothing else behind.
+"$bin" --prerender --cache-dir "$work/c" --screen 240x320 2>/dev/null || fail "second --prerender failed"
+cmp -s "$work/first" "$work/c/$f" || fail "a second --prerender gave other bytes"
+[ "$(count "$work/c")" = 1 ] || fail "second --prerender left $(count "$work/c") files"
+
+# Landscape is a file of its own.
+"$bin" --prerender --cache-dir "$work/c" --screen 320x240 2>/dev/null || fail "landscape --prerender failed"
+[ "$(count "$work/c")" = 2 ] || fail "landscape did not add a file"
+
+# The width is the one a start would use: --width only counts when docked,
+# because the compositor sizes a full-width keyboard.
+mkdir "$work/w" || exit 1
+"$bin" --prerender --cache-dir "$work/w" --screen 240x320 --width 200 2>/dev/null || fail "--width --prerender failed"
+[ "$(ls "$work/w")" = "$f" ] || fail "--width without --dock changed the file: $(ls "$work/w") instead of $f"
+"$bin" --prerender --cache-dir "$work/w" --screen 240x320 --dock left --width 200 2>/dev/null || fail "docked --width --prerender failed"
+ls "$work/w" | grep -Eq -- '-200x[0-9]+-' || fail "docked --width 200 did not make a 200 px file: $(ls "$work/w")"
+"$bin" --prerender --cache-dir "$work/w" --screen 240x320 --dock right --ratio 0.5 2>/dev/null || fail "docked --ratio --prerender failed"
+ls "$work/w" | grep -Eq -- '-120x[0-9]+-' || fail "--dock right --ratio 0.5 did not make a 120 px file: $(ls "$work/w")"
+
+# A damaged file is replaced, not trusted.
+printf 'x' | dd of="$work/c/$f" bs=1 seek=300 conv=notrunc 2>/dev/null
+"$bin" --prerender --cache-dir "$work/c" --screen 240x320 2>/dev/null || fail "--prerender over a damaged file failed"
+cmp -s "$work/first" "$work/c/$f" || fail "--prerender did not replace the damaged file"
+
+# Failures are loud and non-zero.
+: >"$work/plain"
+"$bin" --prerender --cache-dir "$work/plain/sub" --screen 240x320 2>"$work/err"
+[ $? -ne 0 ] || fail "--prerender into an impossible directory exited 0"
+grep -q 'prerender failed' "$work/err" || fail "no message when --prerender failed"
+"$bin" --prerender --no-cache --cache-dir "$work/n" 2>"$work/err"
+[ $? -ne 0 ] || fail "--prerender --no-cache exited 0"
+[ ! -e "$work/n" ] || fail "--no-cache created a directory"
+"$bin" --prerender --screen nonsense 2>/dev/null
+[ $? -ne 0 ] || fail "--screen nonsense exited 0"
+exit 0
