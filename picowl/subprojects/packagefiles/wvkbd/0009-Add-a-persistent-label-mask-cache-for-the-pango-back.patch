+++ b/tests/check-cache-tool.sh
@@ -0,0 +1,43 @@
+#!/bin/sh
+# usage: check-cache-tool.sh GENERATOR BINARY
+# The build-time generator must give the same bytes every time, cover the four
+# standard screens, and make the files the keyboard itself looks for.
+gen=$1
+bin=$2
+
+unset WAYLAND_DISPLAY WAYLAND_SOCKET
+work=$(mktemp -d "${TMPDIR:-/tmp}/wvkbd-gen.XXXXXX") || exit 1
+trap 'rm -rf "$work"' EXIT
+fail() { echo "FAIL: $*"; exit 1; }
+
+"$gen" "$work/a" >"$work/a.out" || fail "generator failed"
+"$gen" "$work/b" >"$work/b.out" || fail "second run failed"
+[ "$(ls "$work/a" | wc -l | tr -d ' ')" = 4 ] || fail "expected four files: $(ls "$work/a")"
+[ "$(ls -A "$work/a" | wc -l | tr -d ' ')" = 4 ] || fail "stray files: $(ls -A "$work/a")"
+cmp -s "$work/a.out" "$work/b.out" || fail "the generator output differs"
+for f in $(ls "$work/a"); do
+	cmp -s "$work/a/$f" "$work/b/$f" || fail "$f differs between two runs"
+done
+cat "$work/a.out"
+
+# every standard screen has its file, named the way the keyboard names it
+n=0
+for s in 240x320 320x240 480x640 640x480; do
+	"$bin" --prerender --cache-dir "$work/k" --screen $s 2>/dev/null || fail "--prerender $s failed"
+done
+for f in $(ls "$work/k"); do
+	[ -f "$work/a/$f" ] || fail "the keyboard's $f is not among the generated files"
+	cmp -s "$work/a/$f" "$work/k/$f" || fail "$f from the generator differs from --prerender"
+	n=$((n + 1))
+done
+[ $n = 4 ] || fail "the keyboard wrote $n files"
+
+for f in $(ls "$work/a"); do
+	size=$(wc -c <"$work/a/$f" | tr -d ' ')
+	echo "size $f: $size bytes"
+done
+f=$(ls "$work/a" | grep -- '-240x')
+size=$(wc -c <"$work/a/$f" | tr -d ' ')
+echo "size report: the 240 px wide portrait cache is $size bytes"
+[ "$size" -lt 262144 ] || fail "the 240 px cache is $size bytes"
+exit 0
