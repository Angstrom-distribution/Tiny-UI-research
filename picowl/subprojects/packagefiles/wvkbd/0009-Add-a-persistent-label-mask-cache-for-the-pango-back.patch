new file mode 100644
index 0000000..5759f71
--- /dev/null
+++ b/tools/gen-cache.c
@@ -0,0 +1,46 @@
+/* Writes the label cache files for the standard screens into a directory, so
+ * that an image can ship them and the keyboard never runs pango on the
+ * device. Built with the native toolchain, see the cache_tool option. */
+#include <stdio.h>
+#include <stdlib.h>
+
+#include "keyboard.h"
+#include "prerender.h"
+
+#include "config.h"
+
+int
+main(int argc, char **argv)
+{
+    if (argc < 2 || argc > 3) {
+        fprintf(stderr, "usage: %s DIR [FONT]\n", argv[0]);
+        return 2;
+    }
+    /* Whatever the binary would run with, unless it is started with --fn. A
+     * cache made for another font is simply never found. */
+    const char *font = argc == 3 ? argv[2] : schemes[0].font;
+    /* config.h defines these for main.c; this program has no use for them */
+    (void)layers;
+    (void)landscape_layers;
+
+    static const struct {
+        uint32_t w, h;
+    } screens[] = {{240, 320}, {320, 240}, {480, 640}, {640, 480}};
+
+    for (size_t i = 0; i < sizeof(screens) / sizeof(screens[0]); i++) {
+        uint32_t sw = screens[i].w;
+        bool landscape = sw > screens[i].h;
+        /* the size the keyboard picks on that screen without -H or -L */
+        uint32_t h = kbd_pick_height(
+            landscape, sw,
+            landscape ? KBD_PIXEL_LANDSCAPE_HEIGHT : KBD_PIXEL_HEIGHT, false);
+        char err[512];
+        if (kbd_prerender(argv[1], font, sw, h, 1.0, DEFAULT_SHOW_POPUP, err,
+                          sizeof(err)) < 0) {
+            fprintf(stderr, "%s: %ux%u: %s\n", argv[0], sw, screens[i].h, err);
+            return 1;
+        }
+        printf("%ux%u keyboard %ux%u\n", sw, screens[i].h, sw, h);
+    }
+    return 0;
+}
