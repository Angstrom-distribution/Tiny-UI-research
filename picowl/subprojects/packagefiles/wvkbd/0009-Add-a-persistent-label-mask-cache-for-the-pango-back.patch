+    ret = cache_write(cs.dir, &cs.params, items, cs.nwant, err, errlen);
+    if (ret == 0)
+        cs.dirty = false;
+out:
+    free(items);
+    return ret;
+}
+
+bool
+text_cache_step(unsigned budget)
+{
+    if (!cs.on || cs.finished)
+        return false;
+    /* Hits cost next to nothing, so only renders count against the budget,
+     * but a call still ends after a fixed number of lookups. */
+    unsigned lookups = 0, rendered = 0;
+    while (cs.next < cs.nwant && rendered < budget && lookups++ < 64) {
+        const struct want *w = &cs.want[cs.next++];
+        unsigned before = renders;
+        get_entry(cs.font, w->label, cs.scale, w->w, w->h);
+        rendered += renders != before;
+    }
+    if (cs.next < cs.nwant)
+        return true;
+
+    cs.finished = true;
+    char err[256];
+    /* nothing wanted means the buffers for this geometry were not made, and a
+     * file with no labels would then pass for a complete one */
+    if (cs.dirty && cs.nwant && cache_write_wanted(err, sizeof(err)) < 0)
+        fprintf(stderr, "wvkbd: label cache not written: %s\n", err);
+    return false;
+}
+
+bool
+text_cache_pending(void)
+{
+    return cs.on && !cs.finished;
+}
+
+int
+text_cache_flush(char *err, size_t errlen)
+{
+    if (!cs.on) {
+        snprintf(err, errlen, "no cache directory");
+        return -1;
+    }
+    for (; cs.next < cs.nwant; cs.next++) {
+        const struct want *w = &cs.want[cs.next];
+        get_entry(cs.font, w->label, cs.scale, w->w, w->h);
+    }
+    cs.finished = true;
+    return cache_write_wanted(err, errlen);
+}
+
