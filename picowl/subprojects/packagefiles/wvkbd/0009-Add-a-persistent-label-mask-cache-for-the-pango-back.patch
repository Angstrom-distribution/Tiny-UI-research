diff --git a/label.c b/label.c
new file mode 100644
index 0000000..be67439
--- /dev/null
+++ b/label.c
@@ -0,0 +1,36 @@
+/* What decides where a label goes and whether the text backend draws it, kept
+ * apart from drw.c because the build-time cache tool needs it without
+ * Wayland. */
+#include <math.h>
+#include <string.h>
+
+#include "drw.h"
+
+enum icon
+drw_icon_for_label(const char *label)
+{
+    if (!strcmp(label, "\u21e7")) return ICON_SHIFT;
+    if (!strcmp(label, "\u21eb")) return ICON_CAPS;
+    if (!strcmp(label, "\u232b")) return ICON_BACKSPACE;
+    if (!strcmp(label, "\u21b5")) return ICON_ENTER;
+    return ICON_NONE;
+}
+
+bool
+drw_label_is_icon(const char *label)
+{
+    return drw_icon_for_label(label) != ICON_NONE;
+}
+
+struct drw_label_box
+drw_label_box(double scale, uint32_t x, uint32_t y, uint32_t w, uint32_t h,
+              uint32_t b)
+{
+    struct drw_label_box box;
+    box.x = lround(x * scale);
+    box.y = lround(y * scale);
+    box.w = lround((x + w) * scale) - box.x;
+    box.h = lround((y + h) * scale) - box.y;
+    box.border = lround(b * scale);
+    return box;
+}
