@@ -0,0 +1,62 @@
+#ifndef config_h_INCLUDED
+#define config_h_INCLUDED
+
+/* Only the pango text backend reads the font. The bitmap backend picks 6x13
+ * or 10x20 from the key height, which is 6x13 on a 240 px wide screen. */
+#define DEFAULT_FONT "Sans 8"
+#define DEFAULT_ROUNDING 2
+/* The popup is a second surface with two more buffers (384 kB at 240x100),
+ * too much for 64 MiB. While it is off none of them is made. */
+#define DEFAULT_SHOW_POPUP false
+/* An exclusive zone resizes the focused app on every show and hide, which is
+ * slow over the MediaQ bus. The keyboard overlaps the app instead. */
+#define DEFAULT_EXCLUSIVE false
+/* SHIFT_SPACE_IS_TAB stays undefined: Shift is sticky and the function row has
+ * a Tab key, so Shift+Space would only turn a capital letter followed by a
+ * space into a Tab. */
+static const int transparency = 255;
+
+struct clr_scheme schemes[] = {
+{
+  /* colors */
+  .bg = {.bgra = {15, 15, 15, transparency}},
+  .fg = {.bgra = {45, 45, 45, transparency}},
+  .high = {.bgra = {100, 100, 100, transparency}},
+  .swipe = {.bgra = {100, 255, 100, 64}},
+  .text = {.color = UINT32_MAX},
+  .text_press = {.color = UINT32_MAX},
+  .text_swipe = {.color = UINT32_MAX},
+  .font = DEFAULT_FONT,
+  .rounding = DEFAULT_ROUNDING,
+},
+{
+  /* function keys, darker so the letters stand out */
+  .bg = {.bgra = {15, 15, 15, transparency}},
+  .fg = {.bgra = {32, 32, 32, transparency}},
+  .high = {.bgra = {100, 100, 100, transparency}},
+  .swipe = {.bgra = {100, 255, 100, 64}},
+  .text_press = {.color = UINT32_MAX},
+  .text_swipe = {.color = UINT32_MAX},
+  .text = {.color = UINT32_MAX},
+  .font = DEFAULT_FONT,
+  .rounding = DEFAULT_ROUNDING,
+}
+};
+
+/* The ordered list of layers that NextLayer cycles through. The layouts are
+ * relative to the width, so portrait and landscape share them. */
+static enum layout_id layers[] = {
+  Full, // First layout is the default layout on startup
+  Symbols,
+  Accent,
+  NumLayouts // signals the last item, may not be omitted
+};
+
+static enum layout_id landscape_layers[] = {
+  Full,
+  Symbols,
+  Accent,
+  NumLayouts
+};
+
+#endif // config_h_INCLUDED
