diff --git a/tests/check-exclusive.sh b/tests/check-exclusive.sh
new file mode 100755
index 0000000..0b1b963
--- /dev/null
+++ b/tests/check-exclusive.sh
@@ -0,0 +1,38 @@
+#!/bin/sh
+# usage: check-exclusive.sh BINARY CONFIG_HEADER
+# Same idea as check-popup.sh: -D reports the resolved setting before the
+# binary connects to Wayland. A config header without DEFAULT_EXCLUSIVE keeps
+# upstream's behaviour, an exclusive zone.
+bin=$1
+cfg=$2
+want=$(sed -n 's/^#define DEFAULT_EXCLUSIVE \(true\|false\)$/\1/p' "$cfg")
+case $want in
+true | "") want=on ;;
+false) want=off ;;
+esac
+
+unset WAYLAND_DISPLAY WAYLAND_SOCKET
+export XDG_RUNTIME_DIR=${TMPDIR:-/tmp}
+
+state() {
+	"$bin" -D "$@" 2>&1 | sed -n 's/^wvkbd: exclusive zone //p'
+}
+expect() {
+	exp=$1; shift
+	got=$(state "$@")
+	[ "$got" = "$exp" ] || { echo "args '$*': got '$got', want '$exp'"; exit 1; }
+}
+
+expect "$want"
+expect on --exclusive
+expect off --non-exclusive
+expect on --non-exclusive --exclusive
+expect off --exclusive --non-exclusive
+# the geometry options do not change it
+expect "$want" --dock left --ratio 0.5 --width 200 --corner-radius 4
+
+help=$("$bin" --help 2>&1)
+echo "$help" | grep -q -- '--exclusive ' || { echo "--help lacks --exclusive"; exit 1; }
+if [ "$want" = on ]; then mark=--exclusive; else mark=--non-exclusive; fi
+echo "$help" | grep -- "  $mark " | grep -q '(default)' ||
+	{ echo "--help does not mark $mark as default"; exit 1; }
