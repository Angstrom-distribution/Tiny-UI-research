diff --git a/layout.ipaq.h b/layout.ipaq.h
new file mode 100644
index 0000000..7703de2
--- /dev/null
+++ b/layout.ipaq.h
@@ -0,0 +1,194 @@
+/* constants */
+/* Default heights, used when -H and -L are not given. Five rows (a function
+ * row and four of keys) divide them without a remainder, so no strip is left
+ * unused below the last row: 20, 16, 32 and 26 px keys. The size class comes
+ * from the screen width because a layout cannot know the panel otherwise:
+ * 240 portrait and 320 landscape are QVGA, 480 and 640 are VGA. */
+static inline uint32_t
+ipaq_default_height(uint32_t screen_w, bool landscape)
+{
+	if (screen_w >= 400)
+		return landscape ? 130 : 160;
+	return landscape ? 80 : 100;
+}
+#define KBD_DEFAULT_HEIGHT ipaq_default_height
+
+/* what -H and -L fall back to where KBD_DEFAULT_HEIGHT is not consulted */
+#define KBD_PIXEL_HEIGHT 100
+#define KBD_PIXEL_LANDSCAPE_HEIGHT 80
+
+/* spacing around each key; 2 px would leave a 16 px tall face on a 20 px key */
+#define KBD_KEY_BORDER 1
+
+/* layout declarations */
+/* kbd_init_layers() and kbd_get_layer_index() only look at the first
+ * NumLayouts - 1 entries, so the last layout must be one nobody needs to name.
+ * Index is that: keyboard.c jumps to it after a Compose key and Space, and this
+ * layout has no Compose key, so it exists to give the name a meaning. */
+enum layout_id {
+	Full = 0,
+	Symbols,
+	Accent,
+	Index,
+	NumLayouts,
+};
+
+static struct key keys_full[], keys_symbols[], keys_accent[], keys_index[];
+
+static struct layout layouts[NumLayouts] = {
+  [Full] = {keys_full, "latin", "full", true},
+  [Symbols] = {keys_symbols, "latin", "symbols", false},
+  [Accent] = {keys_accent, "latin", "accent", false},
+  [Index] = {keys_index, "latin", "index", false},
+};
+
+/* Every row adds up to 10 widths, so a key is 24 px on a 240 px screen. */
+#define KEY(l, s, c) {l, s, 1.0, Code, c}
+#define FN(l, c) {l, l, 1.0, Code, c, .scheme = 1}
+#define COPY(l, s, cp, scp) {l, s, 1.0, Copy, cp, 0, scp}
+#define ENDROW {"", "", 0.0, EndRow}
+
+/* The same on every layer, so the arrows and modifiers do not move. Caps is
+ * wider because it is the one a thumb has to find without looking. */
+#define FUNCTION_ROW \
+  FN("Esc", KEY_ESC), \
+  FN("Tab", KEY_TAB), \
+  {"Ctl", "Ctl", 1.0, Mod, Ctrl, .scheme = 1}, \
+  {"Alt", "Alt", 1.0, Mod, Alt, .scheme = 1}, \
+  FN("←", KEY_LEFT), \
+  FN("↓", KEY_DOWN), \
+  FN("↑", KEY_UP), \
+  FN("→", KEY_RIGHT), \
+  {"Cap", "Cap", 2.0, Mod, CapsLock, .scheme = 1}, \
+  ENDROW
+
+#define BACKSPACE {"⌫", "⌫", 1.0, Code, KEY_BACKSPACE, .scheme = 1}
+#define SHIFT {"⇧", "⇫", 1.5, Mod, Shift, .scheme = 1}
+#define ENTER {"↵", "↵", 1.5, Code, KEY_ENTER, .scheme = 1}
+
+/* The comma sends the key of ! when shifted (the latin keymap has the
+ * apostrophe there), and the full stop gives ? by itself, so the letter layer
+ * reaches the punctuation that sentences need. */
+#define BOTTOM_ROW(first, last) \
+  first, \
+  {",", "!", 1.0, Code, KEY_COMMA, .shift_code = KEY_1}, \
+  KEY("'", "\"", KEY_APOSTROPHE), \
+  {"", "", 4.0, Code, KEY_SPACE}, \
+  KEY(".", "?", KEY_DOT), \
+  last, \
+  {"", "", 0.0, Last}
+
+#define TO_SYMBOLS {"123", "123", 1.5, Layout, 0, &layouts[Symbols], .scheme = 1}
+#define TO_ACCENT {"äé", "äé", 1.5, Layout, 0, &layouts[Accent], .scheme = 1}
+#define TO_LETTERS {"Abc", "Abc", 1.5, BackLayer, .scheme = 1}
+
+static struct key keys_full[] = {
+  FUNCTION_ROW,
+
+  KEY("q", "Q", KEY_Q), KEY("w", "W", KEY_W), KEY("e", "E", KEY_E),
+  KEY("r", "R", KEY_R), KEY("t", "T", KEY_T), KEY("y", "Y", KEY_Y),
+  KEY("u", "U", KEY_U), KEY("i", "I", KEY_I), KEY("o", "O", KEY_O),
+  KEY("p", "P", KEY_P),
+  ENDROW,
+
+  KEY("a", "A", KEY_A), KEY("s", "S", KEY_S), KEY("d", "D", KEY_D),
+  KEY("f", "F", KEY_F), KEY("g", "G", KEY_G), KEY("h", "H", KEY_H),
+  KEY("j", "J", KEY_J), KEY("k", "K", KEY_K), KEY("l", "L", KEY_L),
+  BACKSPACE,
+  ENDROW,
+
+  SHIFT,
+  KEY("z", "Z", KEY_Z), KEY("x", "X", KEY_X), KEY("c", "C", KEY_C),
+  KEY("v", "V", KEY_V), KEY("b", "B", KEY_B), KEY("n", "N", KEY_N),
+  KEY("m", "M", KEY_M),
+  ENTER,
+  ENDROW,
+
+  BOTTOM_ROW(TO_SYMBOLS, TO_ACCENT),
+};
+
+/* Digits and, shifted, the symbols above them on a US keyboard. */
+static struct key keys_symbols[] = {
+  FUNCTION_ROW,
+
+  KEY("1", "!", KEY_1), KEY("2", "@", KEY_2), KEY("3", "#", KEY_3),
+  KEY("4", "$", KEY_4), KEY("5", "%", KEY_5), KEY("6", "^", KEY_6),
+  KEY("7", "&", KEY_7), KEY("8", "*", KEY_8), KEY("9", "(", KEY_9),
+  KEY("0", ")", KEY_0),
+  ENDROW,
+
+  KEY("-", "_", KEY_MINUS), KEY("=", "+", KEY_EQUAL),
+  KEY("[", "{", KEY_LEFTBRACE), KEY("]", "}", KEY_RIGHTBRACE),
+  KEY("\\", "|", KEY_BACKSLASH), KEY(";", ":", KEY_SEMICOLON),
+  /* shifted, the slash key of the latin keymap gives >, the full stop ? */
+  {"/", "?", 1.0, Code, KEY_SLASH, .shift_code = KEY_DOT},
+  KEY("`", "~", KEY_GRAVE),
+  FN("Del", KEY_DELETE),
+  BACKSPACE,
+  ENDROW,
+
+  SHIFT,
+  /* KEY_102ND is the key of < and > in the latin keymap */
+  KEY("<", ">", KEY_102ND),
+  /* Copy keys: the AltGr level of minus and equal has no Shift level, so
+   * with Shift held a Code key would type nothing */
+  COPY("€", "€", 0x20AC, 0x20AC), COPY("£", "£", 0x00A3, 0x00A3),
+  COPY("§", "§", 0x00A7, 0x00A7), COPY("°", "°", 0x00B0, 0x00B0),
+  COPY("¿", "¿", 0x00BF, 0x00BF), COPY("¡", "¡", 0x00A1, 0x00A1),
+  ENTER,
+  ENDROW,
+
+  BOTTOM_ROW(TO_LETTERS, TO_ACCENT),
+};
+
+/* The accented letters of Dutch, German and French, as Copy keys because the
+ * latin keymap has no keys for them. ß has no capital in the Latin-1 block,
+ * so it stays the same when shifted. */
+static struct key keys_accent[] = {
+  FUNCTION_ROW,
+
+  COPY("à", "À", 0x00E0, 0x00C0), COPY("â", "Â", 0x00E2, 0x00C2),
+  COPY("ç", "Ç", 0x00E7, 0x00C7), COPY("é", "É", 0x00E9, 0x00C9),
+  COPY("è", "È", 0x00E8, 0x00C8), COPY("ê", "Ê", 0x00EA, 0x00CA),
+  COPY("ë", "Ë", 0x00EB, 0x00CB), COPY("î", "Î", 0x00EE, 0x00CE),
