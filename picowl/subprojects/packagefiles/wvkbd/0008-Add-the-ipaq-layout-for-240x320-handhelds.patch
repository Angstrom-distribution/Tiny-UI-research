diff --git a/tests/test-ipaq.c b/tests/test-ipaq.c
new file mode 100644
index 0000000..6ea1302
--- /dev/null
+++ b/tests/test-ipaq.c
@@ -0,0 +1,428 @@
+/* Checks the ipaq layout without a compositor: its geometry at the supported
+ * screen widths, that the built-in fonts can draw every label, and that every
+ * key produces what its label says through the latin keymap.
+ *
+ * The test is built with LAYOUT and KEYMAP set to the ipaq files whatever
+ * layout the binary is built for, so every build runs it.
+ *
+ * usage: test-ipaq geometry|height|glyphs|keysyms */
+#include <linux/input-event-codes.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <xkbcommon/xkbcommon.h>
+
+#include "check.h"
+#include "keyboard.h"
+#include "text-bitmap.h"
+
+#ifndef KBD_DEFAULT_HEIGHT
+#error "the ipaq layout must define KBD_DEFAULT_HEIGHT"
+#endif
+#include KEYMAP
+
+#define ROWS 5
+/* Index is a one-row picker that only a Compose key can reach and this layout
+ * has none; the layers a user sees are the ones before it. */
+#define LAYERS Index
+
+static bool
+is_key(const struct key *k)
+{
+    return k->type != Pad && k->type != EndRow && k->type != Last;
+}
+
+/* Rows have at most 16 keys; one more than any layer has. */
+#define MAXKEYS 64
+
+static void
+check_layout(uint32_t w, uint32_t h, const char *what, bool exact_height)
+{
+    for (int li = 0; li < LAYERS; li++) {
+        struct layout *l = &layouts[li];
+        kbd_init_layout(l, w, h);
+
+        CHECK(kbd_get_rows(l) == ROWS, "%s %s: %d rows, want %d", what,
+              l->name, kbd_get_rows(l), ROWS);
+        CHECK(l->keyheight == h / ROWS, "%s %s: key height %u, want %u", what,
+              l->name, l->keyheight, h / ROWS);
+        CHECK(l->keyheight * ROWS <= h, "%s %s: rows are taller than %u", what,
+              l->name, h);
+        if (exact_height)
+            CHECK(l->keyheight * ROWS == h,
+                  "%s %s: rows add up to %u, not the height %u", what,
+                  l->name, l->keyheight * ROWS, h);
+
+        struct key *keys[MAXKEYS];
+        int n = 0;
+        double units[ROWS] = {0};
+        uint32_t pixels[ROWS] = {0};
+        int row = 0;
+        for (struct key *k = l->keys; k->type != Last; k++) {
+            if (k->type == EndRow) {
+                row++;
+                continue;
+            }
+            if (!is_key(k))
+                continue;
+            CHECK(row < ROWS && n < MAXKEYS, "%s %s: too many rows or keys",
+                  what, l->name);
+            if (row >= ROWS || n >= MAXKEYS)
+                return;
+            keys[n++] = k;
+            units[row] += k->width;
+            pixels[row] += k->w;
+            CHECK(k->x + k->w <= w && k->y + k->h <= l->keyheight * ROWS,
+                  "%s %s: key '%s' at %u,%u %ux%u leaves the %ux%u surface",
+                  what, l->name, k->label, k->x, k->y, k->w, k->h, w, h);
+            CHECK(k->y == (uint32_t)row * l->keyheight && k->h == l->keyheight,
+                  "%s %s: key '%s' is not on row %d", what, l->name, k->label,
+                  row);
+        }
+        for (int r = 0; r < ROWS; r++) {
+            CHECK(units[r] == 10.0, "%s %s: row %d is %.1f key widths wide",
+                  what, l->name, r, units[r]);
+            /* a gap at the end of a row would be dead surface */
+            CHECK(pixels[r] == w, "%s %s: row %d covers %u of %u px", what,
+                  l->name, r, pixels[r], w);
+        }
+        for (int a = 0; a < n; a++)
+            for (int b = a + 1; b < n; b++) {
+                struct key *p = keys[a], *q = keys[b];
+                bool apart = p->x + p->w <= q->x || q->x + q->w <= p->x ||
+                             p->y + p->h <= q->y || q->y + q->h <= p->y;
+                CHECK(apart, "%s %s: keys '%s' and '%s' overlap", what,
+                      l->name, p->label, q->label);
+            }
+    }
+}
+
+static void
+test_geometry(void)
+{
+    static const uint32_t widths[] = {240, 320, 480, 640};
+    char what[64];
+
+    for (int i = 0; i < 4; i++)
+        for (int land = 0; land < 2; land++) {
+            uint32_t h = kbd_pick_height(land, widths[i], 1, false);
+            snprintf(what, sizeof what, "%ux%u %s", widths[i], h,
+                     land ? "landscape" : "portrait");
+            check_layout(widths[i], h, what, true);
+        }
+
+    /* the four real screens and the sizes the design asks for */
+    static const struct { uint32_t w, h; bool land; } screens[] = {
+        {240, 100, false}, {320, 80, true}, {480, 160, false}, {640, 130, true},
+    };
+    for (int i = 0; i < 4; i++) {
+        uint32_t w = screens[i].w, h = screens[i].h;
+        CHECK(kbd_pick_height(screens[i].land, w, 1, false) == h,
+              "%u px wide: height %u, want %u", w,
+              kbd_pick_height(screens[i].land, w, 1, false), h);
+        for (int li = 0; li < LAYERS; li++) {
+            struct layout *l = &layouts[li];
+            kbd_init_layout(l, w, h);
+            uint32_t minw = ~0u, minh = ~0u;
+            for (struct key *k = l->keys; k->type != Last; k++) {
+                if (!is_key(k))
+                    continue;
+                if (k->w < minw) minw = k->w;
+                if (k->h < minh) minh = k->h;
+                if (k->width == 1.0)
+                    CHECK(k->w == w / 10, "%u wide: key '%s' is %u px wide",
+                          w, k->label, k->w);
+            }
+            printf("%ux%u %-7s: keys at least %ux%u px, %d rows of %u px\n", w,
+                   h, l->name, minw, minh, kbd_get_rows(l), l->keyheight);
+            if (w == 240) {
+                CHECK(minw >= 20 && minh >= 18,
+                      "240x320 %s: smallest key is %ux%u, want 20x18", l->name,
+                      minw, minh);
+            }
+        }
+    }
+
+    /* --dock, --ratio and --width give the keyboard another width, over which
+     * the rows are spread again: 0.68 and 0.5 and 0.3 of 240, a custom 200 and
+     * 0.68 of 480 */
+    static const uint32_t docked[] = {163, 120, 72, 200, 326};
+    for (int i = 0; i < 5; i++) {
+        snprintf(what, sizeof what, "docked %u px", docked[i]);
+        check_layout(docked[i], docked[i] < 250 ? 100 : 160, what, true);
+    }
+}
+
+static void
+test_height(void)
+{
+    CHECK(kbd_pick_height(false, 240, 7, false) == 100, "240 portrait");
+    CHECK(kbd_pick_height(true, 320, 7, false) == 80, "320 landscape");
+    CHECK(kbd_pick_height(false, 480, 7, false) == 160, "480 portrait");
+    CHECK(kbd_pick_height(true, 640, 7, false) == 130, "640 landscape");
+    CHECK(kbd_pick_height(false, 399, 7, false) == 100, "399 is still QVGA");
+    CHECK(kbd_pick_height(false, 400, 7, false) == 160, "400 is VGA");
+    /* -H and -L win over the layout's choice, in either orientation */
+    CHECK(kbd_pick_height(false, 240, 123, true) == 123, "forced portrait");
+    CHECK(kbd_pick_height(true, 640, 77, true) == 77, "forced landscape");
+}
+
+/* A glyph that no font has is drawn as a box and logged; the check is that
+ * nothing was logged while looking up every label. */
+static void
+test_glyphs(void)
+{
+    static const struct { uint32_t w, h; } screens[] = {
+        {240, 100}, {320, 80}, {480, 160}, {640, 130},
+    };
+    char icons[16][8];
+    int nicons = 0;
+
+    CHECK(nbmfonts == 2, "expected two built-in fonts");
+    for (int li = 0; li < NumLayouts; li++) {
+        struct layout *l = &layouts[li];
+        for (struct key *k = l->keys; k->type != Last; k++) {
+            if (!is_key(k))
+                continue;
+            const char *labels[2] = {k->label, k->shift_label};
+            for (int s = 0; s < 2; s++) {
+                const char *label = labels[s];
+                if (!label || !*label)
+                    continue;
+                if (drw_label_is_icon(label)) {
+                    bool seen = false;
+                    for (int i = 0; i < nicons; i++)
+                        seen |= !strcmp(icons[i], label);
+                    if (!seen && nicons < 16)
+                        snprintf(icons[nicons++], 8, "%s", label);
+                    continue;
+                }
+                for (unsigned f = 0; f < nbmfonts; f++) {
+                    unsigned before = bm_missing_logged();
+                    for (const char *p = label; *p;) {
+                        struct label_mask m;
+                        int adv;
+                        bm_glyph_mask(bmfonts[f], bm_utf8_next(&p), &m, &adv);
+                    }
+                    CHECK(bm_missing_logged() == before,
+                          "%s: label '%s' has a glyph missing from the %s "
+                          "font", l->name, label, bmfonts[f]->name);
+                }
+            }
+        }
+    }
+    printf("drawn as icons instead of glyphs:");
+    for (int i = 0; i < nicons; i++)
+        printf(" %s", icons[i]);
+    printf("\n");
+
+    /* the font picked for a key must hold the label inside the key face */
+    for (int i = 0; i < 4; i++)
+        for (int li = 0; li < LAYERS; li++) {
+            struct layout *l = &layouts[li];
+            kbd_init_layout(l, screens[i].w, screens[i].h);
+            const struct bmfont *seen = NULL;
+            for (struct key *k = l->keys; k->type != Last; k++) {
+                if (!is_key(k))
+                    continue;
+                const char *labels[2] = {k->label, k->shift_label};
+                for (int s = 0; s < 2; s++) {
+                    if (!labels[s][0] || drw_label_is_icon(labels[s]))
+                        continue;
+                    unsigned iw = k->w - 2 * KBD_KEY_BORDER,
+                             ih = k->h - 2 * KBD_KEY_BORDER;
+                    const struct bmfont *f = bm_pick_font(labels[s], iw, ih);
+                    seen = f;
+                    CHECK(bm_label_width(f, labels[s]) <= iw &&
+                              f->cell_h <= ih,
+                          "%ux%u %s: '%s' in %s does not fit %ux%u",
+                          screens[i].w, screens[i].h, l->name, labels[s],
+                          f->name, iw, ih);
+                }
+            }
+            if (li == 0)
+                printf("%ux%u: labels drawn with the %s font\n", screens[i].w,
+                       screens[i].h, seen ? seen->name : "?");
+        }
+}
+
+static struct xkb_keymap *
+load_keymap(struct xkb_context *ctx, uint32_t unichr)
+{
+    size_t size = strlen(keymaps[0]) + 64;
+    char *str = malloc(size);
+    snprintf(str, size, keymaps[0], unichr, unichr);
+    struct xkb_keymap *km =
+        xkb_keymap_new_from_string(ctx, str, XKB_KEYMAP_FORMAT_TEXT_V1, 0);
+    free(str);
+    CHECK(km != NULL, "the latin keymap does not compile");
+    return km;
+}
+
+static xkb_keysym_t
+press(struct xkb_keymap *km, uint32_t code, uint32_t mods)
+{
+    struct xkb_state *st = xkb_state_new(km);
+    xkb_state_update_mask(st, mods, 0, 0, 0, 0, 0);
+    xkb_keysym_t sym = xkb_state_key_get_one_sym(st, code + 8);
+    xkb_state_unref(st);
+    return sym;
+}
+
+static uint32_t
+first_cp(const char *label)
+{
+    const char *p = label;
+    uint32_t cp = bm_utf8_next(&p);
+    return *p ? 0 : cp; /* 0 when the label is more than one code point */
+}
+
+struct named { uint32_t code; xkb_keysym_t sym; };
+static const struct named named_keys[] = {
+    {KEY_ESC, XKB_KEY_Escape}, {KEY_TAB, XKB_KEY_Tab},
+    {KEY_LEFT, XKB_KEY_Left}, {KEY_DOWN, XKB_KEY_Down},
+    {KEY_UP, XKB_KEY_Up}, {KEY_RIGHT, XKB_KEY_Right},
+    {KEY_BACKSPACE, XKB_KEY_BackSpace}, {KEY_ENTER, XKB_KEY_Return},
+    {KEY_SPACE, XKB_KEY_space}, {KEY_DELETE, XKB_KEY_Delete},
+};
+
+static void
+test_keysyms(void)
+{
+    (void)keymap_names; /* only keyboard.c looks keymaps up by name */
+    CHECK(NUMKEYMAPS == 1, "the ipaq keymap carries %d keymaps", NUMKEYMAPS);
+    struct xkb_context *ctx = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    struct xkb_keymap *km = load_keymap(ctx, 0);
+    if (!km)
+        return;
+
+    for (int li = 0; li < NumLayouts; li++) {
+        struct layout *l = &layouts[li];
+        CHECK(!strcmp(l->keymap_name, "latin"), "%s uses keymap %s", l->name,
+              l->keymap_name);
+        for (struct key *k = l->keys; k->type != Last; k++) {
+            if (!is_key(k))
+                continue;
+            for (int shifted = 0; shifted < 2; shifted++) {
+                const char *label = shifted ? k->shift_label : k->label;
+                uint32_t shift = shifted ? Shift : 0;
+                if (k->type == Code) {
+                    uint32_t code = shifted && k->shift_code ? k->shift_code
+                                                              : k->code;
+                    xkb_keysym_t sym = press(km, code, shift | k->code_mod);
+                    const struct named *nm = NULL;
+                    for (unsigned i = 0; i < sizeof named_keys / sizeof *named_keys; i++)
+                        if (named_keys[i].code == k->code)
+                            nm = &named_keys[i];
+                    if (nm) {
+                        /* shift turns Tab into the backtab, nothing else */
+                        xkb_keysym_t want = nm->sym;
+                        if (shifted && k->code == KEY_TAB)
+                            want = XKB_KEY_ISO_Left_Tab;
+                        CHECK(sym == want, "%s: key '%s'%s gives keysym 0x%x, "
+                              "want 0x%x", l->name, k->label,
+                              shifted ? " shifted" : "", sym, want);
+                    } else {
+                        uint32_t want = first_cp(label);
+                        CHECK(want && xkb_keysym_to_utf32(sym) == want,
+                              "%s: key '%s'%s gives U+%04X, want U+%04X",
+                              l->name, k->label, shifted ? " shifted" : "",
+                              xkb_keysym_to_utf32(sym), want);
+                    }
+                } else if (k->type == Copy) {
+                    /* the Copy key uploads a keymap whose COMP key holds the
+                     * code point and presses it */
+                    uint32_t cp = shifted ? k->code_mod : k->code;
+                    CHECK(cp == first_cp(label),
+                          "%s: Copy key '%s' carries U+%04X", l->name, label,
+                          cp);
+                    struct xkb_keymap *ckm = load_keymap(ctx, cp);
+                    if (!ckm)
+                        continue;
+                    xkb_keysym_t sym = press(ckm, KEY_COMPOSE, shift);
+                    CHECK(xkb_keysym_to_utf32(sym) == cp,
+                          "%s: Copy key '%s'%s types U+%04X, want U+%04X",
+                          l->name, k->label, shifted ? " shifted" : "",
+                          xkb_keysym_to_utf32(sym), cp);
+                    xkb_keymap_unref(ckm);
+                }
+            }
+            if (k->type == Mod) {
+                xkb_keysym_t sym = press(km, KEY_A, k->code);
+                if (k->code == Ctrl) {
+                    struct xkb_state *st = xkb_state_new(km);
+                    xkb_state_update_mask(st, Ctrl, 0, 0, 0, 0, 0);
+                    CHECK(xkb_state_mod_name_is_active(st, XKB_MOD_NAME_CTRL,
+                                                       XKB_STATE_MODS_DEPRESSED) > 0,
+                          "Ctrl bit does not activate Control");
+                    xkb_state_unref(st);
+                } else if (k->code == Alt) {
+                    struct xkb_state *st = xkb_state_new(km);
+                    xkb_state_update_mask(st, Alt, 0, 0, 0, 0, 0);
+                    CHECK(xkb_state_mod_name_is_active(st, XKB_MOD_NAME_ALT,
+                                                       XKB_STATE_MODS_DEPRESSED) > 0,
+                          "Alt bit does not activate Mod1");
+                    xkb_state_unref(st);
+                } else if (k->code == Shift || k->code == CapsLock) {
+                    CHECK(sym == XKB_KEY_A, "%s: modifier %u gives 0x%x for a",
+                          l->name, k->code, sym);
+                } else {
+                    CHECK(false, "%s: unexpected modifier %u on '%s'", l->name,
+                          k->code, k->label);
+                }
+            }
+        }
+    }
+
+    /* a few by name, so a mistake in the loop above cannot hide the basics */
+    CHECK(press(km, KEY_Q, 0) == XKB_KEY_q, "q");
+    CHECK(press(km, KEY_Q, Shift) == XKB_KEY_Q, "Q");
+    CHECK(press(km, KEY_DOT, Shift) == XKB_KEY_question, "shift . is ?");
+    CHECK(press(km, KEY_1, Shift) == XKB_KEY_exclam, "shift 1 is !");
+    CHECK(press(km, KEY_102ND, 0) == XKB_KEY_less, "the 102nd key is <");
+    CHECK(press(km, KEY_102ND, Shift) == XKB_KEY_greater, "its shift is >");
+    CHECK(press(km, KEY_C, Ctrl) == XKB_KEY_c, "Ctrl c is c with Control");
+    CHECK(press(km, KEY_A, CapsLock) == XKB_KEY_A, "caps lock a");
+
+    /* every layer can be left and entered again */
+    bool to_symbols = false, to_accent = false, back[NumLayouts] = {false};
+    for (int li = 0; li < NumLayouts; li++)
+        for (struct key *k = layouts[li].keys; k->type != Last; k++) {
+            if (k->type == Layout && k->layout == &layouts[Symbols])
+                to_symbols = true;
+            if (k->type == Layout && k->layout == &layouts[Accent])
+                to_accent = true;
+            if (k->type == BackLayer)
+                back[li] = true;
+        }
+    CHECK(to_symbols && to_accent, "no key switches to a layer");
+    CHECK(back[Symbols] && back[Accent] && !back[Full],
+          "Abc is on the symbol and accent layers only");
+
+    xkb_keymap_unref(km);
+    xkb_context_unref(ctx);
+}
+
+int
+main(int argc, char **argv)
+{
+    if (argc != 2) {
+        fprintf(stderr, "usage: %s geometry|height|glyphs|keysyms\n", argv[0]);
+        return 2;
+    }
+    if (!strcmp(argv[1], "geometry"))
+        test_geometry();
+    else if (!strcmp(argv[1], "height"))
+        test_height();
+    else if (!strcmp(argv[1], "glyphs"))
+        test_glyphs();
+    else if (!strcmp(argv[1], "keysyms"))
+        test_keysyms();
+    else {
+        fprintf(stderr, "unknown test %s\n", argv[1]);
+        return 2;
+    }
+    if (failures)
+        fprintf(stderr, "%d check(s) failed\n", failures);
+    return failures != 0;
+}
