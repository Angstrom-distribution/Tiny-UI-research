option('tests', type: 'boolean', value: true, description: 'Build the unit tests (tests/)')
option('systemd', type: 'feature', value: 'auto', description: 'Install the systemd unit')
option('tools', type: 'boolean', value: true, description: 'Build and install host tools (picowl-cursor-convert)')
option('rss_ceiling_kb', type: 'integer', value: 12288, description: 'VmHWM ceiling (kB) enforced by tests/rss.sh')
